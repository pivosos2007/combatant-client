#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0, rgba16f) writeonly uniform image2D u_Transmittance;
layout(std430, binding = 1) readonly buffer AtmosphereParams {
    vec4 radii;
    vec4 rayleigh;
    vec4 mieScattering;
    vec4 mieExtinction;
    vec4 ozone;
    vec4 ozoneShapeGroundR;
    vec4 groundGB;
    vec4 sunDirection;
    vec4 sunRadiance;
    vec4 moonDirection;
    vec4 moonRadiance;
    vec4 aerial;
} u_Atm;

float distanceToSphere(float r, float mu, float radius) {
    float d = r * r * (mu * mu - 1.0) + radius * radius;
    return d <= 0.0 ? -1.0 : -r * mu + sqrt(d);
}

bool rayHitsGround(float r, float mu) {
    float rg = u_Atm.radii.x;
    float d = r * r * (mu * mu - 1.0) + rg * rg;
    if (d < 0.0) return false;
    return (-r * mu - sqrt(d)) > 0.0;
}

vec3 extinctionAtHeight(float h) {
    float rayleighDensity = exp(-max(h, 0.0) / max(u_Atm.rayleigh.w, 1e-3));
    float mieDensity = exp(-max(h, 0.0) / max(u_Atm.mieScattering.w, 1e-3));
    float ozoneDensity = max(0.0, 1.0 - abs(h - u_Atm.ozone.w) / max(u_Atm.ozoneShapeGroundR.x, 1e-3));
    return u_Atm.rayleigh.rgb * rayleighDensity
         + u_Atm.mieExtinction.rgb * mieDensity
         + u_Atm.ozone.rgb * ozoneDensity;
}

vec3 integrateTransmittance(float r, float mu) {
    if (rayHitsGround(r, mu)) return vec3(0.0);
    float tMax = distanceToSphere(r, mu, u_Atm.radii.y);
    if (tMax <= 0.0) return vec3(1.0);

    const int STEPS = 48;
    float ds = tMax / float(STEPS);
    vec3 opticalDepth = vec3(0.0);
    for (int i = 0; i < STEPS; ++i) {
        float t = (float(i) + 0.5) * ds;
        float sampleR = sqrt(max(r * r + t * t + 2.0 * r * mu * t, 0.0));
        opticalDepth += extinctionAtHeight(sampleR - u_Atm.radii.x) * ds;
    }
    return exp(-opticalDepth);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_Transmittance);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float r = mix(u_Atm.radii.x + 1e-3, u_Atm.radii.y - 1e-3, uv.y);
    float mu = uv.x * 2.0 - 1.0;
    imageStore(u_Transmittance, pixel, vec4(integrateTransmittance(r, mu), 1.0));
}
