layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_SceneColor;
layout(binding = 1) uniform sampler2D u_GbufferGeometry;
layout(binding = 2) uniform sampler2D u_GbufferMaterial;
layout(binding = 3) uniform sampler2D u_ResolvedDepth;
layout(binding = 4) uniform sampler2D u_GbufferDepth;
layout(binding = 5) uniform sampler2D u_DepthPyramid;
layout(binding = 6, rgba16f) writeonly uniform image2D u_ReflectionTrace;
layout(binding = 7, r8) writeonly uniform image2D u_ReflectionConfidence;

layout(std430, binding = 8) readonly buffer ReflectionTraceData {
    mat4 inverseProjection;
    mat4 inverseView;
    mat4 projection;
    // xy: depth -> NDC, zw: NDC -> depth.
    vec4 depthTransform;
    // xy: full-resolution extent, z: camera far, w: trace max-distance scale.
    vec4 traceExtentAndFar;
    // x: max steps, y: minimum step, z: view-depth step scale, w: step growth.
    vec4 traceParams0;
    // x: minimum hit thickness, y: normal bias, z: edge margin, w: Hi-Z mip step scale.
    vec4 traceParams1;
    vec4 resolveParams;
} u_Trace;

#moj_import <combatant:deferred_reflection_trace.glsl>

void storeMiss(ivec2 pixel) {
    imageStore(u_ReflectionTrace, pixel, vec4(0.0));
    imageStore(u_ReflectionConfidence, pixel, vec4(0.0));
}

CombatantReflectionTracePolicy tracePolicy() {
    CombatantReflectionTracePolicy policy;
    policy.inverseProjection = u_Trace.inverseProjection;
    policy.projection = u_Trace.projection;
    policy.depthTransform = u_Trace.depthTransform;
    policy.traceExtentAndFar = u_Trace.traceExtentAndFar;
    policy.traceParams0 = u_Trace.traceParams0;
    policy.traceParams1 = u_Trace.traceParams1;
    return policy;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(u_ReflectionTrace);
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(outputSize);
    float surfaceDepth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    if (!combatantReflectionOwnsGbufferPixel(u_GbufferDepth, uv, surfaceDepth)) {
        storeMiss(pixel);
        return;
    }

    CombatantReflectionTracePolicy policy = tracePolicy();
    vec3 viewPosition = combatantReflectionReconstructView(policy, uv, surfaceDepth);
    vec3 viewNormal = combatantReflectionDecodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    float roughness = clamp(textureLod(u_GbufferMaterial, uv, 0.0).r, 0.0, 1.0);
    vec3 rayDirection = normalize(reflect(normalize(viewPosition), viewNormal));

    CombatantReflectionTraceResult hit = combatantTraceScreenReflection(
            policy, u_ResolvedDepth, u_GbufferDepth, u_DepthPyramid, u_GbufferGeometry,
            viewPosition, viewNormal, rayDirection, roughness);
    if (hit.valid < 0.5) {
        storeMiss(pixel);
        return;
    }

    vec3 reflected = textureLod(u_SceneColor, hit.hitUv, 0.0).rgb;
    imageStore(u_ReflectionTrace, pixel, vec4(reflected, 1.0));
    imageStore(u_ReflectionConfidence, pixel, vec4(hit.confidence, 0.0, 0.0, 0.0));
}
