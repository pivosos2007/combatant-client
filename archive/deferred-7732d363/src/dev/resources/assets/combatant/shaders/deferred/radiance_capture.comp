layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_DirectLighting;
layout(binding = 1) uniform sampler2D u_LocalLighting;
layout(binding = 2) uniform sampler2D u_CompatibilityScene;
layout(binding = 3) uniform sampler2D u_GbufferDepth;
layout(binding = 4) uniform sampler2D u_CurrentDepth;
layout(binding = 5, rgba16f) writeonly uniform image2D u_OpaqueBaseRadiance;
layout(std430, binding = 6) readonly buffer RadianceCaptureData { vec4 flags; } u_Capture;

bool terrainOwnsPixel(vec2 uv) {
    float gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    float currentDepth = textureLod(u_CurrentDepth, uv, 0.0).r;
    if (gbufferDepth <= 0.0 || currentDepth <= 0.0) return false;
    float tolerance = max(1.0e-6, abs(gbufferDepth) * 1.0e-5);
    return abs(gbufferDepth - currentDepth) <= tolerance;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_OpaqueBaseRadiance);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec4 radiance;
    if (terrainOwnsPixel(uv)) {
        radiance = textureLod(u_DirectLighting, uv, 0.0);
        if (u_Capture.flags.x > 0.5) radiance.rgb += textureLod(u_LocalLighting, uv, 0.0).rgb;
    } else {
        radiance = textureLod(u_CompatibilityScene, uv, 0.0);
    }
    imageStore(u_OpaqueBaseRadiance, pixel, radiance);
}
