layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_LightingColor;
layout(binding = 1) uniform sampler2D u_ReflectionColor;
layout(binding = 2) uniform sampler2D u_ReflectionConfidence;
layout(binding = 3) uniform sampler2D u_GbufferSurface;
layout(binding = 4) uniform sampler2D u_GbufferGeometry;
layout(binding = 5) uniform sampler2D u_GbufferMaterial;
layout(binding = 6) uniform sampler2D u_ResolvedDepth;
layout(binding = 7) uniform sampler2D u_GbufferDepth;
layout(binding = 8, rgba16f) writeonly uniform image2D u_SceneRadiance;
layout(binding = 10) uniform sampler2D u_SkySpecular;

layout(std430, binding = 9) readonly buffer ReflectionCompositeData {
    mat4 inverseProjection;
    mat4 inverseView;
    // xy: depth -> NDC, zw: NDC -> depth.
    vec4 depthTransform;
    // x: reflection hierarchy resource valid, y: sky resources physically bound.
    vec4 flags;
} u_Composite;

layout(std430, binding = 11) readonly buffer SkyEnvironmentState {
    // x: semantic validity, y: specular mip count.
    vec4 state0;
    vec4 state1;
} u_Sky;

const float PI = 3.14159265358979323846;

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

vec3 reconstructView(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Composite.depthTransform.x + u_Composite.depthTransform.y;
    vec4 h = u_Composite.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    if (abs(h.w) < 1e-7) return vec3(0.0);
    return h.xyz / h.w;
}

vec2 latLongFromDirection(vec3 d) {
    d = normalize(d);
    float phi = atan(d.z, d.x);
    float theta = acos(clamp(d.y, -1.0, 1.0));
    return vec2(phi / (2.0 * PI) + 0.5, theta / PI);
}

vec3 fresnelSchlickRoughness(float cosTheta, vec3 f0, float roughness) {
    vec3 grazing = max(vec3(1.0 - roughness), f0);
    float factor = pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
    return f0 + (grazing - f0) * factor;
}

bool ownsGbufferPixel(vec2 uv, float currentDepth) {
    float gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    if (gbufferDepth <= 0.0 || currentDepth <= 0.0) return false;
    float tolerance = max(1.0e-6, abs(gbufferDepth) * 1.0e-5);
    return abs(gbufferDepth - currentDepth) <= tolerance;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_SceneRadiance);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec4 base = textureLod(u_LightingColor, uv, 0.0);
    vec4 surface = textureLod(u_GbufferSurface, uv, 0.0);
    float depth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    if (!ownsGbufferPixel(uv, depth)) {
        imageStore(u_SceneRadiance, pixel, base);
        return;
    }

    vec3 position = reconstructView(uv, depth);
    vec3 normal = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    vec3 view = normalize(-position);
    float ndotv = max(dot(normal, view), 0.0);

    vec4 material = textureLod(u_GbufferMaterial, uv, 0.0);
    float roughness = clamp(material.r, 0.0, 1.0);
    float metallic = clamp(material.g, 0.0, 1.0);
    float dielectricF0 = clamp(material.b, 0.0, 1.0);
    vec3 f0 = mix(vec3(dielectricF0), surface.rgb, metallic);
    vec3 fresnel = fresnelSchlickRoughness(ndotv, f0, roughness);

    bool skyValid = u_Composite.flags.y > 0.5 && u_Sky.state0.x > 0.5;
    vec3 fallbackRadiance = vec3(0.0);
    if (skyValid) {
        vec3 reflectedView = normalize(reflect(-view, normal));
        vec3 reflectedWorld = normalize(mat3(u_Composite.inverseView) * reflectedView);
        float mipCount = max(u_Sky.state0.y, 1.0);
        float lod = roughness * max(mipCount - 1.0, 0.0);
        fallbackRadiance = max(textureLod(u_SkySpecular, latLongFromDirection(reflectedWorld), lod).rgb, vec3(0.0));
    }

    vec3 resolvedRadiance = fallbackRadiance;
    if (u_Composite.flags.x > 0.5) {
        vec3 hierarchyRadiance = max(textureLod(u_ReflectionColor, uv, 0.0).rgb, vec3(0.0));
        float confidence = clamp(textureLod(u_ReflectionConfidence, uv, 0.0).r, 0.0, 1.0);
        if (skyValid) {
            resolvedRadiance = mix(fallbackRadiance, hierarchyRadiance, confidence);
        } else {
            // Without a lower hierarchy tier, confidence is selection metadata rather than an
            // energy multiplier. A valid producer owns the radiance it published.
            resolvedRadiance = hierarchyRadiance;
        }
    }

    // Reflection producers choose the source radiance. This boundary applies only the neutral
    // material response; confidence never scales radiometric energy directly.
    vec3 specularIndirect = resolvedRadiance * fresnel;
    imageStore(u_SceneRadiance, pixel, vec4(base.rgb + specularIndirect, base.a));
}
