#version 430 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(binding = 1, rgba16f) writeonly uniform image3D u_SegmentRadiance;
layout(binding = 2, rgba16f) writeonly uniform image3D u_SegmentTransmittance;
layout(binding = 3) uniform sampler2D u_AerialRadiance;
layout(binding = 4) uniform sampler2D u_AerialTransmittance;
layout(binding = 7) uniform sampler2D u_CloudShadowMap;
layout(binding = 11, rgba16f) writeonly uniform image3D u_MediaProperties;
layout(binding = 12) uniform sampler2D u_WaterBoundary;
layout(binding = 16) uniform sampler3D u_CloudOccupancy;

#moj_import <combatant:deferred_froxel_media_data.glsl>


#define COMBATANT_CLOUD_WEATHER_BINDING 5
#define COMBATANT_CLOUD_DOMAIN_BINDING 6
#define COMBATANT_CLOUD_MACRO_WEATHER_BINDING 8
#moj_import <combatant:deferred_cloud_density.glsl>
#moj_import <combatant:deferred_froxel_transport.glsl>
#moj_import <combatant:deferred_cloud_shadow_sampling.glsl>
#define COMBATANT_LOCAL_FOG_VOLUME_BINDING 13
#define COMBATANT_LOCAL_FOG_BIN_COUNT_BINDING 14
#define COMBATANT_LOCAL_FOG_BIN_INDEX_BINDING 15
#moj_import <combatant:deferred_local_fog_volume_contract.glsl>

vec3 worldRay(vec2 uv) {
    float ndcZ = u_Data.policy.y > 0.5 ? 0.5 : 0.0;
    vec4 view = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    vec3 viewDirection = normalize(view.xyz / max(abs(view.w), 1e-7) * sign(view.w));
    return normalize(mat3(u_Data.inverseView) * viewDirection);
}

#moj_import <combatant:deferred_aerial_sampling.glsl>

void cumulativeAtmosphere(vec3 ray, float distanceBlocks, out vec3 radiance, out vec3 transmittance) {
    if (u_Data.policy.z <= 0.5 || distanceBlocks <= 0.0) {
        radiance = vec3(0.0);
        transmittance = vec3(1.0);
        return;
    }
    float distanceKm = distanceBlocks * 0.001;
    radiance = max(combatant_sample_aerial(u_AerialRadiance, ray, distanceKm).rgb, vec3(0.0));
    transmittance = clamp(combatant_sample_aerial(u_AerialTransmittance, ray, distanceKm).rgb, vec3(0.0), vec3(1.0));
}

float mediumWeatherFieldWeight(vec2 localXZ) {
    int width = max(0, int(u_Data.grid.y));
    int depth = max(0, int(u_Data.grid.z));
    if (width <= 0 || depth <= 0 || u_Data.grid.w <= 0.5) return 0.0;

    float spacing = max(u_Data.grid.x, 1.0);
    vec2 maximum = vec2(float(max(width - 1, 0)), float(max(depth - 1, 0))) * spacing;
    vec2 enter = smoothstep(vec2(-spacing), vec2(0.0), localXZ);
    vec2 leave = vec2(1.0) - smoothstep(maximum, maximum + vec2(spacing), localXZ);
    return clamp(enter.x * enter.y * leave.x * leave.y, 0.0, 1.0);
}

vec3 mediumWeatherSignals(vec2 localXZ) {
    vec3 globalSignals = u_Data.mediumWeatherState.w > 0.5
            ? max(u_Data.mediumWeatherState.xyz, vec3(0.0))
            : vec3(0.0);
    WeatherCell localWeather = combatant_cloud_sample_weather(localXZ);
    vec3 localSignals = vec3(
            max(localWeather.climate.x, 0.0),
            max(localWeather.climate.z, 0.0),
            max(localWeather.climate.w, 0.0)
    );
    float localWeight = mediumWeatherFieldWeight(localXZ) * clamp(localWeather.windFront.w, 0.0, 1.0);
    return mix(globalSignals, localSignals, localWeight);
}

float mediumDensity(vec3 localPosition, float distanceBlocks) {
    if (u_Data.mediumDistribution.w <= 0.5 || distanceBlocks > u_Data.mediumLighting.z) return 0.0;

    vec3 weatherSignals = mediumWeatherSignals(localPosition.xz);
    float humidityThreshold = clamp(u_Data.mediumWeather.x, 0.0, 0.9999);
    float humidityDrive = max(weatherSignals.x - humidityThreshold, 0.0)
            / max(1.0 - humidityThreshold, 1e-4);
    float weatherDensity = u_Data.mediumDistribution.z
            + humidityDrive * u_Data.mediumWeather.y
            + weatherSignals.z * u_Data.mediumWeather.z
            + weatherSignals.y * u_Data.mediumWeather.w;

    float heightAboveReference = max(localPosition.y - u_Data.mediumDistribution.x, 0.0);
    float heightScale = exp(-heightAboveReference / max(u_Data.mediumDistribution.y, 1e-3));
    return max(0.0, weatherDensity * heightScale);
}

float luminance(vec3 value) {
    return dot(max(value, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
}

bool cloudOccupancyAt(vec3 localPosition, float footprintBlocks) {
    if (u_Data.cloudOccupancyPolicy.y <= 0.5) return true;

    float spanXZ = max(u_Data.cloudOccupancyPolicy.x, 1.0);
    float spanY = max(u_Data.cloudOccupancyDomain.w - u_Data.cloudOccupancyDomain.z, 1.0);
    vec3 origin = vec3(
            u_Data.cloudOccupancyDomain.x,
            u_Data.cloudOccupancyDomain.z,
            u_Data.cloudOccupancyDomain.y);
    vec3 extent = vec3(spanXZ, spanY, spanXZ);
    vec3 uvw = (localPosition - origin) / extent;
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThanEqual(uvw, vec3(1.0)))) return true;

    int levels = max(textureQueryLevels(u_CloudOccupancy), 1);
    ivec3 baseSize = max(textureSize(u_CloudOccupancy, 0), ivec3(1));
    vec3 baseCellSize = extent / vec3(baseSize);
    float minimumCell = max(min(baseCellSize.x, min(baseCellSize.y, baseCellSize.z)), 1e-3);
    float footprintCells = max(footprintBlocks / minimumCell, 1.0);
    int mip = clamp(int(floor(log2(footprintCells))), 0, levels - 1);
    ivec3 size = max(textureSize(u_CloudOccupancy, mip), ivec3(1));
    ivec3 cell = clamp(ivec3(floor(uvw * vec3(size))), ivec3(0), size - ivec3(1));
    return texelFetch(u_CloudOccupancy, cell, mip).r > 0.5;
}

float localVolumeSignedDistance(LocalFogVolume volume, vec3 relativeWorld) {
    vec3 delta = relativeWorld - volume.centerShape.xyz;
    if (volume.centerShape.w < 0.5) {
        return length(delta) - max(volume.extentDensity.x, 1e-4);
    }
    vec3 q = abs(delta) - max(volume.extentDensity.xyz, vec3(1e-4));
    return length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float localVolumeWeight(LocalFogVolume volume, vec3 relativeWorld) {
    float signedDistance = localVolumeSignedDistance(volume, relativeWorld);
    float edge = max(volume.absorptionEdge.w, 0.0);
    float boundaryWeight = edge > 1e-4
            ? 1.0 - smoothstep(-edge, 0.0, signedDistance)
            : (signedDistance <= 0.0 ? 1.0 : 0.0);
    return clamp(boundaryWeight * max(volume.extentDensity.w, 0.0), 0.0, 1e6);
}

void sampleLocalVolumes(ivec3 coord,
                        ivec3 dimensions,
                        vec3 relativeWorld,
                        out vec3 sigmaS,
                        out vec3 sigmaA,
                        out vec3 emission,
                        out float scatteringWeight,
                        out float anisotropyMoment) {
    sigmaS = vec3(0.0);
    sigmaA = vec3(0.0);
    emission = vec3(0.0);
    scatteringWeight = 0.0;
    anisotropyMoment = 0.0;
    if (u_Data.counts.z <= 0.5) return;

    uint binIndex = combatant_local_fog_bin_index(coord, dimensions);
    uint maxPerBin = uint(max(int(u_Data.localFogBinning.z + 0.5), 1));
    uint count = min(u_LocalFogBinCounts.counts[binIndex], maxPerBin);
    uint base = binIndex * maxPerBin;
    uint volumeCount = uint(clamp(int(u_Data.counts.z + 0.5), 0, u_LocalFogVolumes.volumes.length()));
    for (uint listIndex = 0u; listIndex < count; ++listIndex) {
        uint volumeIndex = u_LocalFogBinIndices.indices[base + listIndex];
        if (volumeIndex >= volumeCount) continue;
        LocalFogVolume volume = u_LocalFogVolumes.volumes[volumeIndex];
        float weight = localVolumeWeight(volume, relativeWorld);
        if (weight <= 1e-6) continue;

        vec3 volumeSigmaS = max(volume.scatteringG.rgb, vec3(0.0)) * weight;
        sigmaS += volumeSigmaS;
        sigmaA += max(volume.absorptionEdge.rgb, vec3(0.0)) * weight;
        emission += max(volume.emission.rgb, vec3(0.0)) * weight;

        float phaseWeight = luminance(volumeSigmaS);
        scatteringWeight += phaseWeight;
        anisotropyMoment += phaseWeight * clamp(volume.scatteringG.w, -0.95, 0.95);
    }
}


float overlapBefore(float boundaryDistance, float nearDistance, float farDistance) {
    float segmentLength = max(farDistance - nearDistance, 1e-5);
    float overlap = max(0.0, min(farDistance, boundaryDistance) - nearDistance);
    return clamp(overlap / segmentLength, 0.0, 1.0);
}

void mediumFractions(vec2 uv, vec3 ray, float nearDistance, float farDistance,
                     out float airFraction, out float cameraWaterFraction) {
    airFraction = 1.0;
    cameraWaterFraction = 0.0;

    vec4 boundary = textureLod(u_WaterBoundary, uv, 0.0);
    bool boundaryValid = boundary.b > 0.5 && boundary.r >= 0.0;
    bool entering = boundary.g > 0.5 && boundary.g < 1.5;
    bool exiting = boundary.g >= 1.5 && boundary.g < 2.5;
    bool cameraInsideWater = u_Data.cameraMediumBoundary.x > 0.5;

    if (boundaryValid && entering && !cameraInsideWater) {
        // Forward water owns the transmitted water segment. Froxels only transport air up to the interface.
        airFraction = overlapBefore(boundary.r, nearDistance, farDistance);
        return;
    }
    if (boundaryValid && exiting && cameraInsideWater) {
        float waterBefore = overlapBefore(boundary.r, nearDistance, farDistance);
        cameraWaterFraction = waterBefore;
        airFraction = 1.0 - waterBefore;
        return;
    }

    // Explicit camera-fluid column is the fallback when the raster boundary is off-screen/missing.
    if (cameraInsideWater && u_Data.cameraMediumBoundary.w > 0.5) {
        float surfaceY = u_Data.cameraMediumBoundary.y;
        float cameraY = u_Data.cameraTime.y;
        float waterEnd = farDistance;
        if (ray.y > 1e-6) waterEnd = max(0.0, (surfaceY - cameraY) / ray.y);
        float waterBefore = overlapBefore(waterEnd, nearDistance, farDistance);
        cameraWaterFraction = waterBefore;
        airFraction = 1.0 - waterBefore;
    }
}

float equivalentEmission(float integratedRadiance, float transmittance, float segmentLength) {
    float t = clamp(transmittance, 1e-6, 1.0);
    float sigma = -log(t) / max(segmentLength, 1e-5);
    float oneMinusT = 1.0 - t;
    if (sigma <= 1e-6 || oneMinusT <= 1e-6) {
        return max(integratedRadiance, 0.0) / max(segmentLength, 1e-5);
    }
    return max(integratedRadiance, 0.0) * sigma / oneMinusT;
}

void mergeAtmosphereAndMedium(vec3 atmosphereRadiance,
                              vec3 atmosphereTransmittance,
                              vec3 mediumExtinction,
                              float atmosphereFraction,
                              float segmentLength,
                              out vec3 radiance,
                              out vec3 transmittance) {
    float airFraction = clamp(atmosphereFraction, 0.0, 1.0);
    vec3 atmosphereSigma = -log(clamp(atmosphereTransmittance, vec3(1e-6), vec3(1.0)))
            / max(segmentLength, 1e-5) * airFraction;
    vec3 atmosphereEmission = vec3(
            equivalentEmission(atmosphereRadiance.r, atmosphereTransmittance.r, segmentLength),
            equivalentEmission(atmosphereRadiance.g, atmosphereTransmittance.g, segmentLength),
            equivalentEmission(atmosphereRadiance.b, atmosphereTransmittance.b, segmentLength)
    ) * airFraction;
    vec3 totalSigma = max(atmosphereSigma + max(mediumExtinction, vec3(0.0)), vec3(0.0));
    transmittance = exp(-totalSigma * segmentLength);
    vec3 factor = vec3(segmentLength);
    for (int channel = 0; channel < 3; ++channel) {
        if (totalSigma[channel] > 1e-6) {
            factor[channel] = (1.0 - transmittance[channel]) / totalSigma[channel];
        }
    }
    radiance = atmosphereEmission * factor;
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 dimensions = imageSize(u_SegmentRadiance);
    if (any(greaterThanEqual(coord, dimensions))) return;

    vec2 uv = (vec2(coord.xy) + 0.5) / vec2(dimensions.xy);
    vec3 ray = worldRay(uv);
    float nearDistance = combatant_froxel_boundary_distance(
            coord.z, dimensions.z, u_Data.froxel.w, u_Data.policy.x);
    float farDistance = combatant_froxel_boundary_distance(
            coord.z + 1, dimensions.z, u_Data.froxel.w, u_Data.policy.x);
    float centerDistance = 0.5 * (nearDistance + farDistance);
    float segmentLength = max(farDistance - nearDistance, 1e-4);

    vec3 nearRadiance;
    vec3 nearTransmittance;
    vec3 farRadiance;
    vec3 farTransmittance;
    cumulativeAtmosphere(ray, nearDistance, nearRadiance, nearTransmittance);
    cumulativeAtmosphere(ray, farDistance, farRadiance, farTransmittance);

    vec3 safeNearT = max(nearTransmittance, vec3(1e-5));
    vec3 atmosphereSegmentT = clamp(farTransmittance / safeNearT, vec3(0.0), vec3(1.0));
    vec3 atmosphereSegmentL = max((farRadiance - nearRadiance) / safeNearT, vec3(0.0));

    vec3 relativeWorld = ray * centerDistance;
    vec3 localPosition = vec3(u_Data.cameraTime.x, u_Data.cameraTime.y, u_Data.cameraTime.z) + relativeWorld;
    float airFraction;
    float waterFraction;
    mediumFractions(uv, ray, nearDistance, farDistance, airFraction, waterFraction);

    float density = mediumDensity(localPosition, centerDistance) * airFraction;
    vec3 worldSigmaS = max(u_Data.mediumScattering.rgb, vec3(0.0)) * density;
    vec3 worldSigmaA = max(u_Data.mediumAbsorption.rgb, vec3(0.0)) * density;
    vec3 waterSigmaS = max(u_Data.cameraMediumScattering.rgb, vec3(0.0)) * waterFraction;
    vec3 waterSigmaA = max(u_Data.cameraMediumAbsorption.rgb, vec3(0.0)) * waterFraction;
    vec3 localSigmaS;
    vec3 localSigmaA;
    vec3 localEmission;
    float localScatteringWeight;
    float localAnisotropyMoment;
    sampleLocalVolumes(coord, dimensions, relativeWorld, localSigmaS, localSigmaA, localEmission,
            localScatteringWeight, localAnisotropyMoment);

    vec3 sigmaS = worldSigmaS + waterSigmaS + localSigmaS;
    vec3 sigmaA = worldSigmaA + waterSigmaA + localSigmaA;
    vec3 sigmaT = sigmaS + sigmaA;

    vec3 segmentRadiance;
    vec3 segmentTransmittance;
    mergeAtmosphereAndMedium(atmosphereSegmentL, atmosphereSegmentT, sigmaT, airFraction,
            segmentLength, segmentRadiance, segmentTransmittance);

    float worldY = localPosition.y;
    float shadowVisibility = combatant_sample_cloud_shadow(
            u_CloudShadowMap, relativeWorld, worldY,
            u_Data.shadowMapDomain, u_Data.shadowSun, u_Data.cloudBounds);
    segmentRadiance *= shadowVisibility;

    vec3 emissionSigma = -log(max(clamp(segmentTransmittance, vec3(0.0), vec3(1.0)), vec3(1e-6)))
            / max(segmentLength, 1e-5);
    vec3 emissionFactor = vec3(segmentLength);
    for (int channel = 0; channel < 3; ++channel) {
        if (emissionSigma[channel] > 1e-6) {
            emissionFactor[channel] = (1.0 - segmentTransmittance[channel]) / emissionSigma[channel];
        }
    }
    segmentRadiance += max(localEmission, vec3(0.0)) * emissionFactor;

    float cloudSigmaT = 0.0;
    float cloudSigmaS = 0.0;
    if (u_Data.counts.w > 0.5 && cloudOccupancyAt(localPosition, segmentLength)) {
        CloudOptics cloud = combatant_cloud_lighting_optics_at(localPosition);
        cloudSigmaT = max(0.0, cloud.density * cloud.extinction);
        cloudSigmaS = cloudSigmaT * clamp(cloud.albedo, 0.0, 1.0);
        segmentRadiance *= exp(-cloudSigmaT * segmentLength * 0.5);
    }

    float worldWeight = max(max(worldSigmaS.r, worldSigmaS.g), worldSigmaS.b);
    float waterWeight = max(max(waterSigmaS.r, waterSigmaS.g), waterSigmaS.b);
    float totalScatteringWeight = worldWeight + waterWeight + localScatteringWeight;
    float anisotropy = totalScatteringWeight > 1e-8
            ? (clamp(u_Data.mediumScattering.w, -0.95, 0.95) * worldWeight
               + clamp(u_Data.cameraMediumScattering.w, -0.95, 0.95) * waterWeight
               + localAnisotropyMoment)
              / totalScatteringWeight
            : 0.0;

    imageStore(u_SegmentRadiance, coord, vec4(segmentRadiance, cloudSigmaT));
    imageStore(u_SegmentTransmittance, coord, vec4(segmentTransmittance, cloudSigmaS));
    imageStore(u_MediaProperties, coord, vec4(sigmaS, clamp(anisotropy, -0.95, 0.95)));
}
