#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0, r32f) writeonly uniform image2D u_CloudShadowMap;
layout(binding = 5) uniform sampler3D u_CloudOccupancy;

layout(std430, binding = 1) readonly buffer CloudShadowMapData {
    vec4 cameraTime;
    vec4 grid;
    vec4 macroGrid;
    vec4 macroOrigin;
    vec4 counts;
    vec4 sunDirection;
    vec4 noiseDomain;
    vec4 mapDomain;
    vec4 occupancyDomain;
    vec4 occupancyPolicy;
} u_Data;

const int MAX_SHADOW_STEPS = 128;
const int MAX_ALTITUDE_SLICES = 16;

#define COMBATANT_CLOUD_WEATHER_BINDING 2
#define COMBATANT_CLOUD_DOMAIN_BINDING 3
#define COMBATANT_CLOUD_MACRO_WEATHER_BINDING 4
#moj_import <combatant:deferred_cloud_density.glsl>

bool cloudBounds(out float minY, out float maxY) {
    minY = 1e20;
    maxY = -1e20;
    int domainCount = clamp(int(u_Data.counts.x), 0, COMBATANT_CLOUD_MAX_DOMAINS);
    for (int i = 0; i < COMBATANT_CLOUD_MAX_DOMAINS; ++i) {
        if (i >= domainCount) break;
        minY = min(minY, u_Domains.domains[i].envelope.x);
        maxY = max(maxY, u_Domains.domains[i].envelope.y);
    }
    return domainCount > 0 && maxY > minY;
}

bool cloudOccupancyAt(vec3 localPosition, float lod) {
    if (u_Data.occupancyPolicy.y <= 0.5) return true;
    float spanXZ = max(u_Data.occupancyPolicy.x, 1.0);
    float spanY = max(u_Data.occupancyDomain.w - u_Data.occupancyDomain.z, 1.0);
    vec3 origin = vec3(u_Data.occupancyDomain.x, u_Data.occupancyDomain.z, u_Data.occupancyDomain.y);
    vec3 uvw = (localPosition - origin) / vec3(spanXZ, spanY, spanXZ);
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThanEqual(uvw, vec3(1.0)))) return true;
    int mip = clamp(int(lod), 0, max(textureQueryLevels(u_CloudOccupancy) - 1, 0));
    ivec3 size = textureSize(u_CloudOccupancy, mip);
    ivec3 cell = clamp(ivec3(floor(uvw * vec3(size))), ivec3(0), size - ivec3(1));
    return texelFetch(u_CloudOccupancy, cell, mip).r > 0.5;
}

void writeIdentitySlices(ivec2 pixel, int sliceHeight, int sliceCount) {
    for (int slice = 0; slice < MAX_ALTITUDE_SLICES; ++slice) {
        if (slice >= sliceCount) break;
        imageStore(u_CloudShadowMap, ivec2(pixel.x, pixel.y + slice * sliceHeight), vec4(1.0));
    }
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 atlasSize = imageSize(u_CloudShadowMap);
    int sliceCount = clamp(int(u_Data.counts.w), 1, MAX_ALTITUDE_SLICES);
    int sliceHeight = max(1, atlasSize.y / sliceCount);
    if (pixel.x >= atlasSize.x || pixel.y >= sliceHeight) return;

    if (u_Data.counts.z <= 0.5 || u_Data.sunDirection.w <= 0.5 || u_Data.sunDirection.y <= 0.02) {
        writeIdentitySlices(pixel, sliceHeight, sliceCount);
        return;
    }

    float minY;
    float maxY;
    if (!cloudBounds(minY, maxY)) {
        writeIdentitySlices(pixel, sliceHeight, sliceCount);
        return;
    }

    vec3 sun = normalize(u_Data.sunDirection.xyz);
    float referenceY = u_Data.mapDomain.w;
    float startT = max(0.0, (minY - referenceY) / sun.y);
    float endT = (maxY - referenceY) / sun.y;
    if (endT <= startT) {
        writeIdentitySlices(pixel, sliceHeight, sliceCount);
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(atlasSize.x, sliceHeight);
    vec2 referenceRelative = u_Data.mapDomain.xy + uv * u_Data.mapDomain.z;
    vec3 referenceLocal = vec3(u_Data.cameraTime.x + referenceRelative.x, referenceY,
            u_Data.cameraTime.z + referenceRelative.y);

    float opticalBelow[MAX_ALTITUDE_SLICES];
    for (int slice = 0; slice < MAX_ALTITUDE_SLICES; ++slice) opticalBelow[slice] = 0.0;

    int steps = clamp(int(u_Data.counts.y), 8, MAX_SHADOW_STEPS);
    float stepLength = (endT - startT) / float(steps);
    float totalOpticalDepth = 0.0;
    float jitter = combatant_cloud_hash31(vec3(pixel, u_Data.noiseDomain.z * 127.0));

    for (int i = 0; i < MAX_SHADOW_STEPS; ++i) {
        if (i >= steps || totalOpticalDepth >= 20.0) break;
        float t = startT + (float(i) + jitter) * stepLength;
        vec3 samplePosition = referenceLocal + sun * t;
        float dTau = cloudOccupancyAt(samplePosition, 1.0)
                ? combatant_cloud_optical_density_at(samplePosition) * stepLength
                : 0.0;
        totalOpticalDepth += dTau;

        float height01 = clamp((samplePosition.y - minY) / max(maxY - minY, 1.0), 0.0, 1.0);
        for (int slice = 0; slice < MAX_ALTITUDE_SLICES; ++slice) {
            if (slice >= sliceCount) break;
            float slice01 = sliceCount <= 1 ? 0.0 : float(slice) / float(sliceCount - 1);
            if (height01 < slice01) opticalBelow[slice] += dTau;
        }
    }

    for (int slice = 0; slice < MAX_ALTITUDE_SLICES; ++slice) {
        if (slice >= sliceCount) break;
        float opticalAbove = max(0.0, totalOpticalDepth - opticalBelow[slice]);
        float visibility = exp(-min(opticalAbove, 20.0));
        imageStore(u_CloudShadowMap, ivec2(pixel.x, pixel.y + slice * sliceHeight), vec4(visibility, 0.0, 0.0, 0.0));
    }
}
