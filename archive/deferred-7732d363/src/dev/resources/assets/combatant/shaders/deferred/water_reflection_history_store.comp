#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_Color;
layout(binding = 1) uniform sampler2D u_Confidence;
layout(binding = 2) uniform sampler2D u_Depths;
layout(binding = 3, rgba16f) writeonly uniform image2D u_HistoryColor;
layout(binding = 4, r8) writeonly uniform image2D u_HistoryConfidence;
layout(binding = 5, r32f) writeonly uniform image2D u_HistorySourceDepth;
layout(binding = 6, r32f) writeonly uniform image2D u_HistoryHitDepth;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_HistoryColor);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 depths = textureLod(u_Depths, uv, 0.0);
    imageStore(u_HistoryColor, pixel, textureLod(u_Color, uv, 0.0));
    imageStore(u_HistoryConfidence, pixel, vec4(textureLod(u_Confidence, uv, 0.0).r, 0.0, 0.0, 0.0));
    imageStore(u_HistorySourceDepth, pixel, vec4(max(depths.x, 0.0), 0.0, 0.0, 0.0));
    imageStore(u_HistoryHitDepth, pixel, vec4(max(depths.z, 0.0), 0.0, 0.0, 0.0));
}
