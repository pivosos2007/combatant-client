#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_BaseRadiance;
layout(binding = 1) uniform sampler2D u_Depth;
layout(binding = 2) uniform sampler2D u_CloudRadiance;
layout(binding = 3) uniform sampler2D u_CloudDepth;
layout(binding = 4, rgba16f) readonly uniform image3D u_IntegratedRadiance;
layout(binding = 5, rgba16f) readonly uniform image3D u_IntegratedTransmittance;
layout(binding = 6, rgba16f) writeonly uniform image2D u_Output;
layout(std430, binding = 7) readonly buffer AtmosphereCompositeData {
    mat4 inverseProjection;
    mat4 inverseView;
    vec4 froxel;
    vec4 policy;
    vec4 aerialLayout;
} u_Data;
layout(binding = 8) uniform sampler2D u_AerialRadiance;
layout(binding = 9) uniform sampler2D u_AerialTransmittance;
layout(binding = 10) uniform sampler2D u_HighCloudRadiance;
layout(binding = 11) uniform sampler2D u_HighCloudDepth;
layout(binding = 12) uniform sampler2D u_ConvectiveCloudRadiance;
layout(binding = 13) uniform sampler2D u_ConvectiveCloudDepth;

#moj_import <combatant:deferred_froxel_transport.glsl>
#moj_import <combatant:deferred_aerial_sampling.glsl>

struct MediaTransport {
    vec3 radiance;
    vec3 transmittance;
};

struct CloudSegment {
    vec4 cloud;
    float depth;
};

vec3 viewPosition(vec2 uv, float depth) {
    float ndcZ = u_Data.policy.y > 0.5 ? depth : depth * 2.0 - 1.0;
    vec4 view = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    return view.xyz / max(abs(view.w), 1e-7) * sign(view.w);
}

vec3 worldRay(vec2 uv) {
    float ndcZ = u_Data.policy.y > 0.5 ? 0.5 : 0.0;
    vec4 view = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    vec3 viewDirection = normalize(view.xyz / max(abs(view.w), 1e-7) * sign(view.w));
    return normalize(mat3(u_Data.inverseView) * viewDirection);
}

CloudSegment sampleCloudDepthAware(sampler2D radianceTexture, sampler2D depthTexture,
                                   vec2 uv, float sceneDistance) {
    ivec2 size = textureSize(radianceTexture, 0);
    vec2 position = uv * vec2(size) - 0.5;
    ivec2 base = ivec2(floor(position));
    vec2 f = fract(position);
    ivec2 coords[4] = ivec2[4](base, base + ivec2(1, 0), base + ivec2(0, 1), base + ivec2(1, 1));
    float bilinear[4] = float[4]((1.0 - f.x) * (1.0 - f.y), f.x * (1.0 - f.y),
                                 (1.0 - f.x) * f.y, f.x * f.y);

    float referenceDepth = 1e30;
    bool hasVisible = false;
    for (int i = 0; i < 4; ++i) {
        ivec2 sampleCoord = clamp(coords[i], ivec2(0), size - ivec2(1));
        float d = texelFetch(depthTexture, sampleCoord, 0).r;
        bool visible = d >= 0.0 && (sceneDistance < 0.0 || d < sceneDistance);
        if (visible) {
            hasVisible = true;
            referenceDepth = min(referenceDepth, d);
        }
    }
    CloudSegment result;
    result.cloud = vec4(0.0, 0.0, 0.0, 1.0);
    result.depth = -1.0;
    if (!hasVisible) return result;

    vec4 accumulated = vec4(0.0);
    float accumulatedDepth = 0.0;
    float weightSum = 0.0;
    float depthScale = max(12.0, referenceDepth * 0.06);
    for (int i = 0; i < 4; ++i) {
        ivec2 sampleCoord = clamp(coords[i], ivec2(0), size - ivec2(1));
        float d = texelFetch(depthTexture, sampleCoord, 0).r;
        bool visible = d >= 0.0 && (sceneDistance < 0.0 || d < sceneDistance);
        if (!visible) continue;
        float depthWeight = exp(-abs(d - referenceDepth) / depthScale);
        float weight = bilinear[i] * depthWeight;
        accumulated += texelFetch(radianceTexture, sampleCoord, 0) * weight;
        accumulatedDepth += d * weight;
        weightSum += weight;
    }
    if (weightSum > 1e-6) {
        result.cloud = accumulated / weightSum;
        result.depth = accumulatedDepth / weightSum;
    }
    return result;
}

MediaTransport identityTransport() {
    MediaTransport result;
    result.radiance = vec3(0.0);
    result.transmittance = vec3(1.0);
    return result;
}

MediaTransport atmosphereTransport(vec3 rayWorld, float distanceBlocks) {
    if (distanceBlocks <= 0.0) return identityTransport();
    float distanceKm = distanceBlocks * 0.001;
    MediaTransport result;
    result.radiance = max(combatant_sample_aerial(u_AerialRadiance, rayWorld, distanceKm).rgb, vec3(0.0));
    result.transmittance = clamp(combatant_sample_aerial(u_AerialTransmittance, rayWorld, distanceKm).rgb,
            vec3(0.0), vec3(1.0));
    return result;
}

MediaTransport fetchBoundary(ivec2 cell, int slice) {
    ivec3 dimensions = imageSize(u_IntegratedRadiance);
    if (slice < 0) return identityTransport();
    slice = clamp(slice, 0, dimensions.z - 1);
    cell = clamp(cell, ivec2(0), dimensions.xy - ivec2(1));
    MediaTransport result;
    result.radiance = max(imageLoad(u_IntegratedRadiance, ivec3(cell, slice)).rgb, vec3(0.0));
    result.transmittance = clamp(imageLoad(u_IntegratedTransmittance, ivec3(cell, slice)).rgb,
            vec3(0.0), vec3(1.0));
    return result;
}

MediaTransport sampleColumn(ivec2 cell, float distanceBlocks) {
    ivec3 dimensions = imageSize(u_IntegratedRadiance);
    float maxDistance = max(u_Data.froxel.w, 1e-4);
    float exponentValue = max(u_Data.policy.x, 1.0);
    float distance01 = clamp(distanceBlocks / maxDistance, 0.0, 1.0);
    float boundary = pow(distance01, 1.0 / exponentValue) * float(dimensions.z);
    float coordinate = boundary - 1.0;
    int lower = int(floor(coordinate));
    int upper = lower + 1;
    float fractionValue = fract(coordinate);
    MediaTransport a = fetchBoundary(cell, lower);
    MediaTransport b = fetchBoundary(cell, upper);
    MediaTransport result;
    result.radiance = mix(a.radiance, b.radiance, fractionValue);
    result.transmittance = mix(a.transmittance, b.transmittance, fractionValue);
    return result;
}

MediaTransport sampleTransport(vec2 uv, float distanceBlocks) {
    ivec2 dimensions = imageSize(u_IntegratedRadiance).xy;
    vec2 position = uv * vec2(dimensions) - 0.5;
    ivec2 base = ivec2(floor(position));
    vec2 f = fract(position);
    MediaTransport a = sampleColumn(base, distanceBlocks);
    MediaTransport b = sampleColumn(base + ivec2(1, 0), distanceBlocks);
    MediaTransport c = sampleColumn(base + ivec2(0, 1), distanceBlocks);
    MediaTransport d = sampleColumn(base + ivec2(1, 1), distanceBlocks);
    MediaTransport result;
    result.radiance = mix(mix(a.radiance, b.radiance, f.x), mix(c.radiance, d.radiance, f.x), f.y);
    result.transmittance = mix(mix(a.transmittance, b.transmittance, f.x),
                               mix(c.transmittance, d.transmittance, f.x), f.y);
    return result;
}

MediaTransport segmentBetween(MediaTransport nearTransport, MediaTransport farTransport) {
    vec3 safeNearT = max(nearTransport.transmittance, vec3(1e-5));
    MediaTransport result;
    result.transmittance = clamp(farTransport.transmittance / safeNearT, vec3(0.0), vec3(1.0));
    result.radiance = max((farTransport.radiance - nearTransport.radiance) / safeNearT, vec3(0.0));
    return result;
}

void sortSegments(inout CloudSegment segments[3], out int count, float backgroundDistance) {
    count = 0;
    CloudSegment compact[3];
    for (int i = 0; i < 3; ++i) {
        if (segments[i].depth < 0.0 || segments[i].depth > backgroundDistance) continue;
        compact[count++] = segments[i];
    }
    for (int i = 1; i < 3; ++i) {
        if (i >= count) break;
        CloudSegment key = compact[i];
        int j = i - 1;
        for (int k = 0; k < 3; ++k) {
            if (j < 0 || compact[j].depth <= key.depth) break;
            compact[j + 1] = compact[j];
            j--;
        }
        compact[j + 1] = key;
    }
    for (int i = 0; i < 3; ++i) {
        if (i < count) segments[i] = compact[i];
    }
}

vec3 composeSegments(vec2 uv, CloudSegment segments[3], int count,
                     float backgroundDistance, vec3 backgroundSource) {
    MediaTransport backgroundTransport = sampleTransport(uv, backgroundDistance);
    if (count <= 0) return backgroundTransport.radiance + backgroundTransport.transmittance * backgroundSource;

    vec3 behindRadiance = backgroundSource;
    float fartherDepth = backgroundDistance;
    MediaTransport fartherTransport = backgroundTransport;
    for (int reverseIndex = 0; reverseIndex < 3; ++reverseIndex) {
        int i = count - 1 - reverseIndex;
        if (i < 0) break;
        float depth = clamp(segments[i].depth, 0.0, fartherDepth);
        MediaTransport nearTransport = sampleTransport(uv, depth);
        MediaTransport between = segmentBetween(nearTransport, fartherTransport);
        vec3 atCloud = between.radiance + between.transmittance * behindRadiance;
        float cloudT = clamp(segments[i].cloud.a, 0.0, 1.0);
        behindRadiance = max(segments[i].cloud.rgb, vec3(0.0)) + cloudT * atCloud;
        fartherDepth = depth;
        fartherTransport = nearTransport;
    }
    MediaTransport front = sampleTransport(uv, fartherDepth);
    return front.radiance + front.transmittance * behindRadiance;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_Output);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec3 base = max(textureLod(u_BaseRadiance, uv, 0.0).rgb, vec3(0.0));
    float depth = textureLod(u_Depth, uv, 0.0).r;
    float sceneDistance = depth > 0.0 ? length(viewPosition(uv, depth)) : -1.0;
    float backgroundDistance = sceneDistance >= 0.0 ? min(sceneDistance, u_Data.froxel.w) : u_Data.froxel.w;

    CloudSegment segments[3];
    for (int i = 0; i < 3; ++i) {
        segments[i].cloud = vec4(0.0, 0.0, 0.0, 1.0);
        segments[i].depth = -1.0;
    }
    int cloudMask = int(u_Data.policy.z + 0.5);
    if ((cloudMask & 1) != 0)
        segments[0] = sampleCloudDepthAware(u_CloudRadiance, u_CloudDepth, uv, sceneDistance);
    if ((cloudMask & 2) != 0)
        segments[1] = sampleCloudDepthAware(u_HighCloudRadiance, u_HighCloudDepth, uv, sceneDistance);
    if ((cloudMask & 4) != 0)
        segments[2] = sampleCloudDepthAware(u_ConvectiveCloudRadiance, u_ConvectiveCloudDepth, uv, sceneDistance);
    int segmentCount;
    sortSegments(segments, segmentCount, backgroundDistance);

    vec3 backgroundSource = base;
    if (sceneDistance < 0.0) {
        vec3 rayWorld = worldRay(uv);
        MediaTransport atmosphereFront = atmosphereTransport(rayWorld, backgroundDistance);
        vec3 safeAtmosphereT = max(atmosphereFront.transmittance, vec3(1e-5));
        backgroundSource = max((base - atmosphereFront.radiance) / safeAtmosphereT, vec3(0.0));
    }

    vec3 result = composeSegments(uv, segments, segmentCount, backgroundDistance, backgroundSource);
    imageStore(u_Output, pixel, vec4(max(result, vec3(0.0)), 1.0));
}
