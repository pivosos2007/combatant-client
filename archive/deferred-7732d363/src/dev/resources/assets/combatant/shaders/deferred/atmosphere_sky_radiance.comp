#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_Transmittance;
layout(binding = 1) uniform sampler2D u_MultiScattering;
layout(binding = 2, rgba16f) writeonly uniform image2D u_SkyRadiance;
layout(std430, binding = 3) readonly buffer AtmosphereParams {
    vec4 radii;
    vec4 rayleigh;
    vec4 mieScattering;
    vec4 mieExtinction;
    vec4 ozone;
    vec4 ozoneShapeGroundR;
    vec4 groundGB;
    vec4 sunDirection;
    vec4 sunRadiance;
    vec4 moonDirection;
    vec4 moonRadiance;
    vec4 aerial;
} u_Atm;

const float PI = 3.14159265358979323846;

vec3 directionFromLatLong(vec2 uv) {
    float phi = (uv.x * 2.0 - 1.0) * PI;
    float theta = uv.y * PI;
    float s = sin(theta);
    return vec3(s * cos(phi), cos(theta), s * sin(phi));
}

float distanceToSphere(float r, float mu, float radius) {
    float d = r * r * (mu * mu - 1.0) + radius * radius;
    return d <= 0.0 ? -1.0 : -r * mu + sqrt(d);
}

bool rayHitsGround(float r, float mu) {
    float rg = u_Atm.radii.x;
    float d = r * r * (mu * mu - 1.0) + rg * rg;
    if (d < 0.0) return false;
    return (-r * mu - sqrt(d)) > 0.0;
}

vec2 transUv(float r, float mu) {
    return vec2(clamp(mu * 0.5 + 0.5, 0.0, 1.0),
                clamp((r - u_Atm.radii.x) / max(u_Atm.radii.y - u_Atm.radii.x, 1e-3), 0.0, 1.0));
}

void mediumAt(float h, out vec3 betaR, out vec3 betaMs, out vec3 betaE) {
    float rd = exp(-max(h, 0.0) / max(u_Atm.rayleigh.w, 1e-3));
    float md = exp(-max(h, 0.0) / max(u_Atm.mieScattering.w, 1e-3));
    float od = max(0.0, 1.0 - abs(h - u_Atm.ozone.w) / max(u_Atm.ozoneShapeGroundR.x, 1e-3));
    betaR = u_Atm.rayleigh.rgb * rd;
    betaMs = u_Atm.mieScattering.rgb * md;
    betaE = betaR + u_Atm.mieExtinction.rgb * md + u_Atm.ozone.rgb * od;
}

float rayleighPhase(float c) {
    return 3.0 * (1.0 + c * c) / (16.0 * PI);
}

float miePhase(float c, float g) {
    float g2 = g * g;
    float denom = max(1.0 + g2 - 2.0 * g * c, 1e-4);
    return (1.0 - g2) / (4.0 * PI * denom * sqrt(denom));
}

vec3 lightTransmittance(float r, vec3 up, vec3 lightDir) {
    float mu = dot(up, lightDir);
    if (rayHitsGround(r, mu)) return vec3(0.0);
    return textureLod(u_Transmittance, transUv(r, mu), 0.0).rgb;
}

float environmentDiscProxy(vec3 viewDir, vec3 lightDir, float angularRadius) {
    ivec2 size = imageSize(u_SkyRadiance);
    float dTheta = PI / max(float(size.y), 1.0);
    float dPhi = (2.0 * PI / max(float(size.x), 1.0))
            * sqrt(max(0.0, 1.0 - viewDir.y * viewDir.y));
    float texelRadius = 0.5 * sqrt(dTheta * dTheta + dPhi * dPhi);
    float supportRadius = max(max(angularRadius, 1e-6), texelRadius * 1.25);
    float areaScale = min(1.0, (angularRadius * angularRadius)
            / max(supportRadius * supportRadius, 1e-8));
    float angle = acos(clamp(dot(normalize(viewDir), normalize(lightDir)), -1.0, 1.0));
    float kernel = 1.0 - smoothstep(supportRadius * 0.35, supportRadius, angle);
    return areaScale * kernel;
}

vec3 integrateSky(vec3 viewDir) {
    float r0 = u_Atm.radii.z;
    float mu0 = viewDir.y;
    if (rayHitsGround(r0, mu0)) return vec3(0.0);
    float tMax = distanceToSphere(r0, mu0, u_Atm.radii.y);
    if (tMax <= 0.0) return vec3(0.0);

    const int STEPS = 32;
    float ds = tMax / float(STEPS);
    vec3 p0 = vec3(0.0, r0, 0.0);
    vec3 throughput = vec3(1.0);
    vec3 radiance = vec3(0.0);

    for (int i = 0; i < STEPS; ++i) {
        float t = (float(i) + 0.5) * ds;
        vec3 p = p0 + viewDir * t;
        float r = length(p);
        vec3 up = p / max(r, 1e-5);
        vec3 betaR, betaMs, betaE;
        mediumAt(r - u_Atm.radii.x, betaR, betaMs, betaE);

        vec3 source = vec3(0.0);
        if (u_Atm.sunRadiance.a > 0.5) {
            vec3 ld = normalize(u_Atm.sunDirection.xyz);
            vec3 lt = lightTransmittance(r, up, ld);
            float c = dot(viewDir, ld);
            vec3 multi = textureLod(u_MultiScattering, transUv(r, dot(up, ld)), 0.0).rgb;
            source += u_Atm.sunRadiance.rgb * lt * (betaR * rayleighPhase(c) + betaMs * miePhase(c, u_Atm.mieExtinction.w));
            source += u_Atm.sunRadiance.rgb * lt * multi * (betaR + betaMs) / (4.0 * PI);
        }
        if (u_Atm.moonRadiance.a > 0.5) {
            vec3 ld = normalize(u_Atm.moonDirection.xyz);
            vec3 lt = lightTransmittance(r, up, ld);
            float c = dot(viewDir, ld);
            source += u_Atm.moonRadiance.rgb * lt * (betaR * rayleighPhase(c) + betaMs * miePhase(c, u_Atm.mieExtinction.w));
        }

        vec3 segmentT = exp(-betaE * ds);
        vec3 integral = (vec3(1.0) - segmentT) / max(betaE, vec3(1e-6));
        radiance += throughput * source * integral;
        throughput *= segmentT;
    }

    // The canonical environment map is intentionally low frequency. Celestial discs can be
    // smaller than one lat-long texel, so integrate their solid-angle energy into a stable proxy
    // instead of using a center-sample threshold that flickers as the body crosses texel borders.
    vec3 observerT;
    if (u_Atm.sunRadiance.a > 0.5 && u_Atm.sunDirection.y > -u_Atm.sunDirection.w) {
        observerT = textureLod(u_Transmittance, transUv(r0, u_Atm.sunDirection.y), 0.0).rgb;
        float proxy = environmentDiscProxy(viewDir, u_Atm.sunDirection.xyz, u_Atm.sunDirection.w);
        radiance += u_Atm.sunRadiance.rgb * observerT * proxy;
    }
    if (u_Atm.moonRadiance.a > 0.5 && u_Atm.moonDirection.y > -u_Atm.moonDirection.w) {
        observerT = textureLod(u_Transmittance, transUv(r0, u_Atm.moonDirection.y), 0.0).rgb;
        float proxy = environmentDiscProxy(viewDir, u_Atm.moonDirection.xyz, u_Atm.moonDirection.w);
        radiance += u_Atm.moonRadiance.rgb * observerT * proxy;
    }
    return max(radiance, vec3(0.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_SkyRadiance);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    imageStore(u_SkyRadiance, pixel, vec4(integrateSky(directionFromLatLong(uv)), 1.0));
}
