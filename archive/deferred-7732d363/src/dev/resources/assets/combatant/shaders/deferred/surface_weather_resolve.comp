#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_Seed;
layout(binding = 1) uniform sampler2D u_WorldLoad;
layout(binding = 2) uniform sampler2D u_GbufferGeometry;
layout(binding = 3) uniform sampler2D u_ResolvedDepth;
layout(binding = 4) uniform sampler2D u_GbufferDepth;
layout(binding = 5) uniform usampler2D u_GbufferMaterialId;
layout(binding = 6, r8) writeonly uniform image2D u_SkyVisibility;
layout(binding = 7, r8) writeonly uniform image2D u_PrecipitationExposure;
layout(binding = 8, rgba16f) writeonly uniform image2D u_SurfaceState;

layout(std430, binding = 9) readonly buffer SurfaceWeatherResolveData {
    mat4 inverseProjection;
    mat4 inverseView;
    vec4 cameraDepth;
    vec4 grid;
    vec4 exposure;
} u_Data;

struct MaterialWeatherResponse {
    uint materialId;
    uint occupied;
    uint pad0;
    uint pad1;
    vec4 responseA;
    vec4 responseB;
};
layout(std430, binding = 10) readonly buffer MaterialWeatherResponses {
    MaterialWeatherResponse entries[];
} u_Responses;

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

vec3 reconstructView(vec2 uv, float depth) {
    float ndcZ = u_Data.cameraDepth.w > 0.5 ? depth : depth * 2.0 - 1.0;
    vec4 h = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    return h.xyz / max(abs(h.w), 1e-7) * sign(h.w);
}

bool ownsGbufferPixel(vec2 uv, float depth) {
    float gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    if (depth <= 0.0 || gbufferDepth <= 0.0) return false;
    float tolerance = max(1e-6, abs(gbufferDepth) * 1e-5);
    return abs(depth - gbufferDepth) <= tolerance;
}

float decodeIntensity(float encoded, out int semantic) {
    semantic = int(floor(max(encoded, 0.0) + 1e-4));
    return clamp((encoded - float(semantic)) / max(u_Data.exposure.y, 1e-4), 0.0, 1.0);
}

uint hashMaterial(uint id) {
    return id * 2654435761u;
}

void materialResponse(uint materialId, out vec4 responseA, out vec4 responseB) {
    responseA = vec4(0.0);
    responseB = vec4(0.0);
    uint mask = uint(max(u_Data.exposure.z, 0.0));
    uint maxProbes = uint(max(u_Data.exposure.w, 1.0));
    uint slot = hashMaterial(materialId) & mask;
    for (uint probe = 0u; probe < maxProbes; ++probe) {
        MaterialWeatherResponse entry = u_Responses.entries[(slot + probe) & mask];
        if (entry.occupied == 0u) return;
        if (entry.materialId == materialId) {
            responseA = entry.responseA;
            responseB = entry.responseB;
            return;
        }
    }
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_SurfaceState);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float depth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    if (!ownsGbufferPixel(uv, depth)) {
        imageStore(u_SkyVisibility, pixel, vec4(0.0));
        imageStore(u_PrecipitationExposure, pixel, vec4(0.0));
        imageStore(u_SurfaceState, pixel, vec4(0.0));
        return;
    }

    vec3 viewPosition = reconstructView(uv, depth);
    vec3 cameraRelativeWorld = (u_Data.inverseView * vec4(viewPosition, 0.0)).xyz;
    vec3 worldPosition = u_Data.cameraDepth.xyz + cameraRelativeWorld;
    float spacing = max(u_Data.grid.z, 1.0);
    vec2 gridCell = (worldPosition.xz - u_Data.grid.xy) / spacing;
    ivec2 cell = ivec2(round(gridCell));
    int gridSize = int(u_Data.grid.w + 0.5);
    bool inside = all(greaterThanEqual(cell, ivec2(0))) && all(lessThan(cell, ivec2(gridSize)));
    if (!inside) {
        imageStore(u_SkyVisibility, pixel, vec4(0.0));
        imageStore(u_PrecipitationExposure, pixel, vec4(0.0));
        imageStore(u_SurfaceState, pixel, vec4(0.0));
        return;
    }

    vec4 seed = texelFetch(u_Seed, cell, 0);
    if (seed.x < -60000.0) {
        imageStore(u_SkyVisibility, pixel, vec4(0.0));
        imageStore(u_PrecipitationExposure, pixel, vec4(0.0));
        imageStore(u_SurfaceState, pixel, vec4(0.0));
        return;
    }

    float skyVisibility = worldPosition.y >= seed.x - u_Data.exposure.x ? 1.0 : 0.0;
    int precipitationKind;
    float precipitation = decodeIntensity(seed.z, precipitationKind);
    float precipitationExposure = skyVisibility * precipitation;

    vec4 load = texelFetch(u_WorldLoad, cell, 0);
    uint materialId = texelFetch(u_GbufferMaterialId, pixel, 0).r;
    vec4 responseA;
    vec4 responseB;
    materialResponse(materialId, responseA, responseB);

    vec3 normalView = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    vec3 normalWorld = normalize(mat3(u_Data.inverseView) * normalView);
    float upFacing = clamp(normalWorld.y, 0.0, 1.0);

    float liquidLoad = clamp(load.r, 0.0, 1.0);
    float dryAge = max(load.g, 0.0);
    float snowLoad = clamp(load.b, 0.0, 1.0);
    int particulateKind;
    float particulateLoad = decodeIntensity(load.a, particulateKind);

    float drying = exp(-dryAge * max(responseA.z, 0.0) / 60.0);
    float absorbedResponse = 1.0 - exp(-liquidLoad * (0.25 + 3.75 * max(responseA.y, 0.0)));
    float wetness = clamp(responseA.x * absorbedResponse * drying * skyVisibility, 0.0, 1.0);
    float puddle = clamp(liquidLoad * responseB.x * (1.0 - responseA.y)
            * (1.0 - responseA.w) * pow(upFacing, 6.0) * skyVisibility, 0.0, 1.0);
    float snow = clamp(snowLoad * responseB.y * smoothstep(0.35, 0.85, upFacing) * skyVisibility, 0.0, 1.0);
    float particulate = clamp(particulateLoad * responseB.z
            * (1.0 - precipitationExposure * responseB.w) * skyVisibility, 0.0, 1.0);
    float encodedParticulate = particulateKind > 0 && particulate > 1e-5
            ? float(particulateKind) + particulate * u_Data.exposure.y : 0.0;

    imageStore(u_SkyVisibility, pixel, vec4(skyVisibility, 0.0, 0.0, 0.0));
    imageStore(u_PrecipitationExposure, pixel, vec4(precipitationExposure, 0.0, 0.0, 0.0));
    imageStore(u_SurfaceState, pixel, vec4(wetness, puddle, snow, encodedParticulate));
}
