#version 430 core

/* Diffuse-convolved real SH9 coefficients from an HDR lat-long environment. */
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_SkyRadiance;
layout(std430, binding = 1) writeonly buffer SkyDiffuseSh { vec4 coefficients[]; } u_Sh;

const float PI = 3.14159265358979323846;

vec3 latLongDirection(vec2 uv) {
    float phi = (uv.x * 2.0 - 1.0) * PI;
    float theta = uv.y * PI;
    float s = sin(theta);
    return vec3(s * cos(phi), cos(theta), s * sin(phi));
}

float basisValue(int index, vec3 d) {
    if (index == 0) return 0.28209479177387814;
    if (index == 1) return 0.4886025119029199 * d.y;
    if (index == 2) return 0.4886025119029199 * d.z;
    if (index == 3) return 0.4886025119029199 * d.x;
    if (index == 4) return 1.0925484305920792 * d.x * d.y;
    if (index == 5) return 1.0925484305920792 * d.y * d.z;
    if (index == 6) return 0.31539156525252005 * (3.0 * d.z * d.z - 1.0);
    if (index == 7) return 1.0925484305920792 * d.x * d.z;
    return 0.5462742152960396 * (d.x * d.x - d.y * d.y);
}

float lambertBandFactor(int index) {
    if (index == 0) return PI;
    if (index <= 3) return 2.0 * PI / 3.0;
    return PI / 4.0;
}

void main() {
    int coefficientIndex = int(gl_GlobalInvocationID.x);
    if (coefficientIndex >= 9) return;

    ivec2 size = textureSize(u_SkyRadiance, 0);
    vec3 integral = vec3(0.0);
    float dPhi = 2.0 * PI / float(max(size.x, 1));
    float dTheta = PI / float(max(size.y, 1));

    for (int y = 0; y < size.y; ++y) {
        float theta = (float(y) + 0.5) * dTheta;
        float solidAngle = dPhi * dTheta * sin(theta);
        for (int x = 0; x < size.x; ++x) {
            vec2 uv = (vec2(x, y) + vec2(0.5)) / vec2(size);
            vec3 direction = latLongDirection(uv);
            vec3 radiance = max(textureLod(u_SkyRadiance, uv, 0.0).rgb, vec3(0.0));
            integral += radiance * basisValue(coefficientIndex, direction) * solidAngle;
        }
    }

    u_Sh.coefficients[coefficientIndex] = vec4(
        integral * lambertBandFactor(coefficientIndex), 0.0
    );
}
