{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Combatant player model collection, format 1",
  "type": "object",
  "required": [
    "format",
    "entries"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "id",
          "model",
          "atlas",
          "texture"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "atlas": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "texture": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
