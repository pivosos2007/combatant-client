#version 430 core

/* Neutral renderer-owned sky fallback: defined HDR radiance, zero incoming energy. */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0, rgba16f) writeonly uniform image2D u_SkyRadiance;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_SkyRadiance);
    if (any(greaterThanEqual(pixel, size))) return;
    imageStore(u_SkyRadiance, pixel, vec4(0.0, 0.0, 0.0, 1.0));
}
