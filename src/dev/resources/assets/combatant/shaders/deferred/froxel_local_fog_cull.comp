#version 430 core

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

#moj_import <combatant:deferred_froxel_media_data.glsl>
#moj_import <combatant:deferred_froxel_transport.glsl>

#define COMBATANT_LOCAL_FOG_VOLUME_BINDING 1
#define COMBATANT_LOCAL_FOG_BIN_COUNT_BINDING 2
#define COMBATANT_LOCAL_FOG_BIN_INDEX_BINDING 3
#define COMBATANT_LOCAL_FOG_BIN_WRITE
#moj_import <combatant:deferred_local_fog_volume_contract.glsl>

vec3 worldRay(vec2 uv) {
    float ndcZ = u_Data.policy.y > 0.5 ? 0.5 : 0.0;
    vec4 view = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    vec3 viewDirection = normalize(view.xyz / max(abs(view.w), 1e-7) * sign(view.w));
    return normalize(mat3(u_Data.inverseView) * viewDirection);
}

void binBoundingSphere(uvec3 bin, out vec3 center, out float radius) {
    ivec3 froxelDimensions = ivec3(max(u_Data.froxel.xyz, vec3(1.0)));
    ivec3 binSize = ivec3(
        max(int(u_Data.localFogBinning.x + 0.5), 1),
        max(int(u_Data.localFogBinning.x + 0.5), 1),
        max(int(u_Data.localFogBinning.y + 0.5), 1)
    );
    ivec3 minimumCoord = ivec3(bin) * binSize;
    ivec3 maximumCoord = min(minimumCoord + binSize, froxelDimensions);

    float nearDistance = combatant_froxel_boundary_distance(
        minimumCoord.z, froxelDimensions.z, u_Data.froxel.w, u_Data.policy.x);
    float farDistance = combatant_froxel_boundary_distance(
        maximumCoord.z, froxelDimensions.z, u_Data.froxel.w, u_Data.policy.x);

    vec2 uv0 = vec2(minimumCoord.xy) / vec2(froxelDimensions.xy);
    vec2 uv1 = vec2(maximumCoord.xy) / vec2(froxelDimensions.xy);
    vec3 points[8];
    points[0] = worldRay(vec2(uv0.x, uv0.y)) * nearDistance;
    points[1] = worldRay(vec2(uv1.x, uv0.y)) * nearDistance;
    points[2] = worldRay(vec2(uv0.x, uv1.y)) * nearDistance;
    points[3] = worldRay(vec2(uv1.x, uv1.y)) * nearDistance;
    points[4] = worldRay(vec2(uv0.x, uv0.y)) * farDistance;
    points[5] = worldRay(vec2(uv1.x, uv0.y)) * farDistance;
    points[6] = worldRay(vec2(uv0.x, uv1.y)) * farDistance;
    points[7] = worldRay(vec2(uv1.x, uv1.y)) * farDistance;

    center = vec3(0.0);
    for (int i = 0; i < 8; ++i) center += points[i];
    center *= 0.125;
    radius = 0.0;
    for (int i = 0; i < 8; ++i) radius = max(radius, length(points[i] - center));
}

bool overlapsBin(LocalFogVolume volume, vec3 center, float radius) {
    vec3 delta = center - volume.centerShape.xyz;
    if (volume.centerShape.w < 0.5) {
        return length(delta) <= radius + max(volume.extentDensity.x, 0.0);
    }
    vec3 extent = max(volume.extentDensity.xyz, vec3(0.0));
    vec3 q = max(abs(delta) - extent, vec3(0.0));
    return dot(q, q) <= radius * radius;
}

void main() {
    uvec3 bin = gl_GlobalInvocationID.xyz;
    ivec3 froxelDimensions = ivec3(max(u_Data.froxel.xyz, vec3(1.0)));
    ivec3 binSize = ivec3(
        max(int(u_Data.localFogBinning.x + 0.5), 1),
        max(int(u_Data.localFogBinning.x + 0.5), 1),
        max(int(u_Data.localFogBinning.y + 0.5), 1)
    );
    uvec3 binCount = uvec3((froxelDimensions + binSize - ivec3(1)) / binSize);
    if (any(greaterThanEqual(bin, binCount))) return;

    uint linearBin = (bin.z * binCount.y + bin.y) * binCount.x + bin.x;
    uint maxPerBin = uint(max(int(u_Data.localFogBinning.z + 0.5), 1));
    uint volumeCount = uint(clamp(int(u_Data.counts.z + 0.5), 0, u_LocalFogVolumes.volumes.length()));
    uint base = linearBin * maxPerBin;

    vec3 center;
    float radius;
    binBoundingSphere(bin, center, radius);

    uint count = 0u;
    for (uint volumeIndex = 0u; volumeIndex < volumeCount; ++volumeIndex) {
        if (!overlapsBin(u_LocalFogVolumes.volumes[volumeIndex], center, radius)) continue;
        if (count >= maxPerBin) break;
        u_LocalFogBinIndices.indices[base + count] = volumeIndex;
        count++;
    }
    u_LocalFogBinCounts.counts[linearBin] = count;
}
