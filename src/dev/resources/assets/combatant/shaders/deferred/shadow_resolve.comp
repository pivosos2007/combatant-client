layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_ResolvedDepth;
layout(binding = 1) uniform sampler2D u_ShadowDepth;
layout(binding = 2) uniform sampler2D u_GbufferGeometry;
layout(binding = 3) uniform sampler2D u_GbufferDepth;
layout(binding = 4, r8) writeonly uniform image2D u_ShadowVisibility;
layout(binding = 7, r8) writeonly uniform image2D u_ShadowHardVisibility;
layout(binding = 8, r8) writeonly uniform image2D u_ShadowCascadeIndex;
layout(binding = 9, r32f) writeonly uniform image2D u_ShadowColor;

struct ShadowCascade {
    mat4 viewProjection;
    vec4 atlasScaleBias;
    vec4 splitRange;
    // xy: atlas texel size, z: cascade world units per shadow texel,
    // w: normalized shadow-depth change per one world-space shadow texel.
    vec4 shadowTexel;
};

layout(std430, binding = 5) readonly buffer ShadowCascadeData {
    ShadowCascade cascades[];
} u_Shadow;

layout(std430, binding = 6) readonly buffer ShadowResolveCamera {
    mat4 inverseProjection;
    mat4 projection;
    mat4 inverseView;
    vec4 depthTransform;
    vec4 viewportAndFar;
    // x: legacy cascade blend (unused by the production single-map path),
    // y: normal offset (texels), z: receiver-plane bias (texels), w: PCF radius (texels).
    vec4 shadowParams0;
    // xyz reserved for PCSS bring-up, w enables the terminal near->distant handoff.
    vec4 shadowParams1;
    // xyz: receiver-to-light world direction, w: valid.
    vec4 directionalLight;
    // x: receiver slope-bias scale, y: max total receiver bias,
    // z: minimum N.L, w: maximum adaptive PCF radius.
    vec4 shadowBiasParams;
    // x/y: lightmap fallback range when SSRT is disabled, z: dimension has skylight,
    // w: low-skylight leak-prevention upper bound used by distant SSRT only.
    vec4 shadowFallbackParams;
    // xyz: receiver-to-light direction in view space, w: valid.
    vec4 ssrtLightDirection;
    // xyz: absolute camera position, w: distant SSRT enabled.
    vec4 cameraWorldAndSsrt;
    // x: SSRT steps, y: geometric step ratio, z: view-depth thickness, w: reserved.
    vec4 shadowSsrtParams;
} u_Camera;

const vec2 POISSON[16] = vec2[](
    vec2(-0.94201624, -0.39906216), vec2(0.94558609, -0.76890725),
    vec2(-0.09418410, -0.92938870), vec2(0.34495938, 0.29387760),
    vec2(-0.91588581, 0.45771432), vec2(-0.81544232, -0.87912464),
    vec2(-0.38277543, 0.27676845), vec2(0.97484398, 0.75648379),
    vec2(0.44323325, -0.97511554), vec2(0.53742981, -0.47373420),
    vec2(-0.26496911, -0.41893023), vec2(0.79197514, 0.19090188),
    vec2(-0.24188840, 0.99706507), vec2(-0.81409955, 0.91437590),
    vec2(0.19984126, 0.78641367), vec2(0.14383161, -0.14100790)
);

struct ShadowProjection {
    vec2 localUv;
    vec2 atlasUv;
    float depth;
    float distortionFactor;
    bool valid;
};

const float COMBATANT_SHADOW_DISTORTION = 0.85;

float shadowQuarticLength(vec2 value) {
    vec2 squared = value * value;
    vec2 fourth = squared * squared;
    return sqrt(sqrt(fourth.x + fourth.y));
}

float shadowDistortionFactor(vec2 shadowNdc) {
    return shadowQuarticLength(shadowNdc) * COMBATANT_SHADOW_DISTORTION
            + (1.0 - COMBATANT_SHADOW_DISTORTION);
}

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}


float decodeMinecraftLightLevel(float encodedUv) {
    // Terrain light coordinates are Minecraft's 0..240 light values encoded with the standard
    // half-texel offset before normalization. Decode only the scalar level; no vanilla lightmap
    // color or presentation state is sampled here.
    return clamp((encodedUv * 256.0 - 8.0) / 240.0, 0.0, 1.0);
}

float distantDirectionalVisibility(float skyLevel) {
    // Outside reliable geometric shadow coverage, fully-lit is unsafe underground: a long tunnel
    // can expose a receiver that has no shadow-map caster even though Minecraft skylight already
    // tells us it is not directly sky-exposed. Use that existing semantic as a conservative proxy.
    if (u_Camera.shadowFallbackParams.z <= 0.5) return 1.0;

    float lower = clamp(u_Camera.shadowFallbackParams.x, 0.0, 1.0);
    float upper = max(lower + 1.0e-4, clamp(u_Camera.shadowFallbackParams.y, 0.0, 1.0));
    return smoothstep(lower, upper, skyLevel);
}

float lowSkylightLeakPrevention(float skyLevel) {
    // Distant SSRT safety only. Do not apply this to a valid near shadow-map sample.
    if (u_Camera.shadowFallbackParams.z <= 0.5) return 1.0;
    float upper = clamp(u_Camera.shadowFallbackParams.w, 0.0, 0.5);
    if (upper <= 1.0e-5) return 1.0;
    return smoothstep(0.0, upper, skyLevel);
}

vec3 reconstructCameraRelativeWorld(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Camera.depthTransform.x + u_Camera.depthTransform.y;
    vec4 viewH = u_Camera.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    if (abs(viewH.w) < 1e-7) return vec3(0.0);
    vec3 viewPosition = viewH.xyz / viewH.w;
    return (u_Camera.inverseView * vec4(viewPosition, 0.0)).xyz;
}

float viewDistance(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Camera.depthTransform.x + u_Camera.depthTransform.y;
    vec4 viewH = u_Camera.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    if (abs(viewH.w) < 1e-7) return u_Camera.viewportAndFar.z;
    return max(0.0, -(viewH.z / viewH.w));
}

vec3 reconstructViewPosition(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Camera.depthTransform.x + u_Camera.depthTransform.y;
    vec4 viewH = u_Camera.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    if (abs(viewH.w) < 1e-7) return vec3(0.0);
    return viewH.xyz / viewH.w;
}

vec3 viewToScreen(vec3 viewPosition) {
    vec4 clip = u_Camera.projection * vec4(viewPosition, 1.0);
    if (abs(clip.w) < 1e-7) return vec3(-2.0);
    vec3 ndc = clip.xyz / clip.w;
    return vec3(ndc.xy * 0.5 + 0.5,
                ndc.z * u_Camera.depthTransform.z + u_Camera.depthTransform.w);
}

float stableWorldDither(vec3 worldRelative) {
    vec3 absoluteWorld = worldRelative + u_Camera.cameraWorldAndSsrt.xyz;
    vec3 cell = floor(absoluteWorld * 8.0);
    return fract(sin(dot(cell, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
}

float distantScreenSpaceVisibility(vec2 uv, float depth, vec3 worldRelative, float skyLevel) {
    // If SSRT is disabled, use a conservative lightmap/skylight proxy.
    if (u_Camera.cameraWorldAndSsrt.w <= 0.5 || u_Camera.ssrtLightDirection.w <= 0.5) {
        return distantDirectionalVisibility(skyLevel);
    }

    vec3 rayOriginView = reconstructViewPosition(uv, depth);
    vec3 rayDirectionView = normalize(u_Camera.ssrtLightDirection.xyz);
    vec3 originScreen = vec3(uv, depth);
    vec3 nextScreen = viewToScreen(rayOriginView + rayDirectionView);
    if (any(lessThan(nextScreen, vec3(-1.0)))) return distantDirectionalVisibility(skyLevel);

    vec3 screenDelta = nextScreen - originScreen;
    float directionLength = length(screenDelta);
    if (directionLength <= 1e-7) return distantDirectionalVisibility(skyLevel);
    vec3 rayDirectionScreen = screenDelta / directionLength;

    // Stop at the screen/depth boundary and shrink the usable ray with receiver distance.
    vec3 boundaryDistance = abs(sign(rayDirectionScreen) - originScreen)
            / max(abs(rayDirectionScreen), vec3(1e-6));
    float rayLength = min(boundaryDistance.x, min(boundaryDistance.y, boundaryDistance.z));
    rayLength = min(rayLength,
            max(0.1, exp(-max(length(rayOriginView) * 0.025 - 1.0, 0.0))));
    if (rayLength <= 1e-6) return lowSkylightLeakPrevention(skyLevel);

    int stepCount = clamp(int(u_Camera.shadowSsrtParams.x + 0.5), 1, 24);
    float stepRatio = max(u_Camera.shadowSsrtParams.y, 1.0);
    float thickness = max(u_Camera.shadowSsrtParams.z, 1e-4);
    float ratioPower = pow(stepRatio, float(stepCount));
    float initialStepScale = abs(stepRatio - 1.0) < 1e-5
            ? (1.0 / float(stepCount))
            : ((stepRatio - 1.0) / max(ratioPower - 1.0, 1e-5));
    float stepLength = rayLength * initialStepScale;

    vec2 pixelSize = 1.0 / max(u_Camera.viewportAndFar.xy, vec2(1.0));
    vec3 rayPosition = originScreen + length(pixelSize) * rayDirectionScreen;
    float dither = stableWorldDither(worldRelative);

    bool hit = false;
    for (int i = 0; i < 24; ++i) {
        if (i >= stepCount) break;
        stepLength *= stepRatio;
        vec3 rayStep = rayDirectionScreen * stepLength;
        vec3 samplePosition = rayPosition + dither * rayStep;
        rayPosition += rayStep;

        if (any(lessThan(samplePosition, vec3(0.0)))
                || any(greaterThan(samplePosition, vec3(1.0)))) {
            break;
        }

        float sampleDepth = textureLod(u_ResolvedDepth, samplePosition.xy, 0.0).r;
        if (sampleDepth <= 0.0) continue;

        vec3 rayView = reconstructViewPosition(samplePosition.xy, samplePosition.z);
        vec3 sampleView = reconstructViewPosition(samplePosition.xy, sampleDepth);
        float rayViewDepth = -rayView.z;
        float sampleViewDepth = -sampleView.z;
        float depthDelta = rayViewDepth - sampleViewDepth;

        // sampled geometry must lie in front of the ray and within a
        // finite view-depth thickness.
        bool inside = rayViewDepth > 0.0 && sampleViewDepth > 0.0
                && depthDelta > 0.0
                && abs(thickness - depthDelta) < thickness;
        if (inside) {
            hit = true;
            break;
        }
    }

    return (hit ? 0.0 : 1.0) * lowSkylightLeakPrevention(skyLevel);
}

ShadowProjection projectShadow(ShadowCascade cascade, vec3 worldRelative) {
    ShadowProjection result;
    vec4 clip = cascade.viewProjection * vec4(worldRelative, 1.0);
    result.valid = abs(clip.w) >= 1e-7;
    result.localUv = vec2(0.0);
    result.atlasUv = vec2(0.0);
    result.depth = 0.0;
    result.distortionFactor = 1.0;
    if (!result.valid) return result;

    vec3 ndc = clip.xyz / clip.w;
    result.distortionFactor = max(shadowDistortionFactor(ndc.xy), 1.0e-4);
    ndc.xy /= result.distortionFactor;
    result.localUv = ndc.xy * 0.5 + 0.5;
    result.valid = all(greaterThanEqual(result.localUv, vec2(0.0)))
            && all(lessThanEqual(result.localUv, vec2(1.0)));
    result.atlasUv = result.localUv * cascade.atlasScaleBias.xy + cascade.atlasScaleBias.zw;
    result.depth = ndc.z * u_Camera.depthTransform.z + u_Camera.depthTransform.w;
    return result;
}



float pow32Fast(float value) {
    value *= value;
    value *= value;
    value *= value;
    value *= value;
    value *= value;
    return value;
}

float singleMapDistanceFade(ShadowCascade cascade, vec3 worldRelative) {
    ShadowProjection projected = projectShadow(cascade, worldRelative);
    float edgeMetric = 1.0;
    if (projected.valid) {
        edgeMetric = max(abs(projected.localUv.x * 2.0 - 1.0),
                         abs(projected.localUv.y * 2.0 - 1.0));
    }
    float shadowDistance = max(cascade.splitRange.y, 1.0e-4);
    float distanceMetric = dot(worldRelative, worldRelative) / (shadowDistance * shadowDistance);
    float metric = clamp(max(edgeMetric, distanceMetric), 0.0, 1.0);
    return clamp((pow32Fast(metric) - 0.10) / 0.90, 0.0, 1.0);
}

float shadowScreenFootprintTexels(ShadowCascade cascade, vec2 uv, float depth, vec3 worldRelative) {
    ShadowProjection center = projectShadow(cascade, worldRelative);
    if (!center.valid) return 1.0;

    vec2 viewport = max(u_Camera.viewportAndFar.xy, vec2(1.0));
    vec2 pixelUv = 1.0 / viewport;
    vec2 uvX = min(uv + vec2(pixelUv.x, 0.0), vec2(1.0) - pixelUv * 0.5);
    vec2 uvY = min(uv + vec2(0.0, pixelUv.y), vec2(1.0) - pixelUv * 0.5);
    vec3 worldX = reconstructCameraRelativeWorld(uvX, depth);
    vec3 worldY = reconstructCameraRelativeWorld(uvY, depth);
    ShadowProjection projectedX = projectShadow(cascade, worldX);
    ShadowProjection projectedY = projectShadow(cascade, worldY);
    if (!projectedX.valid || !projectedY.valid) return 1.0;

    vec2 atlasTexel = max(cascade.shadowTexel.xy, vec2(1e-7));
    float footprintX = length((projectedX.atlasUv - center.atlasUv) / atlasTexel);
    float footprintY = length((projectedY.atlasUv - center.atlasUv) / atlasTexel);
    return max(1.0, max(footprintX, footprintY));
}

vec2 clampAtlasUv(ShadowCascade cascade, vec2 atlasUv) {
    vec2 halfTexel = cascade.shadowTexel.xy * 0.5;
    vec2 minimum = cascade.atlasScaleBias.zw + halfTexel;
    vec2 maximum = cascade.atlasScaleBias.zw + cascade.atlasScaleBias.xy - halfTexel;
    return clamp(atlasUv, minimum, maximum);
}

bool blockerAt(float storedDepth, float receiverDepth, float bias) {
    // Reversed-Z: a larger stored depth is a caster closer to the directional light.
    return storedDepth > 0.0 && storedDepth > receiverDepth + bias;
}

float compareShadowVisibility(float storedDepth, float receiverDepth, float bias) {
    return blockerAt(storedDepth, receiverDepth, bias) ? 0.0 : 1.0;
}

float bilinearShadowVisibility(ShadowCascade cascade, vec2 atlasUv, float receiverDepth, float bias) {
    ivec2 textureExtent = textureSize(u_ShadowDepth, 0);
    vec2 extent = vec2(textureExtent);
    vec2 minimumUv = cascade.atlasScaleBias.zw + cascade.shadowTexel.xy * 0.5;
    vec2 maximumUv = cascade.atlasScaleBias.zw + cascade.atlasScaleBias.xy
            - cascade.shadowTexel.xy * 0.5;
    vec2 uv = clamp(atlasUv, minimumUv, maximumUv);

    vec2 texelPosition = uv * extent - vec2(0.5);
    ivec2 base = ivec2(floor(texelPosition));
    vec2 fractionValue = fract(texelPosition);

    ivec2 tileMinimum = ivec2(floor(cascade.atlasScaleBias.zw * extent));
    ivec2 tileMaximum = ivec2(ceil((cascade.atlasScaleBias.zw + cascade.atlasScaleBias.xy) * extent)) - ivec2(1);
    tileMinimum = clamp(tileMinimum, ivec2(0), textureExtent - ivec2(1));
    tileMaximum = clamp(tileMaximum, tileMinimum, textureExtent - ivec2(1));

    ivec2 p00 = clamp(base, tileMinimum, tileMaximum);
    ivec2 p10 = clamp(base + ivec2(1, 0), tileMinimum, tileMaximum);
    ivec2 p01 = clamp(base + ivec2(0, 1), tileMinimum, tileMaximum);
    ivec2 p11 = clamp(base + ivec2(1, 1), tileMinimum, tileMaximum);

    float v00 = compareShadowVisibility(texelFetch(u_ShadowDepth, p00, 0).r, receiverDepth, bias);
    float v10 = compareShadowVisibility(texelFetch(u_ShadowDepth, p10, 0).r, receiverDepth, bias);
    float v01 = compareShadowVisibility(texelFetch(u_ShadowDepth, p01, 0).r, receiverDepth, bias);
    float v11 = compareShadowVisibility(texelFetch(u_ShadowDepth, p11, 0).r, receiverDepth, bias);
    float top = mix(v00, v10, fractionValue.x);
    float bottom = mix(v01, v11, fractionValue.x);
    return mix(top, bottom, fractionValue.y);
}

vec2 rotateOffset(vec2 value, float angle) {
    float c = cos(angle);
    float sn = sin(angle);
    return vec2(c * value.x - sn * value.y, sn * value.x + c * value.y);
}

float filteredCascadeVisibility(ShadowCascade cascade,
                                vec3 worldRelative,
                                vec3 normalWorld,
                                float screenFootprintTexels,
                                float rotation,
                                out float hardVisibility,
                                out bool valid) {
    ShadowProjection baseProjection = projectShadow(cascade, worldRelative);
    float localDistortion = baseProjection.valid
            ? clamp(baseProjection.distortionFactor, 1.0 - COMBATANT_SHADOW_DISTORTION, 1.0)
            : 1.0;
    float worldTexel = max(cascade.shadowTexel.z * localDistortion, 1e-6);
    vec3 receiver = worldRelative + normalWorld * worldTexel * u_Camera.shadowParams0.y;
    ShadowProjection projected = projectShadow(cascade, receiver);
    valid = projected.valid;
    hardVisibility = 1.0;
    if (!valid) return 1.0;

    // Receiver bias is expressed in shadow texels. A constant bias alone creates severe
    // quantized self-shadow stripes when the celestial light is grazing a surface. Add a bounded
    // slope term from N.L while keeping the total bias small enough to avoid visible detachment.
    float baseBiasTexels = max(u_Camera.shadowParams0.z, 0.0);
    float biasTexels = baseBiasTexels;
    if (u_Camera.directionalLight.w > 0.5 && u_Camera.shadowBiasParams.x > 0.0) {
        vec3 lightDirection = normalize(u_Camera.directionalLight.xyz);
        float ndotl = clamp(dot(normalWorld, lightDirection), 0.0, 1.0);
        float minNdotL = clamp(u_Camera.shadowBiasParams.z, 0.05, 1.0);
        float sine = sqrt(max(0.0, 1.0 - ndotl * ndotl));
        float slope = sine / max(ndotl, minNdotL);
        biasTexels += u_Camera.shadowBiasParams.x * slope;
    }
    float maxBiasTexels = max(baseBiasTexels, u_Camera.shadowBiasParams.y);
    biasTexels = min(biasTexels, maxBiasTexels);
    float bias = max(cascade.shadowTexel.w * localDistortion, 0.0) * biasTexels;

    float centerDepth = textureLod(u_ShadowDepth, projected.atlasUv, 0.0).r;
    hardVisibility = blockerAt(centerDepth, projected.depth, bias) ? 0.0 : 1.0;
    
    // Sixteen fixed Poisson taps give a genuinely soft PCF edge without frame-to-frame noise.
    float baseFilterRadius = max(u_Camera.shadowParams0.w, 0.0);
    float maxAdaptiveRadius = max(u_Camera.shadowBiasParams.w, baseFilterRadius);
    float adaptiveRadius = 0.75 * max(screenFootprintTexels - 1.0, 0.0);
    float filterRadius = min(max(baseFilterRadius, adaptiveRadius), maxAdaptiveRadius);
    if (filterRadius <= 1e-4) return hardVisibility;

    float visible = 0.0;
    for (int i = 0; i < 16; ++i) {
        vec2 offset = rotateOffset(POISSON[i], rotation)
                * cascade.shadowTexel.xy * filterRadius;
        vec2 sampleUv = clampAtlasUv(cascade, projected.atlasUv + offset);
        visible += bilinearShadowVisibility(cascade, sampleUv, projected.depth, bias);
    }
    return visible * (1.0 / 16.0);
}

void storeVisibility(ivec2 pixel, float filtered, float hard, float cascadeIndexEncoded) {
    float clamped = clamp(filtered, 0.0, 1.0);
    imageStore(u_ShadowVisibility, pixel, vec4(clamped));
    imageStore(u_ShadowColor, pixel, vec4(clamped));
    imageStore(u_ShadowHardVisibility, pixel, vec4(clamp(hard, 0.0, 1.0)));
    imageStore(u_ShadowCascadeIndex, pixel, vec4(clamp(cascadeIndexEncoded, 0.0, 1.0)));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_ShadowVisibility);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    float depth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    float gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    float depthTolerance = max(1.0e-6, abs(gbufferDepth) * 1.0e-5);
    if (depth <= 0.0 || gbufferDepth <= 0.0 || abs(depth - gbufferDepth) > depthTolerance) {
        storeVisibility(pixel, 1.0, 1.0, 0.0);
        return;
    }

    vec3 worldRelative = reconstructCameraRelativeWorld(uv, depth);
    float skyLevel = decodeMinecraftLightLevel(textureLod(u_GbufferGeometry, uv, 0.0).a);
    int shadowMapCount = max(0, int(u_Shadow.cascades[0].splitRange.w + 0.5));

    // No local shadow-map coverage: use the distant continuation directly.
    if (shadowMapCount <= 0) {
        float distantVisibility = distantScreenSpaceVisibility(uv, depth, worldRelative, skyLevel);
        storeVisibility(pixel, distantVisibility, 1.0, 0.0);
        return;
    }

    ShadowCascade shadowMap = u_Shadow.cascades[0];
    float distanceValue = viewDistance(uv, depth);
    bool receiverInRange = distanceValue >= shadowMap.splitRange.x
            && distanceValue <= shadowMap.splitRange.y;
    if (!receiverInRange) {
        float distantVisibility = distantScreenSpaceVisibility(uv, depth, worldRelative, skyLevel);
        storeVisibility(pixel, distantVisibility, 1.0, 0.0);
        return;
    }

    vec3 normalView = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    vec3 normalWorld = normalize(mat3(u_Camera.inverseView) * normalView);

    bool mapValid = false;
    float hardVisibility = 1.0;
    float footprint = shadowScreenFootprintTexels(shadowMap, uv, depth, worldRelative);
    float visibility = filteredCascadeVisibility(
            shadowMap, worldRelative, normalWorld, footprint, 0.0,
            hardVisibility, mapValid);

    if (!mapValid) {
        float distantVisibility = distantScreenSpaceVisibility(uv, depth, worldRelative, skyLevel);
        storeVisibility(pixel, distantVisibility, 1.0, 0.0);
        return;
    }
    
    float finalVisibility = visibility;

    // Near the finite distorted-map boundary, hand off to the distant screen-space trace.
    if (u_Camera.shadowParams1.w > 0.0) {
        float distanceFade = singleMapDistanceFade(shadowMap, worldRelative);
        if (distanceFade > 1e-4) {
            float distantVisibility = distantScreenSpaceVisibility(uv, depth, worldRelative, skyLevel);
            finalVisibility = mix(finalVisibility, distantVisibility, distanceFade);
        }
    }

    storeVisibility(pixel, finalVisibility, hardVisibility, 0.5);
}
