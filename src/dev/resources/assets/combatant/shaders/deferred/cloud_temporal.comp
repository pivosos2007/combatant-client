#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_CurrentRadiance;
layout(binding = 1) uniform sampler2D u_CurrentDepth;
layout(binding = 2) uniform sampler2D u_CurrentReprojectionData;
layout(binding = 3) uniform sampler2D u_HistoryRadiance;
layout(binding = 4) uniform sampler2D u_HistoryDepth;
layout(binding = 5) uniform sampler2D u_HistoryConfidence;
layout(binding = 6, rgba16f) writeonly uniform image2D u_OutputRadiance;
layout(binding = 7, r32f) writeonly uniform image2D u_OutputDepth;
layout(binding = 8, r8) writeonly uniform image2D u_OutputConfidence;

layout(std430, binding = 9) readonly buffer CloudTemporalData {
    mat4 currentInverseProjection;
    mat4 currentInverseView;
    mat4 previousView;
    mat4 previousProjection;
    vec4 cameraDelta;
    vec4 timing;
    vec4 policy;
    vec4 thresholds;
} u_Data;

vec3 worldRay(vec2 uv) {
    float ndcZ = u_Data.policy.x > 0.5 ? 0.5 : 0.0;
    vec4 view = u_Data.currentInverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    vec3 viewDirection = normalize(view.xyz / max(abs(view.w), 1e-7) * sign(view.w));
    return normalize((u_Data.currentInverseView * vec4(viewDirection, 0.0)).xyz);
}

vec4 neighborhoodClamp(vec2 uv, vec4 historyValue) {
    ivec2 size = textureSize(u_CurrentRadiance, 0);
    vec2 texel = 1.0 / vec2(size);
    vec4 lo = vec4(1e20);
    vec4 hi = vec4(-1e20);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec4 sampleValue = textureLod(u_CurrentRadiance, clamp(uv + vec2(x, y) * texel, vec2(0.0), vec2(1.0)), 0.0);
            lo = min(lo, sampleValue);
            hi = max(hi, sampleValue);
        }
    }
    vec4 extent = max(hi - lo, vec4(1e-4));
    float expansion = max(u_Data.thresholds.w, 0.0);
    return clamp(historyValue, lo - extent * expansion, hi + extent * expansion);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_OutputRadiance);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 current = textureLod(u_CurrentRadiance, uv, 0.0);
    float currentDepth = textureLod(u_CurrentDepth, uv, 0.0).r;
    vec4 flowData = textureLod(u_CurrentReprojectionData, uv, 0.0);
    float reprojectionDepth = flowData.z;
    float confidence = currentDepth >= 0.0 ? u_Data.thresholds.y : 0.0;

    if (currentDepth >= 0.0 && reprojectionDepth >= 0.0 && u_Data.policy.y > 0.5) {
        vec3 currentWorldRelative = worldRay(uv) * reprojectionDepth;
        vec2 flow = flowData.xy;
        vec3 featureMotion = vec3(flow.x, 0.0, flow.y) * u_Data.timing.x;
        vec3 previousWorldRelative = currentWorldRelative + u_Data.cameraDelta.xyz - featureMotion;
        vec4 previousClip = u_Data.previousProjection * u_Data.previousView * vec4(previousWorldRelative, 1.0);
        if (abs(previousClip.w) >= 1e-7) {
            vec2 previousUv = (previousClip.xy / previousClip.w) * 0.5 + 0.5;
            bool inside = all(greaterThan(previousUv, vec2(0.001)))
                    && all(lessThan(previousUv, vec2(0.999)));
            if (inside) {
                float historyDepth = textureLod(u_HistoryDepth, previousUv, 0.0).r;
                float expectedHistoryDepth = length(previousWorldRelative);
                float depthThreshold = max(u_Data.thresholds.x, expectedHistoryDepth * u_Data.policy.w);
                if (historyDepth >= 0.0 && abs(historyDepth - expectedHistoryDepth) <= depthThreshold) {
                    vec4 history = neighborhoodClamp(uv, textureLod(u_HistoryRadiance, previousUv, 0.0));
                    float historyConfidence = clamp(textureLod(u_HistoryConfidence, previousUv, 0.0).r, 0.0, 1.0);
                    float historyWeight = clamp(u_Data.policy.z * historyConfidence, 0.0, 0.98);
                    current = mix(current, history, historyWeight);
                    confidence = min(1.0, max(u_Data.thresholds.y,
                            historyConfidence + u_Data.thresholds.z));
                }
            }
        }
    }

    imageStore(u_OutputRadiance, pixel, current);
    imageStore(u_OutputDepth, pixel, vec4(currentDepth, 0.0, 0.0, 0.0));
    imageStore(u_OutputConfidence, pixel, vec4(confidence, 0.0, 0.0, 0.0));
}
