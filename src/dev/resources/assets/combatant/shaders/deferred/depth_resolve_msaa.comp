layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2DMS u_Depth;
layout(binding = 1, r32f) writeonly uniform image2D u_ResolvedDepth;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_ResolvedDepth);
    if (any(greaterThanEqual(pixel, size))) return;

    // Minecraft's world depth is reversed-Z: the nearest covered sample has the largest value.
    int sampleCount = textureSamples(u_Depth);
    float depth = 0.0;
    for (int sampleIndex = 0; sampleIndex < sampleCount; ++sampleIndex) {
        depth = max(depth, texelFetch(u_Depth, pixel, sampleIndex).r);
    }
    imageStore(u_ResolvedDepth, pixel, vec4(depth, 0.0, 0.0, 0.0));
}
