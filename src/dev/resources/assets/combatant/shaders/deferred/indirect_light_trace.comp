layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_SceneRadiance;
layout(binding = 1) uniform sampler2D u_ResolvedDepth;
layout(binding = 2) uniform sampler2D u_DepthPyramid;
layout(binding = 3) uniform sampler2D u_GbufferGeometry;
layout(binding = 4, rgba16f) writeonly uniform image2D u_IndirectLight;
layout(binding = 5, r8) writeonly uniform image2D u_IndirectConfidence;

layout(std430, binding = 6) readonly buffer IndirectLightData {
    mat4 inverseProjection;
    mat4 projection;
    // xy: depth -> NDC, zw: NDC -> depth.
    vec4 depthTransform;
    // x: sample count, y: view-space radius, z: hemisphere bias, w: Hi-Z mip bias.
    vec4 params0;
    // x: max Hi-Z mip, yz: full-resolution extent.
    vec4 params1;
} u_Indirect;

const float GOLDEN_ANGLE = 2.39996322972865332;

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

vec3 reconstructView(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Indirect.depthTransform.x + u_Indirect.depthTransform.y;
    vec4 h = u_Indirect.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    if (abs(h.w) < 1e-7) return vec3(0.0);
    return h.xyz / h.w;
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

void storeEmpty(ivec2 pixel) {
    imageStore(u_IndirectLight, pixel, vec4(0.0));
    imageStore(u_IndirectConfidence, pixel, vec4(0.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(u_IndirectLight);
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(outputSize);
    float centerDepth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    if (centerDepth <= 0.0) {
        storeEmpty(pixel);
        return;
    }

    vec3 center = reconstructView(uv, centerDepth);
    vec3 centerNormal = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    int sampleCount = clamp(int(u_Indirect.params0.x + 0.5), 1, 64);
    float radius = u_Indirect.params0.y;
    float bias = u_Indirect.params0.z;
    float mipBias = u_Indirect.params0.w;
    int availableMips = textureQueryLevels(u_DepthPyramid);
    int maxMip = min(max(0, int(u_Indirect.params1.x + 0.5)), max(0, availableMips - 1));

    float projectedRadiusY = abs(u_Indirect.projection[1][1]) * radius / max(0.05, -center.z) * 0.5;
    vec2 aspect = vec2(u_Indirect.params1.z / max(1.0, u_Indirect.params1.y), 1.0);
    float rotation = hash12(vec2(pixel)) * 6.28318530718;
    vec3 radianceSum = vec3(0.0);
    float weightSum = 0.0;
    float accepted = 0.0;

    for (int i = 0; i < 64; ++i) {
        if (i >= sampleCount) break;
        float fraction = (float(i) + 0.5) / float(sampleCount);
        float angle = rotation + float(i) * GOLDEN_ANGLE;
        float radial = sqrt(fraction);
        vec2 direction = vec2(cos(angle), sin(angle));
        vec2 sampleUv = uv + direction * projectedRadiusY * radial * aspect;
        if (any(lessThanEqual(sampleUv, vec2(0.0))) || any(greaterThanEqual(sampleUv, vec2(1.0)))) continue;

        float radiusPixels = projectedRadiusY * radial * u_Indirect.params1.z;
        float mip = clamp(floor(log2(max(1.0, radiusPixels))) + mipBias, 0.0, float(maxMip));
        float coarseDepth = textureLod(u_DepthPyramid, sampleUv, mip).r;
        if (coarseDepth <= 0.0) continue;

        float sampleDepth = textureLod(u_ResolvedDepth, sampleUv, 0.0).r;
        if (sampleDepth <= 0.0) continue;
        vec3 samplePosition = reconstructView(sampleUv, sampleDepth);
        vec3 delta = samplePosition - center;
        float distanceValue = length(delta);
        if (distanceValue <= 1e-4 || distanceValue > radius) continue;

        vec3 ray = delta / distanceValue;
        float receiverCosine = max(0.0, dot(centerNormal, ray) - bias);
        if (receiverCosine <= 0.0) continue;
        vec3 sampleNormal = decodeOctahedral(textureLod(u_GbufferGeometry, sampleUv, 0.0).rg);
        float emitterCosine = max(0.0, dot(sampleNormal, -ray));
        if (emitterCosine <= 0.0) continue;

        float rangeWeight = 1.0 - distanceValue / radius;
        float weight = receiverCosine * emitterCosine * rangeWeight * rangeWeight;
        vec3 sampleRadiance = textureLod(u_SceneRadiance, sampleUv, 0.0).rgb;
        radianceSum += sampleRadiance * weight;
        weightSum += weight;
        accepted += 1.0;
    }

    if (weightSum <= 1e-6) {
        storeEmpty(pixel);
        return;
    }

    vec3 indirect = radianceSum / weightSum;
    float confidence = clamp(accepted / float(sampleCount), 0.0, 1.0);
    imageStore(u_IndirectLight, pixel, vec4(indirect, 1.0));
    imageStore(u_IndirectConfidence, pixel, vec4(confidence, 0.0, 0.0, 0.0));
}
