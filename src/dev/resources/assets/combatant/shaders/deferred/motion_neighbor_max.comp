#version 430 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0, rg16f) readonly uniform image2D u_TileMax;
layout(binding = 1, rg16f) writeonly uniform image2D u_NeighborMax;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_NeighborMax);
    if (any(greaterThanEqual(p, size))) return;
    vec2 best = vec2(0.0);
    float bestLen = 0.0;
    for (int y = -1; y <= 1; ++y) for (int x = -1; x <= 1; ++x) {
        ivec2 q = clamp(p + ivec2(x, y), ivec2(0), size - 1);
        vec2 v = imageLoad(u_TileMax, q).xy;
        float l = dot(v, v);
        if (l > bestLen) { bestLen = l; best = v; }
    }
    imageStore(u_NeighborMax, p, vec4(best, 0.0, 1.0));
}
