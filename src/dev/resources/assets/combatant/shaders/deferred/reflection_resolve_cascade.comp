layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_TraceColor;
layout(binding = 1) uniform sampler2D u_TraceConfidence;
layout(binding = 2) uniform sampler2D u_GbufferGeometry;
layout(binding = 3) uniform sampler2D u_ResolvedDepth;
layout(binding = 4) uniform sampler2D u_CascadeColor;
layout(binding = 5) uniform sampler2D u_CascadeDepth;
layout(binding = 6, rgba16f) writeonly uniform image2D u_ReflectionColor;
layout(binding = 7, r8) writeonly uniform image2D u_ReflectionConfidence;

layout(std430, binding = 8) readonly buffer ReflectionTraceData {
    mat4 inverseProjection;
    mat4 inverseView;
    mat4 projection;
    vec4 depthTransform;
    vec4 traceExtentAndFar;
    vec4 traceParams0;
    vec4 traceParams1;
    // x: screen-source confidence threshold, y: cascade-source confidence.
    vec4 resolveParams;
} u_Trace;

struct CombatantReflectionCascadeFace {
    mat4 viewProjection;
    vec4 atlasScaleBias;
    // x: near, y: far, z: face index, w: total face count.
    vec4 rangeFace;
    // capture camera origin minus current primary camera origin.
    vec4 originDelta;
};

layout(std430, binding = 9) readonly buffer ReflectionCascadeData {
    CombatantReflectionCascadeFace faces[];
} u_Cascade;

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) {
        n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    }
    return normalize(n);
}

vec3 reconstructView(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Trace.depthTransform.x + u_Trace.depthTransform.y;
    vec4 h = u_Trace.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    return h.xyz / max(abs(h.w), 1e-7) * sign(h.w);
}

#define COMBATANT_REFLECTION_CASCADE_FACE(i) u_Cascade.faces[i]
#moj_import <combatant:deferred_reflection_cascade.glsl>
#undef COMBATANT_REFLECTION_CASCADE_FACE

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(u_ReflectionColor);
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(outputSize);
    vec3 traceColor = textureLod(u_TraceColor, uv, 0.0).rgb;
    float traceConfidence = textureLod(u_TraceConfidence, uv, 0.0).r;
    if (traceConfidence >= u_Trace.resolveParams.x) {
        imageStore(u_ReflectionColor, pixel, vec4(traceColor, 1.0));
        imageStore(u_ReflectionConfidence, pixel, vec4(traceConfidence, 0.0, 0.0, 0.0));
        return;
    }

    float depth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    if (depth <= 0.0) {
        imageStore(u_ReflectionColor, pixel, vec4(traceColor, 1.0));
        imageStore(u_ReflectionConfidence, pixel, vec4(traceConfidence, 0.0, 0.0, 0.0));
        return;
    }

    vec3 viewPosition = reconstructView(uv, depth);
    vec3 viewNormal = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    vec3 reflectedView = normalize(reflect(normalize(viewPosition), viewNormal));
    vec3 currentWorldRelative = (u_Trace.inverseView * vec4(viewPosition, 0.0)).xyz;
    vec3 reflectedWorld = normalize((u_Trace.inverseView * vec4(reflectedView, 0.0)).xyz);

    vec3 cascadeColor;
    int totalFaces = clamp(int(u_Cascade.faces[0].rangeFace.w + 0.5), 0, 24);
    if (combatantSampleReflectionCascade(u_CascadeColor, u_CascadeDepth, currentWorldRelative,
            reflectedWorld, length(viewPosition), totalFaces, cascadeColor)) {
        float cascadeConfidence = u_Trace.resolveParams.y;
        imageStore(u_ReflectionColor, pixel, vec4(cascadeColor, 1.0));
        imageStore(u_ReflectionConfidence, pixel, vec4(cascadeConfidence, 0.0, 0.0, 0.0));
        return;
    }

    imageStore(u_ReflectionColor, pixel, vec4(traceColor, 1.0));
    imageStore(u_ReflectionConfidence, pixel, vec4(traceConfidence, 0.0, 0.0, 0.0));
}
