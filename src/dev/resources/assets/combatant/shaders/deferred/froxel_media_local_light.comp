#version 430 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(binding = 1, rgba16f) uniform image3D u_SegmentRadiance;
layout(binding = 2, rgba16f) readonly uniform image3D u_MediaProperties;
layout(binding = 3, rgba16f) readonly uniform image3D u_SegmentTransmittance;
layout(binding = 8) uniform sampler2D u_LocalShadowDepth;

#moj_import <combatant:deferred_froxel_media_data.glsl>
#moj_import <combatant:deferred_froxel_transport.glsl>
#moj_import <combatant:deferred_local_light_contract.glsl>

layout(std430, binding = 4) readonly buffer LocalLightData { LocalLight lights[]; } u_Lights;
layout(std430, binding = 5) readonly buffer LocalLightTileCounts { uint counts[]; } u_Counts;
layout(std430, binding = 6) readonly buffer LocalLightTileIndices { uint indices[]; } u_Indices;
layout(std430, binding = 7) readonly buffer LocalLightCullData {
    mat4 projection;
    mat4 inverseProjection;
    mat4 inverseView;
    vec4 viewportLightCount;
    vec4 tileGrid;
    vec4 shadowParams;
} u_Cull;
layout(std430, binding = 9) readonly buffer LocalShadowData { LocalShadowView views[]; } u_Shadow;

const float PI = 3.14159265358979323846;

vec3 viewRay(vec2 uv) {
    float ndcZ = u_Data.policy.y > 0.5 ? 0.5 : 0.0;
    vec4 view = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    return normalize(view.xyz / max(abs(view.w), 1e-7) * sign(view.w));
}

float hgPhase(float cosTheta, float g) {
    float g2 = g * g;
    float denominator = max(1.0 + g2 - 2.0 * g * cosTheta, 1e-4);
    return (1.0 - g2) / (4.0 * PI * denominator * sqrt(denominator));
}

vec2 clampAtlasUv(LocalShadowView shadowView, vec2 uv) {
    vec2 halfTexel = shadowView.rangeTexel.yz * 0.5;
    vec2 minimum = shadowView.atlasScaleBias.zw + halfTexel;
    vec2 maximum = shadowView.atlasScaleBias.zw + shadowView.atlasScaleBias.xy - halfTexel;
    return clamp(uv, minimum, maximum);
}

float localShadowVisibility(LocalLight light, vec3 viewPosition) {
    int baseView = int(floor(light.shadowInfo.x + 0.5));
    int viewCount = int(floor(light.shadowInfo.y + 0.5));
    if (baseView < 0 || viewCount <= 0 || light.shadowInfo.z <= 0.5 || u_Shadow.views.length() == 0) return 1.0;

    vec3 worldRelative = (u_Cull.inverseView * vec4(viewPosition, 0.0)).xyz;
    int shadowIndex = -1;
    vec2 localUv = vec2(0.0);
    float receiverDepth = 0.0;
    float bestMargin = -1.0;
    int candidateCount = viewCount >= 6 ? min(viewCount, 6) : 1;
    for (int face = 0; face < 6; ++face) {
        if (face >= candidateCount) break;
        int candidateIndex = baseView + face;
        if (candidateIndex < 0 || candidateIndex >= u_Shadow.views.length()) continue;
        LocalShadowView candidateView = u_Shadow.views[candidateIndex];
        vec3 candidateRelative = worldRelative - candidateView.originNear.xyz;
        vec4 clip = candidateView.viewProjection * vec4(candidateRelative, 1.0);
        if (clip.w <= 1e-7) continue;
        vec3 ndc = clip.xyz / clip.w;
        vec2 candidateUv = ndc.xy * 0.5 + 0.5;
        float candidateDepth = u_Cull.tileGrid.w > 0.5 ? ndc.z : ndc.z * 0.5 + 0.5;
        if (any(lessThan(candidateUv, vec2(0.0))) || any(greaterThan(candidateUv, vec2(1.0)))
                || candidateDepth < 0.0 || candidateDepth > 1.0) continue;
        vec2 edge = min(candidateUv, vec2(1.0) - candidateUv);
        float margin = min(edge.x, edge.y);
        if (margin > bestMargin) {
            bestMargin = margin;
            shadowIndex = candidateIndex;
            localUv = candidateUv;
            receiverDepth = candidateDepth;
        }
    }
    if (shadowIndex < 0) return 1.0;
    LocalShadowView shadowView = u_Shadow.views[shadowIndex];

    vec2 atlasUv = localUv * shadowView.atlasScaleBias.xy + shadowView.atlasScaleBias.zw;
    vec2 atlasTexel = max(shadowView.rangeTexel.yz, vec2(1e-7));
    const vec2 offsets[4] = vec2[4](
        vec2(-0.5, -0.5), vec2(0.5, -0.5), vec2(-0.5, 0.5), vec2(0.5, 0.5)
    );
    float visibility = 0.0;
    for (int i = 0; i < 4; ++i) {
        float storedDepth = textureLod(u_LocalShadowDepth,
                clampAtlasUv(shadowView, atlasUv + offsets[i] * atlasTexel), 0.0).r;
        bool blocked = storedDepth > 0.0 && storedDepth > receiverDepth + 1e-5;
        visibility += blocked ? 0.0 : 1.0;
    }
    return visibility * 0.25;
}

vec3 integratedSource(vec3 sourcePerBlock, vec3 segmentTransmittance, float segmentLength) {
    vec3 t = clamp(segmentTransmittance, vec3(0.0), vec3(1.0));
    vec3 sigma = -log(max(t, vec3(1e-6))) / max(segmentLength, 1e-5);
    vec3 factor = vec3(segmentLength);
    for (int channel = 0; channel < 3; ++channel) {
        if (sigma[channel] > 1e-6) factor[channel] = (1.0 - t[channel]) / sigma[channel];
    }
    return sourcePerBlock * factor;
}

bool froxelCoordForViewPosition(vec3 viewPosition, ivec3 dimensions, out ivec3 coord) {
    vec4 clip = u_Cull.projection * vec4(viewPosition, 1.0);
    if (clip.w <= 1e-6) return false;
    vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThanEqual(uv, vec2(1.0)))) return false;

    float distanceValue = length(viewPosition);
    float maxDistance = max(u_Data.froxel.w, 1e-4);
    if (distanceValue < 0.0 || distanceValue >= maxDistance) return false;
    float normalized = pow(clamp(distanceValue / maxDistance, 0.0, 1.0),
            1.0 / max(u_Data.policy.x, 1.0));
    int z = clamp(int(floor(normalized * float(dimensions.z))), 0, dimensions.z - 1);
    ivec2 xy = clamp(ivec2(floor(uv * vec2(dimensions.xy))), ivec2(0), dimensions.xy - ivec2(1));
    coord = ivec3(xy, z);
    return true;
}

vec3 sigmaFromFroxel(ivec3 coord, ivec3 dimensions) {
    vec3 transmittance = clamp(imageLoad(u_SegmentTransmittance, coord).rgb, vec3(1e-6), vec3(1.0));
    float nearDistance = combatant_froxel_boundary_distance(
            coord.z, dimensions.z, u_Data.froxel.w, u_Data.policy.x);
    float farDistance = combatant_froxel_boundary_distance(
            coord.z + 1, dimensions.z, u_Data.froxel.w, u_Data.policy.x);
    float segmentLength = max(farDistance - nearDistance, 1e-4);
    return -log(transmittance) / segmentLength;
}

vec3 lightPathTransmittance(vec3 receiverView,
                            vec3 pathDirection,
                            float pathDistance,
                            ivec3 dimensions,
                            vec3 fallbackSigma) {
    int sampleCount = clamp(int(u_Data.localLightTransport.x + 0.5), 1, 16);
    float stepLength = max(pathDistance, 0.0) / float(sampleCount);
    if (stepLength <= 1e-6) return vec3(1.0);

    vec3 opticalDepth = vec3(0.0);
    for (int sampleIndex = 0; sampleIndex < 16; ++sampleIndex) {
        if (sampleIndex >= sampleCount) break;
        float distanceAlongPath = (float(sampleIndex) + 0.5) * stepLength;
        vec3 samplePosition = receiverView + pathDirection * distanceAlongPath;
        ivec3 sampleCoord;
        vec3 sigma = fallbackSigma;
        if (froxelCoordForViewPosition(samplePosition, dimensions, sampleCoord)) {
            sigma = sigmaFromFroxel(sampleCoord, dimensions);
        }
        opticalDepth += max(sigma, vec3(0.0)) * stepLength;
    }
    return exp(-opticalDepth);
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 dimensions = imageSize(u_SegmentRadiance);
    if (any(greaterThanEqual(coord, dimensions))) return;

    vec4 properties = imageLoad(u_MediaProperties, coord);
    vec3 sigmaS = max(properties.rgb, vec3(0.0));
    if (max(max(sigmaS.r, sigmaS.g), sigmaS.b) <= 1e-8) return;

    vec2 uv = (vec2(coord.xy) + 0.5) / vec2(dimensions.xy);
    vec3 rayView = viewRay(uv);
    float nearDistance = combatant_froxel_boundary_distance(
            coord.z, dimensions.z, u_Data.froxel.w, u_Data.policy.x);
    float farDistance = combatant_froxel_boundary_distance(
            coord.z + 1, dimensions.z, u_Data.froxel.w, u_Data.policy.x);
    float centerDistance = 0.5 * (nearDistance + farDistance);
    float segmentLength = max(farDistance - nearDistance, 1e-4);
    vec3 viewPosition = rayView * centerDistance;

    vec2 viewport = max(u_Cull.viewportLightCount.xy, vec2(1.0));
    uint tileSize = uint(max(u_Cull.viewportLightCount.w, 1.0));
    uvec2 tileCount = uvec2(max(u_Cull.tileGrid.xy, vec2(1.0)));
    uvec2 pixel = uvec2(clamp(uv * viewport, vec2(0.0), viewport - vec2(1.0)));
    uvec2 tile = min(pixel / tileSize, tileCount - uvec2(1u));
    uint tileIndex = tile.y * tileCount.x + tile.x;
    uint maxPerTile = uint(max(u_Cull.tileGrid.z, 1.0));
    uint count = min(u_Counts.counts[tileIndex], maxPerTile);
    uint base = tileIndex * maxPerTile;

    vec3 segmentT = imageLoad(u_SegmentTransmittance, coord).rgb;
    vec3 localSigmaT = -log(max(clamp(segmentT, vec3(0.0), vec3(1.0)), vec3(1e-6)))
            / max(segmentLength, 1e-5);
    vec3 incident = vec3(0.0);
    float g = clamp(properties.a, -0.95, 0.95);
    uint lightCount = uint(max(u_Cull.viewportLightCount.z, 0.0));
    for (uint i = 0u; i < count; ++i) {
        uint lightIndex = u_Indices.indices[base + i];
        if (lightIndex >= lightCount || lightIndex >= uint(u_Lights.lights.length())) continue;
        LocalLight light = u_Lights.lights[lightIndex];
        vec3 toLight = light.positionRadius.xyz - viewPosition;
        float distanceValue = length(toLight);
        float radius = max(light.positionRadius.w, 0.0);
        if (distanceValue <= 1e-5 || radius <= 0.0 || distanceValue >= radius) continue;

        vec3 lightDirection = toLight / distanceValue;
        int type = int(light.radianceType.w + 0.5);
        float sourceDistance = distanceValue;
        if (type == COMBATANT_LOCAL_LIGHT_SPHERE) {
            sourceDistance = max(distanceValue - max(light.coneArea.y, 0.0), 1e-3);
        }
        float attenuation = 1.0 / max(sourceDistance * sourceDistance, 1e-4);

        if (type == COMBATANT_LOCAL_LIGHT_SPOT) {
            vec3 fromLight = -lightDirection;
            float coneCos = dot(fromLight, normalize(light.directionOuter.xyz));
            float outerCos = light.directionOuter.w;
            float innerCos = light.coneArea.x;
            if (coneCos <= outerCos) continue;
            if (innerCos > outerCos) attenuation *= smoothstep(outerCos, innerCos, coneCos);
        }

        float visibility = localShadowVisibility(light, viewPosition);
        if (visibility <= 0.0) continue;
        float phase = hgPhase(dot(rayView, lightDirection), g);
        vec3 lightPathT = lightPathTransmittance(
                viewPosition, lightDirection, sourceDistance, dimensions, max(localSigmaT, vec3(0.0)));
        incident += max(light.radianceType.rgb, vec3(0.0)) * attenuation * phase * visibility * lightPathT;
    }

    if (max(max(incident.r, incident.g), incident.b) <= 1e-10) return;
    vec4 currentRadiance = imageLoad(u_SegmentRadiance, coord);
    vec3 added = integratedSource(sigmaS * incident, segmentT, segmentLength);
    added *= exp(-max(currentRadiance.a, 0.0) * segmentLength * 0.5);
    imageStore(u_SegmentRadiance, coord, vec4(max(currentRadiance.rgb + added, vec3(0.0)), currentRadiance.a));
}
