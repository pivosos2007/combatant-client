#version 430 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_FinalDepth;
layout(binding = 1, r32f) writeonly uniform image2D u_OutputDepth;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(u_OutputDepth);
    if (any(greaterThanEqual(pixel, outSize))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(outSize);
    ivec2 sourceSize = max(textureSize(u_FinalDepth, 0), ivec2(1));
    ivec2 sourcePixel = clamp(ivec2(uv * vec2(sourceSize)), ivec2(0), sourceSize - 1);
    float depth = texelFetch(u_FinalDepth, sourcePixel, 0).r;
    if (isnan(depth) || isinf(depth) || depth < 0.0) depth = 0.0;
    imageStore(u_OutputDepth, pixel, vec4(depth, 0.0, 0.0, 1.0));
}
