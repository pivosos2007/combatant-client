#version 430 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer ExposureState {
    vec4 exposure;
    vec4 adaptation;
    vec4 percentiles;
    uvec4 lifecycle;
} u_State;
layout(rgba16f, binding = 1) writeonly uniform image2D u_Output;
layout(std430, binding = 2) readonly buffer DebugParams { vec4 decode; vec4 aux; } u_Params;
void main() {
    ivec2 outSize = imageSize(u_Output);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, outSize))) return;
    float multiplier = max(u_State.exposure.x, 0.0);
    float mapped = multiplier / (1.0 + multiplier);
    float ev = u_State.exposure.y;
    vec3 rgb = mix(vec3(mapped), ev < 0.0 ? vec3(mapped, mapped * 0.5, 0.0) : vec3(0.0, mapped * 0.5, mapped), 0.35);
    if (u_State.lifecycle.x == 0u) rgb = vec3(1.0, 0.0, 1.0);
    imageStore(u_Output, pixel, vec4(clamp(rgb, 0.0, 1.0), 1.0));
}
