layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_CurrentColor;
layout(binding = 1) uniform sampler2D u_CurrentConfidence;
layout(binding = 2) uniform sampler2D u_Velocity;
layout(binding = 3) uniform sampler2D u_CurrentDepth;
layout(binding = 4) uniform sampler2D u_HistoryColor;
layout(binding = 5) uniform sampler2D u_HistoryConfidence;
layout(binding = 6) uniform sampler2D u_HistoryDepth;
layout(binding = 7, rgba16f) writeonly uniform image2D u_OutputColor;
layout(binding = 8, r8) writeonly uniform image2D u_OutputConfidence;
layout(binding = 9) uniform sampler2D u_DisocclusionMask;
layout(std430, binding = 10) readonly buffer TemporalParams { vec4 params; } u_Temporal;
layout(binding = 11) uniform sampler2D u_ReactiveMask;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_OutputColor);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 current = textureLod(u_CurrentColor, uv, 0.0);
    float currentConfidence = textureLod(u_CurrentConfidence, uv, 0.0).r;
    vec2 velocity = textureLod(u_Velocity, uv, 0.0).rg;
    vec2 previousUv = uv - velocity;
    bool inside = all(greaterThanEqual(previousUv, vec2(0.0))) && all(lessThanEqual(previousUv, vec2(1.0)));
    float historyAccept = 0.0;
    vec4 history = current;
    float historyConfidence = 0.0;
    float disocclusionAccept = 1.0 - step(0.5, textureLod(u_DisocclusionMask, uv, 0.0).r);
    float reactive = clamp(textureLod(u_ReactiveMask, uv, 0.0).r, 0.0, 1.0);
    float explicitHistoryAccept = disocclusionAccept * (1.0 - reactive);
    if (inside && explicitHistoryAccept > 0.0) {
        float currentDepth = textureLod(u_CurrentDepth, uv, 0.0).r;
        float previousDepth = textureLod(u_HistoryDepth, previousUv, 0.0).r;
        float depthDelta = abs(currentDepth - previousDepth);
        float depthScale = max(max(abs(currentDepth), abs(previousDepth)), 1e-3);
        historyAccept = depthDelta <= u_Temporal.params.y * depthScale ? explicitHistoryAccept : 0.0;
        history = textureLod(u_HistoryColor, previousUv, 0.0);
        historyConfidence = textureLod(u_HistoryConfidence, previousUv, 0.0).r;
    }
    float historyWeight = clamp(u_Temporal.params.x * historyConfidence * historyAccept, 0.0, 0.99);
    vec4 resolved = mix(current, history, historyWeight);
    float resolvedConfidence = max(currentConfidence, historyConfidence * historyAccept);
    imageStore(u_OutputColor, pixel, resolved);
    imageStore(u_OutputConfidence, pixel, vec4(resolvedConfidence, 0.0, 0.0, 0.0));
}
