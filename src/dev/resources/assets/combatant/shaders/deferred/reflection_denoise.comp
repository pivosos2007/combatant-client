layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_InputColor;
layout(binding = 1) uniform sampler2D u_InputConfidence;
layout(binding = 2) uniform sampler2D u_GbufferGeometry;
layout(binding = 3) uniform sampler2D u_Depth;
layout(binding = 4, rgba16f) writeonly uniform image2D u_OutputColor;
layout(binding = 5, r8) writeonly uniform image2D u_OutputConfidence;
layout(std430, binding = 6) readonly buffer DenoiseParams { vec4 params; } u_Denoise;
layout(binding = 7) uniform sampler2D u_GbufferMaterial;

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) {
        n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    }
    return normalize(n);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(u_OutputColor);
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec2 invOutputSize = 1.0 / vec2(outputSize);
    vec2 centerUv = (vec2(pixel) + vec2(0.5)) * invOutputSize;
    vec4 centerColor = textureLod(u_InputColor, centerUv, 0.0);
    float centerConfidence = textureLod(u_InputConfidence, centerUv, 0.0).r;

    int maxRadius = clamp(int(round(u_Denoise.params.x)), 0, 4);
    float centerRoughness = clamp(textureLod(u_GbufferMaterial, centerUv, 0.0).r, 0.0, 1.0);
    // The spatial footprint is a quality-bounded approximation of the rough microfacet cone:
    // polished surfaces stay sharp while rough surfaces integrate a wider reflection neighborhood.
    float microfacetAlpha = centerRoughness * centerRoughness;
    int radius = min(maxRadius, int(ceil(microfacetAlpha * float(maxRadius))));
    if (radius == 0) {
        imageStore(u_OutputColor, pixel, centerColor);
        imageStore(u_OutputConfidence, pixel, vec4(centerConfidence, 0.0, 0.0, 0.0));
        return;
    }

    float centerDepth = textureLod(u_Depth, centerUv, 0.0).r;
    vec3 centerNormal = decodeOctahedral(textureLod(u_GbufferGeometry, centerUv, 0.0).rg);
    float depthThreshold = max(u_Denoise.params.y, 1e-6);
    float normalThreshold = clamp(u_Denoise.params.z, 0.0, 1.0);
    float normalRange = max(1.0 - normalThreshold, 1e-5);

    vec4 colorSum = centerColor * centerConfidence;
    float colorWeightSum = centerConfidence;
    float confidenceSum = centerConfidence;
    float confidenceWeightSum = 1.0;

    for (int y = -4; y <= 4; ++y) {
        if (abs(y) > radius) continue;
        for (int x = -4; x <= 4; ++x) {
            if (abs(x) > radius || (x == 0 && y == 0)) continue;

            ivec2 offset = ivec2(x, y);
            vec2 sampleUv = centerUv + vec2(offset) * invOutputSize;
            if (any(lessThan(sampleUv, vec2(0.0))) || any(greaterThan(sampleUv, vec2(1.0)))) continue;

            float sampleDepth = textureLod(u_Depth, sampleUv, 0.0).r;
            float depthScale = max(max(abs(centerDepth), abs(sampleDepth)), 1e-3);
            float relativeDepthDelta = abs(centerDepth - sampleDepth) / depthScale;
            if (relativeDepthDelta > depthThreshold) continue;

            vec3 sampleNormal = decodeOctahedral(textureLod(u_GbufferGeometry, sampleUv, 0.0).rg);
            float normalDot = dot(centerNormal, sampleNormal);
            if (normalDot < normalThreshold) continue;

            float sampleConfidence = textureLod(u_InputConfidence, sampleUv, 0.0).r;
            float spatialWeight = 1.0 / (1.0 + float(x * x + y * y));
            float depthWeight = 1.0 - clamp(relativeDepthDelta / depthThreshold, 0.0, 1.0);
            float normalWeight = clamp((normalDot - normalThreshold) / normalRange, 0.0, 1.0);
            float geometryWeight = spatialWeight * depthWeight * normalWeight;
            float colorWeight = geometryWeight * sampleConfidence;
            if (geometryWeight <= 0.0) continue;

            colorSum += textureLod(u_InputColor, sampleUv, 0.0) * colorWeight;
            colorWeightSum += colorWeight;
            confidenceSum += sampleConfidence * geometryWeight;
            confidenceWeightSum += geometryWeight;
        }
    }

    vec4 resultColor = colorWeightSum > 1e-6 ? colorSum / colorWeightSum : centerColor;
    float resultConfidence = clamp(confidenceSum / max(confidenceWeightSum, 1e-6), 0.0, 1.0);
    imageStore(u_OutputColor, pixel, resultColor);
    imageStore(u_OutputConfidence, pixel, vec4(resultConfidence, 0.0, 0.0, 0.0));
}
