#version 430 core
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_Depth;
layout(std430, binding = 1) buffer FocusState { vec4 focus; } u_Focus;
layout(std430, binding = 2) readonly buffer FocusParams {
    mat4 inverseProjection;
    vec4 depthTransform; // x=scale, y=bias, z=dt, w=reset
    vec4 policy;         // x=autofocus, y=smoothing, z=farPlane, w=unused
} u_Params;

float viewDistance(vec2 uv, float depth) {
    if (!(depth > 0.0) || isnan(depth) || isinf(depth)) return 0.0;
    float ndcZ = depth * u_Params.depthTransform.x + u_Params.depthTransform.y;
    vec4 h = u_Params.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    if (abs(h.w) < 1e-7) return 0.0;
    vec3 view = h.xyz / h.w;
    float d = length(view);
    return isinf(d) || isnan(d) ? 0.0 : d;
}

void main() {
    if (u_Params.policy.x < 0.5) {
        u_Focus.focus = vec4(0.0, 0.0, 1.0, 0.0);
        return;
    }

    ivec2 size = max(textureSize(u_Depth, 0), ivec2(1));
    ivec2 center = size / 2;
    float sum = 0.0;
    float weightSum = 0.0;
    const int RADIUS = 2;
    for (int y = -RADIUS; y <= RADIUS; ++y) {
        for (int x = -RADIUS; x <= RADIUS; ++x) {
            ivec2 p = clamp(center + ivec2(x, y), ivec2(0), size - 1);
            float depth = texelFetch(u_Depth, p, 0).r;
            vec2 uv = (vec2(p) + 0.5) / vec2(size);
            float d = viewDistance(uv, depth);
            if (d <= 0.0) continue;
            float radial = float(x * x + y * y);
            float w = 1.0 / (1.0 + radial);
            sum += d * w;
            weightSum += w;
        }
    }

    float previous = u_Focus.focus.x;
    float previousValid = u_Focus.focus.z;
    float target = weightSum > 1e-6 ? sum / weightSum : (previousValid > 0.5 ? previous : 0.0);
    bool targetValid = target > 0.0 && !isnan(target) && !isinf(target);
    if (!targetValid) {
        u_Focus.focus = vec4(previous, previous, previousValid, u_Focus.focus.w + 1.0);
        return;
    }

    bool reset = u_Params.depthTransform.w > 0.5 || previousValid < 0.5 || !(previous > 0.0);
    float dt = clamp(u_Params.depthTransform.z, 1.0 / 240.0, 0.25);
    float rate = max(0.0, u_Params.policy.y);
    float alpha = reset || rate <= 0.0 ? 1.0 : 1.0 - exp(-rate * dt);
    float current = mix(previous, target, clamp(alpha, 0.0, 1.0));
    u_Focus.focus = vec4(current, target, 1.0, reset ? 1.0 : u_Focus.focus.w + 1.0);
}
