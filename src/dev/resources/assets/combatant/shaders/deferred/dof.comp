#version 430 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_Color;
layout(binding = 1) uniform sampler2D u_Depth;
layout(std430, binding = 2) readonly buffer FocusState { vec4 focus; } u_Focus;
layout(binding = 3, rgba16f) writeonly uniform image2D u_Output;
layout(binding = 4, r32f) writeonly uniform image2D u_Coc;
layout(std430, binding = 5) readonly buffer DofParams {
    mat4 inverseProjection;
    vec4 depthTransform; // x=scale, y=bias
    vec4 focusAndRange;  // x=farStart y=farTransition z=strength w=maxRadius
    vec4 quality;        // x=samples y=edgeProtection z=enabled w=autofocus
} u_Params;

const float PI2 = 6.283185307179586;

float viewDistance(vec2 uv, float depth) {
    if (!(depth > 0.0) || isnan(depth) || isinf(depth)) return 0.0;
    float ndcZ = depth * u_Params.depthTransform.x + u_Params.depthTransform.y;
    vec4 h = u_Params.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    if (abs(h.w) < 1e-7) return 0.0;
    vec3 v = h.xyz / h.w;
    float d = length(v);
    return (isnan(d) || isinf(d)) ? 0.0 : d;
}

vec3 safeHdr(vec3 c) {
    return (any(isnan(c)) || any(isinf(c))) ? vec3(0.0) : max(c, vec3(0.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_Output);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 centerColor = textureLod(u_Color, uv, 0.0);

    if (u_Params.quality.z < 0.5) {
        imageStore(u_Output, pixel, centerColor);
        imageStore(u_Coc, pixel, vec4(0.0));
        return;
    }

    float centerDepth = textureLod(u_Depth, uv, 0.0).r;
    float centerDistance = viewDistance(uv, centerDepth);
    if (!(centerDistance > 0.0)) {
        imageStore(u_Output, pixel, centerColor);
        imageStore(u_Coc, pixel, vec4(0.0));
        return;
    }

    float focusDistance = u_Params.quality.w > 0.5 && u_Focus.focus.z > 0.5 ? max(0.0, u_Focus.focus.x) : 0.0;
    float farStart = max(0.0, u_Params.focusAndRange.x) + focusDistance;
    float farEnd = farStart + max(1e-4, u_Params.focusAndRange.y);
    float coc = smoothstep(farStart, farEnd, centerDistance) * max(0.0, u_Params.focusAndRange.z);
    float radius = coc * max(0.0, u_Params.focusAndRange.w);
    imageStore(u_Coc, pixel, vec4(coc, 0.0, 0.0, 1.0));

    if (radius < 0.35) {
        imageStore(u_Output, pixel, centerColor);
        return;
    }

    int samples = clamp(int(u_Params.quality.x + 0.5), 4, 64);
    vec2 texel = 1.0 / vec2(size);
    vec3 accum = safeHdr(centerColor.rgb);
    float weightSum = 1.0;
    float edgeStrength = max(0.0, u_Params.quality.y);

    for (int i = 0; i < 64; ++i) {
        if (i >= samples) break;
        float fi = float(i) + 0.5;
        float r = sqrt(fi / float(samples));
        float angle = fi * 2.39996323;
        vec2 offset = vec2(cos(angle), sin(angle)) * radius * r * texel;
        vec2 suv = clamp(uv + offset, texel * 0.5, vec2(1.0) - texel * 0.5);
        float sd = textureLod(u_Depth, suv, 0.0).r;
        float sampleDistance = viewDistance(suv, sd);
        if (!(sampleDistance > 0.0)) continue;

        // Far-background blur must not pull foreground silhouettes into the background.
        float separation = max(0.05, centerDistance * 0.015);
        float foregroundDelta = max(0.0, centerDistance - sampleDistance);
        float edgeWeight = 1.0 / (1.0 + edgeStrength * foregroundDelta / separation);
        vec3 sampleColor = safeHdr(textureLod(u_Color, suv, 0.0).rgb);
        accum += sampleColor * edgeWeight;
        weightSum += edgeWeight;
    }

    imageStore(u_Output, pixel, vec4(accum / max(weightSum, 1e-5), centerColor.a));
}
