#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_BaseRadiance;
layout(binding = 1) uniform sampler2D u_Depth;
layout(binding = 2) uniform sampler2D u_SkyRadiance;
layout(binding = 3, rgba16f) writeonly uniform image2D u_Output;
layout(binding = 6) uniform sampler2D u_Transmittance;
layout(std430, binding = 4) readonly buffer SkyCompositeData {
    mat4 inverseProjection;
    mat4 inverseView;
    vec4 flags;
    vec4 atmosphereRadii;
    vec4 sunDirection;
    vec4 sunAppearance;
    vec4 moonDirection;
    vec4 moonAppearance;
    vec4 moonPolicy;
    vec4 starPolicy0;
    vec4 starPolicy1;
    vec4 starWarm;
    vec4 starCool;
} u_Data;
layout(std430, binding = 5) readonly buffer SkyEnvironmentState {
    vec4 state0;
    vec4 state1;
} u_SkyState;

const float PI = 3.14159265358979323846;
const float TWO_PI = 6.28318530717958647692;

vec2 latLongFromDirection(vec3 d) {
    d = normalize(d);
    float phi = atan(d.z, d.x);
    float theta = acos(clamp(d.y, -1.0, 1.0));
    return vec2(phi / TWO_PI + 0.5, theta / PI);
}

vec3 worldRay(vec2 uv) {
    float ndcZ = u_Data.flags.x > 0.5 ? 0.5 : 0.0;
    vec4 view = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    vec3 viewDirection = normalize(view.xyz / max(abs(view.w), 1e-7) * sign(view.w));
    return normalize(mat3(u_Data.inverseView) * viewDirection);
}

vec3 atmosphereTransmittance(vec3 direction) {
    if (u_Data.flags.z <= 0.5) return vec3(1.0);
    float heightUv = clamp((u_Data.atmosphereRadii.z - u_Data.atmosphereRadii.x)
            / max(u_Data.atmosphereRadii.w, 1e-4), 0.0, 1.0);
    float muUv = clamp(direction.y * 0.5 + 0.5, 0.0, 1.0);
    return max(textureLod(u_Transmittance, vec2(muUv, heightUv), 0.0).rgb, vec3(0.0));
}

float angularDistance(vec3 a, vec3 b) {
    return acos(clamp(dot(normalize(a), normalize(b)), -1.0, 1.0));
}

float angularPixelFootprint(vec2 uv, vec3 ray, ivec2 size) {
    vec2 invSize = 1.0 / vec2(size);
    vec2 uvX = min(uv + vec2(invSize.x, 0.0), vec2(1.0) - invSize * 0.5);
    vec2 uvY = min(uv + vec2(0.0, invSize.y), vec2(1.0) - invSize * 0.5);
    float x = angularDistance(ray, worldRay(uvX));
    float y = angularDistance(ray, worldRay(uvY));
    return max(max(x, y), 1e-5);
}

float discCoverage(float angle, float radius, float pixelFootprint) {
    if (radius <= 0.0) return 0.0;
    float feather = max(pixelFootprint * 1.25, radius * 0.025);
    return 1.0 - smoothstep(radius - feather, radius + feather, angle);
}

vec3 compositeSun(vec3 sky, vec3 ray, float pixelFootprint) {
    vec3 direction = normalize(u_Data.sunDirection.xyz);
    float radius = u_Data.sunDirection.w;
    float angle = angularDistance(ray, direction);
    float coverage = discCoverage(angle, radius, pixelFootprint)
            * smoothstep(-radius, radius, direction.y);
    if (coverage <= 0.0) return sky;

    float normalizedRadius = clamp(angle / max(radius, 1e-6), 0.0, 1.0);
    float mu = sqrt(max(0.0, 1.0 - normalizedRadius * normalizedRadius));
    float limb = 1.0 - clamp(u_Data.sunAppearance.w, 0.0, 1.0) * (1.0 - mu);
    vec3 disk = u_Data.sunAppearance.rgb * atmosphereTransmittance(direction) * limb;
    return mix(sky, max(sky, disk), coverage);
}

vec3 compositeMoon(vec3 sky, vec3 ray, float pixelFootprint) {
    vec3 direction = normalize(u_Data.moonDirection.xyz);
    float radius = u_Data.moonDirection.w;
    float angle = angularDistance(ray, direction);
    float coverage = discCoverage(angle, radius, pixelFootprint)
            * smoothstep(-radius, radius, direction.y);
    if (coverage <= 0.0) return sky;

    vec3 reference = abs(direction.y) < 0.95 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(reference, direction));
    vec3 bitangent = normalize(cross(direction, tangent));
    float sinRadius = max(sin(radius), 1e-6);
    float x = dot(ray, tangent) / sinRadius;
    float y = dot(ray, bitangent) / sinRadius;
    float r2 = min(x * x + y * y, 1.0);
    float z = sqrt(max(0.0, 1.0 - r2));
    vec3 surfaceNormal = normalize(tangent * x + bitangent * y - direction * z);

    // Phase orientation comes from the exact producer-owned Sun/Moon directions. The phase index
    // remains in the contract for texture/albedo policy, but is not needed to reconstruct geometry.
    vec3 sunDirectionLocal = normalize(u_Data.sunDirection.xyz);
    float diffuse = max(dot(surfaceNormal, sunDirectionLocal), 0.0);
    float shaped = pow(diffuse, max(u_Data.moonPolicy.y, 0.01));
    float earthshine = clamp(u_Data.moonAppearance.w, 0.0, 1.0);
    float illumination = earthshine + (1.0 - earthshine) * shaped;
    vec3 disk = u_Data.moonAppearance.rgb * atmosphereTransmittance(direction) * illumination;
    return mix(sky, disk, coverage);
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec3 rotateStars(vec3 direction, float angle) {
    float c = cos(angle);
    float s = sin(angle);
    return vec3(c * direction.x - s * direction.y,
                s * direction.x + c * direction.y,
                direction.z);
}

vec3 proceduralStars(vec3 ray) {
    float brightness = clamp(u_Data.starPolicy0.y, 0.0, 1.0);
    float intensity = max(u_Data.starPolicy0.z, 0.0);
    float density = clamp(u_Data.starPolicy0.w, 0.0, 1.0);
    if (brightness <= 0.0 || intensity <= 0.0 || density <= 0.0) return vec3(0.0);

    vec3 rotated = normalize(rotateStars(ray, -u_Data.starPolicy0.x));
    vec2 ll = latLongFromDirection(rotated);
    vec2 grid = vec2(1024.0, 512.0);
    vec2 scaled = ll * grid;
    vec2 cell = floor(scaled);
    float selector = hash12(cell + 17.0);
    if (selector > density) return vec3(0.0);

    vec2 center = vec2(hash12(cell + 3.1), hash12(cell + 9.7));
    vec2 local = fract(scaled) - center;
    local.x *= max(sin(ll.y * PI), 0.20);
    float radius = max(u_Data.starPolicy1.x, 0.001);
    float point = 1.0 - smoothstep(radius * 0.35, radius, length(local));
    if (point <= 0.0) return vec3(0.0);

    float temperatureMix = hash12(cell + 29.0);
    vec3 color = mix(u_Data.starWarm.rgb, u_Data.starCool.rgb, temperatureMix);
    float twinklePhase = hash12(cell + 47.0) * TWO_PI;
    float twinkle = 1.0 + sin(u_Data.starPolicy1.w * u_Data.starPolicy1.z + twinklePhase)
            * clamp(u_Data.starPolicy1.y, 0.0, 1.0);
    float horizon = smoothstep(u_Data.starWarm.w, u_Data.starCool.w, ray.y);
    return color * (point * brightness * intensity * max(twinkle, 0.0) * horizon)
            * atmosphereTransmittance(ray);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_Output);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec3 base = max(textureLod(u_BaseRadiance, uv, 0.0).rgb, vec3(0.0));
    float depth = textureLod(u_Depth, uv, 0.0).r;
    if (depth <= 0.0 && (u_SkyState.state0.x > 0.5 || u_SkyState.state0.w > 0.5)) {
        vec3 ray = worldRay(uv);
        base = max(textureLod(u_SkyRadiance, latLongFromDirection(ray), 0.0).rgb, vec3(0.0));
        if (u_Data.flags.y > 0.5) {
            float pixelFootprint = angularPixelFootprint(uv, ray, size);
            base += proceduralStars(ray);
            base = compositeSun(base, ray, pixelFootprint);
            base = compositeMoon(base, ray, pixelFootprint);
        }
    }

    imageStore(u_Output, pixel, vec4(base, 1.0));
}
