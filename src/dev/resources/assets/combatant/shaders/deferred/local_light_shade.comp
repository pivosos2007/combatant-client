#version 430 core

/* Material-aware neutral GGX/Burley evaluation for analytic local lights with explicit shadows. */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_GbufferSurface;
layout(binding = 1) uniform sampler2D u_GbufferGeometry;
layout(binding = 2) uniform sampler2D u_GbufferMaterial;
layout(binding = 3) uniform sampler2D u_ResolvedDepth;
layout(binding = 4) uniform sampler2D u_GbufferDepth;
layout(binding = 5, rgba16f) writeonly uniform image2D u_LocalLighting;
layout(binding = 10) uniform sampler2D u_LocalShadowDepth;

struct LocalLight {
    vec4 positionRadius;
    vec4 radianceType;
    vec4 directionOuter;
    vec4 coneArea;
    // x: first shadow view slot, y: view count, z: producer requests shadows.
    vec4 shadowInfo;
};
layout(std430, binding = 6) readonly buffer LocalLightData { LocalLight lights[]; } u_Lights;
layout(std430, binding = 7) readonly buffer LocalLightTileCounts { uint counts[]; } u_Counts;
layout(std430, binding = 8) readonly buffer LocalLightTileIndices { uint indices[]; } u_Indices;
layout(std430, binding = 9) readonly buffer LocalLightCullData {
    mat4 projection;
    mat4 inverseProjection;
    mat4 inverseView;
    vec4 viewportLightCount;
    // w: 1 when clip/depth NDC is [0,1], 0 when it is [-1,1].
    vec4 tileGrid;
    // x: normal offset in shadow texels, y: receiver-plane bias in shadow texels,
    // z: PCF radius in shadow texels, w: shadow face resolution.
    vec4 shadowParams;
} u_Cull;

struct LocalShadowView {
    mat4 viewProjection;
    vec4 atlasScaleBias;
    // xyz: shadow-view origin relative to the primary camera, w: near plane.
    vec4 originNear;
    // x: far plane, yz: atlas texel size, w: tan(horizontal FOV / 2).
    vec4 rangeTexel;
};
layout(std430, binding = 11) readonly buffer LocalShadowData {
    LocalShadowView views[];
} u_Shadow;

const float PI = 3.14159265358979323846;
const vec2 POISSON[16] = vec2[](
    vec2(-0.94201624, -0.39906216), vec2(0.94558609, -0.76890725),
    vec2(-0.09418410, -0.92938870), vec2(0.34495938, 0.29387760),
    vec2(-0.91588581, 0.45771432), vec2(-0.81544232, -0.87912464),
    vec2(-0.38277543, 0.27676845), vec2(0.97484398, 0.75648379),
    vec2(0.44323325, -0.97511554), vec2(0.53742981, -0.47373420),
    vec2(-0.26496911, -0.41893023), vec2(0.79197514, 0.19090188),
    vec2(-0.24188840, 0.99706507), vec2(-0.81409955, 0.91437590),
    vec2(0.19984126, 0.78641367), vec2(0.14383161, -0.14100790)
);

struct ShadowProjection {
    vec2 localUv;
    vec2 atlasUv;
    float depth;
    bool valid;
};

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

vec3 reconstructView(vec2 uv, float depth) {
    float ndcZ = u_Cull.tileGrid.w > 0.5 ? depth : depth * 2.0 - 1.0;
    vec4 h = u_Cull.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    return h.xyz / max(abs(h.w), 1e-7) * sign(h.w);
}

bool ownsGbufferPixel(vec2 uv, float currentDepth) {
    float gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    if (gbufferDepth <= 0.0 || currentDepth <= 0.0) return false;
    float tolerance = max(1.0e-6, abs(gbufferDepth) * 1.0e-5);
    return abs(gbufferDepth - currentDepth) <= tolerance;
}

float ggxDistribution(float ndoth, float roughness) {
    float a = max(roughness * roughness, 1e-4);
    float a2 = a * a;
    float d = ndoth * ndoth * (a2 - 1.0) + 1.0;
    return a2 / max(PI * d * d, 1e-6);
}

float smithGgxCorrelated(float ndotv, float ndotl, float roughness) {
    float a = max(roughness * roughness, 1e-4);
    float a2 = a * a;
    float gv = ndotl * sqrt(max(ndotv * ndotv * (1.0 - a2) + a2, 1e-6));
    float gl = ndotv * sqrt(max(ndotl * ndotl * (1.0 - a2) + a2, 1e-6));
    return 0.5 / max(gv + gl, 1e-6);
}

vec3 fresnelSchlick(float vdoth, vec3 f0) {
    float factor = pow(clamp(1.0 - vdoth, 0.0, 1.0), 5.0);
    return f0 + (vec3(1.0) - f0) * factor;
}

float burleyDiffuse(float ndotv, float ndotl, float ldoth, float roughness) {
    float fd90 = 0.5 + 2.0 * roughness * ldoth * ldoth;
    float lightScatter = 1.0 + (fd90 - 1.0) * pow(1.0 - ndotl, 5.0);
    float viewScatter = 1.0 + (fd90 - 1.0) * pow(1.0 - ndotv, 5.0);
    return lightScatter * viewScatter / PI;
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec2 rotateOffset(vec2 value, float angle) {
    float c = cos(angle);
    float s = sin(angle);
    return vec2(c * value.x - s * value.y, s * value.x + c * value.y);
}

ShadowProjection projectShadow(LocalShadowView shadowView, vec3 cameraRelativeWorld) {
    ShadowProjection result;
    vec3 lightRelative = cameraRelativeWorld - shadowView.originNear.xyz;
    vec4 clip = shadowView.viewProjection * vec4(lightRelative, 1.0);
    result.valid = clip.w > 1e-7;
    result.localUv = vec2(0.0);
    result.atlasUv = vec2(0.0);
    result.depth = 0.0;
    if (!result.valid) return result;

    vec3 ndc = clip.xyz / clip.w;
    result.localUv = ndc.xy * 0.5 + 0.5;
    result.depth = u_Cull.tileGrid.w > 0.5 ? ndc.z : ndc.z * 0.5 + 0.5;
    result.valid = all(greaterThanEqual(result.localUv, vec2(0.0)))
            && all(lessThanEqual(result.localUv, vec2(1.0)))
            && result.depth >= 0.0 && result.depth <= 1.0;
    result.atlasUv = result.localUv * shadowView.atlasScaleBias.xy + shadowView.atlasScaleBias.zw;
    return result;
}

bool selectPointShadowProjection(int baseView,
                                 int viewCount,
                                 vec3 receiverWorld,
                                 out int selectedIndex,
                                 out ShadowProjection selectedProjection) {
    selectedIndex = -1;
    selectedProjection.valid = false;
    float bestMargin = -1.0;
    int count = min(viewCount, 6);
    for (int face = 0; face < 6; ++face) {
        if (face >= count) break;
        int candidateIndex = baseView + face;
        ShadowProjection candidate = projectShadow(u_Shadow.views[candidateIndex], receiverWorld);
        if (!candidate.valid) continue;
        vec2 edge = min(candidate.localUv, vec2(1.0) - candidate.localUv);
        float margin = min(edge.x, edge.y);
        if (margin > bestMargin) {
            bestMargin = margin;
            selectedIndex = candidateIndex;
            selectedProjection = candidate;
        }
    }
    return selectedIndex >= 0;
}

vec2 clampAtlasUv(LocalShadowView shadowView, vec2 uv) {
    vec2 halfTexel = shadowView.rangeTexel.yz * 0.5;
    vec2 minimum = shadowView.atlasScaleBias.zw + halfTexel;
    vec2 maximum = shadowView.atlasScaleBias.zw + shadowView.atlasScaleBias.xy - halfTexel;
    return clamp(uv, minimum, maximum);
}

float receiverPlaneBias(LocalShadowView shadowView,
                        vec3 receiverWorld,
                        vec3 normalWorld,
                        float worldTexel,
                        float receiverDepth) {
    vec3 reference = abs(normalWorld.y) < 0.95 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(reference, normalWorld));
    vec3 bitangent = normalize(cross(normalWorld, tangent));
    ShadowProjection tangentProjection = projectShadow(shadowView, receiverWorld + tangent * worldTexel);
    ShadowProjection bitangentProjection = projectShadow(shadowView, receiverWorld + bitangent * worldTexel);
    float tangentSlope = tangentProjection.valid ? abs(tangentProjection.depth - receiverDepth) : 0.0;
    float bitangentSlope = bitangentProjection.valid ? abs(bitangentProjection.depth - receiverDepth) : 0.0;
    return max(tangentSlope, bitangentSlope) * max(u_Cull.shadowParams.y, 0.0);
}

bool blockerAt(float storedDepth, float receiverDepth, float bias) {
    // Reversed-Z: larger depth is geometrically closer to the local light.
    return storedDepth > 0.0 && storedDepth > receiverDepth + bias;
}

float localShadowVisibility(LocalLight light,
                            vec3 viewPosition,
                            vec3 normalView,
                            ivec2 pixel,
                            uint lightIndex) {
    int baseView = int(floor(light.shadowInfo.x + 0.5));
    int viewCount = int(floor(light.shadowInfo.y + 0.5));
    if (baseView < 0 || viewCount <= 0 || light.shadowInfo.z <= 0.5) return 1.0;

    vec3 worldRelative = (u_Cull.inverseView * vec4(viewPosition, 0.0)).xyz;
    vec3 normalWorld = normalize(mat3(u_Cull.inverseView) * normalView);

    LocalShadowView baseShadowView = u_Shadow.views[baseView];
    vec3 lightRelative = worldRelative - baseShadowView.originNear.xyz;
    float distanceValue = max(length(lightRelative), baseShadowView.originNear.w);
    float faceResolution = max(u_Cull.shadowParams.w, 1.0);
    float worldTexel = max(2.0 * distanceValue * max(baseShadowView.rangeTexel.w, 1e-4) / faceResolution, 1e-5);
    vec3 receiverWorld = worldRelative + normalWorld * worldTexel * max(u_Cull.shadowParams.x, 0.0);

    int shadowIndex = baseView;
    ShadowProjection projected;
    if (viewCount >= 6) {
        if (!selectPointShadowProjection(baseView, viewCount, receiverWorld, shadowIndex, projected)) return 1.0;
    } else {
        projected = projectShadow(baseShadowView, receiverWorld);
        if (!projected.valid) return 1.0;
    }
    LocalShadowView shadowView = u_Shadow.views[shadowIndex];

    float bias = receiverPlaneBias(shadowView, receiverWorld, normalWorld, worldTexel, projected.depth);
    float filterRadius = max(u_Cull.shadowParams.z, 0.0);
    if (filterRadius <= 1e-4) {
        float storedDepth = textureLod(u_LocalShadowDepth, projected.atlasUv, 0.0).r;
        return blockerAt(storedDepth, projected.depth, bias) ? 0.0 : 1.0;
    }

    float rotation = hash12(vec2(pixel) + vec2(float(lightIndex) * 19.0, float(shadowIndex) * 7.0)) * 6.28318530718;
    float visible = 0.0;
    for (int i = 0; i < 16; ++i) {
        vec2 offset = rotateOffset(POISSON[i], rotation) * shadowView.rangeTexel.yz * filterRadius;
        vec2 sampleUv = clampAtlasUv(shadowView, projected.atlasUv + offset);
        float storedDepth = textureLod(u_LocalShadowDepth, sampleUv, 0.0).r;
        visible += blockerAt(storedDepth, projected.depth, bias) ? 0.0 : 1.0;
    }
    return visible * (1.0 / 16.0);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_LocalLighting);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    float depth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    if (!ownsGbufferPixel(uv, depth)) {
        imageStore(u_LocalLighting, pixel, vec4(0.0));
        return;
    }

    vec4 surface = textureLod(u_GbufferSurface, uv, 0.0);
    vec4 material = textureLod(u_GbufferMaterial, uv, 0.0);
    vec3 albedo = max(surface.rgb, vec3(0.0));
    float roughness = clamp(material.r, 0.045, 1.0);
    float metallic = clamp(material.g, 0.0, 1.0);
    float dielectricF0 = clamp(material.b, 0.0, 1.0);
    vec3 f0 = mix(vec3(dielectricF0), albedo, metallic);

    vec3 position = reconstructView(uv, depth);
    vec3 normal = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    vec3 viewDirection = normalize(-position);
    float ndotv = max(dot(normal, viewDirection), 0.0);
    if (ndotv <= 0.0) {
        imageStore(u_LocalLighting, pixel, vec4(0.0));
        return;
    }

    uint tileSize = uint(max(u_Cull.viewportLightCount.w, 1.0));
    uvec2 tileCount = uvec2(max(u_Cull.tileGrid.xy, vec2(1.0)));
    uvec2 tile = uvec2(pixel) / tileSize;
    uint tileIndex = tile.y * tileCount.x + tile.x;
    uint maxPerTile = uint(max(u_Cull.tileGrid.z, 1.0));
    uint count = min(u_Counts.counts[tileIndex], maxPerTile);
    uint base = tileIndex * maxPerTile;

    vec3 result = vec3(0.0);
    for (uint i = 0u; i < count; ++i) {
        uint lightIndex = u_Indices.indices[base + i];
        LocalLight light = u_Lights.lights[lightIndex];
        vec3 toLight = light.positionRadius.xyz - position;
        float distanceValue = length(toLight);
        float radius = light.positionRadius.w;
        if (distanceValue <= 1e-5 || distanceValue >= radius) continue;

        vec3 lightDirection = toLight / distanceValue;
        float ndotl = max(dot(normal, lightDirection), 0.0);
        if (ndotl <= 0.0) continue;

        int type = int(light.radianceType.w + 0.5);
        float sourceDistance = distanceValue;
        if (type == 2) sourceDistance = max(distanceValue - max(light.coneArea.y, 0.0), 1e-3);
        float normalizedDistance = clamp(distanceValue / max(radius, 1e-4), 0.0, 1.0);
        float rangeFade = 1.0 - normalizedDistance * normalizedDistance;
        rangeFade *= rangeFade;
        float attenuation = rangeFade / max(sourceDistance * sourceDistance, 1e-4);

        if (type == 1) {
            vec3 fromLight = -lightDirection;
            float coneCos = dot(fromLight, normalize(light.directionOuter.xyz));
            float outerCos = light.directionOuter.w;
            float innerCos = light.coneArea.x;
            if (coneCos <= outerCos) continue;
            attenuation *= innerCos > outerCos
                    ? smoothstep(outerCos, innerCos, coneCos)
                    : 1.0;
        }

        float shadowVisibility = localShadowVisibility(light, position, normal, pixel, lightIndex);
        if (shadowVisibility <= 0.0) continue;

        vec3 halfVector = normalize(viewDirection + lightDirection);
        float ndoth = max(dot(normal, halfVector), 0.0);
        float vdoth = max(dot(viewDirection, halfVector), 0.0);
        vec3 fresnel = fresnelSchlick(vdoth, f0);
        float distribution = ggxDistribution(ndoth, roughness);
        float visibility = smithGgxCorrelated(ndotv, ndotl, roughness);
        vec3 specularBrdf = fresnel * distribution * visibility;
        float diffuseTerm = burleyDiffuse(ndotv, ndotl, max(dot(lightDirection, halfVector), 0.0), roughness);
        vec3 diffuseBrdf = (vec3(1.0) - fresnel) * (1.0 - metallic) * albedo * diffuseTerm;
        vec3 intensity = max(light.radianceType.rgb, vec3(0.0));
        result += (diffuseBrdf + specularBrdf) * intensity * attenuation * ndotl * shadowVisibility;
    }

    imageStore(u_LocalLighting, pixel, vec4(result, 1.0));
}
