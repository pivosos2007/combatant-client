#version 430 core

/* Evaluates diffuse-convolved SH9 at the geometric/GTAO bent normal. */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_GbufferGeometry;
layout(binding = 1) uniform sampler2D u_BentNormal;
layout(binding = 2) uniform sampler2D u_ResolvedDepth;
layout(binding = 3) uniform sampler2D u_GbufferDepth;
layout(binding = 4, rgba16f) writeonly uniform image2D u_SkyDiffuseIrradiance;
layout(std430, binding = 5) readonly buffer SkyDiffuseSh { vec4 coefficients[]; } u_Sh;
layout(std430, binding = 6) readonly buffer SkyEnvironmentState { vec4 state0; vec4 state1; } u_State;
layout(std430, binding = 7) readonly buffer SkyResolveData { mat4 inverseView; vec4 flags; } u_Resolve;

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

float shBasis(int index, vec3 d) {
    if (index == 0) return 0.28209479177387814;
    if (index == 1) return 0.4886025119029199 * d.y;
    if (index == 2) return 0.4886025119029199 * d.z;
    if (index == 3) return 0.4886025119029199 * d.x;
    if (index == 4) return 1.0925484305920792 * d.x * d.y;
    if (index == 5) return 1.0925484305920792 * d.y * d.z;
    if (index == 6) return 0.31539156525252005 * (3.0 * d.z * d.z - 1.0);
    if (index == 7) return 1.0925484305920792 * d.x * d.z;
    return 0.5462742152960396 * (d.x * d.x - d.y * d.y);
}

bool ownsGbufferPixel(vec2 uv) {
    float currentDepth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    float gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    if (currentDepth <= 0.0 || gbufferDepth <= 0.0) return false;
    float tolerance = max(1.0e-6, abs(gbufferDepth) * 1.0e-5);
    return abs(currentDepth - gbufferDepth) <= tolerance;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_SkyDiffuseIrradiance);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    if (u_State.state0.x < 0.5 || !ownsGbufferPixel(uv)) {
        imageStore(u_SkyDiffuseIrradiance, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec3 viewNormal = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    if (u_Resolve.flags.x > 0.5) {
        vec3 bent = textureLod(u_BentNormal, uv, 0.0).xyz;
        if (dot(bent, bent) > 1e-5) viewNormal = normalize(bent);
    }
    vec3 worldNormal = normalize(mat3(u_Resolve.inverseView) * viewNormal);

    vec3 irradiance = vec3(0.0);
    for (int i = 0; i < 9; ++i) {
        irradiance += u_Sh.coefficients[i].rgb * shBasis(i, worldNormal);
    }
    imageStore(u_SkyDiffuseIrradiance, pixel, vec4(max(irradiance, vec3(0.0)), 1.0));
}
