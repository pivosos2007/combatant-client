#version 430 core

/*
 * Combatant GTAO raw horizon evaluation.
 * Reference-class baseline: half resolution, 2 slices, 3 steps per direction, radius in blocks.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_ResolvedDepth;
layout(binding = 1) uniform sampler2D u_GbufferGeometry;
layout(binding = 2) uniform sampler2D u_GbufferDepth;
layout(binding = 3, rgba16f) writeonly uniform image2D u_RawSignal;
layout(binding = 4, rgba16f) writeonly uniform image2D u_RawDiagnostics;
layout(binding = 5, rgba16f) writeonly uniform image2D u_ViewNormal;
layout(binding = 6, r32f) writeonly uniform image2D u_ViewDepth;
layout(binding = 7, rg16f) writeonly uniform image2D u_RadiusFootprint;

layout(std430, binding = 8) readonly buffer AmbientOcclusionData {
    mat4 inverseProjection;
    mat4 projection;
    vec4 depthTransform; // xy: depth -> NDC scale/bias
    vec4 params0;        // x: radius, y: frame id, z: full width, w: full height
} u_Ao;

const float PI = 3.14159265358979323846;
const float HALF_PI = 1.57079632679489661923;
const float GTAO_FALLOFF_START = 0.75;
const int GTAO_SLICES = 2;
const int GTAO_HORIZON_STEPS = 3;

vec2 signNotZero(vec2 v) {
    return vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
}

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * signNotZero(n.xy);
    float l2 = dot(n, n);
    return l2 > 1.0e-12 ? n * inversesqrt(l2) : vec3(0.0, 0.0, 1.0);
}

// Interleaved-gradient noise keeps the spatial sampling pattern high-frequency without
// the low-frequency clumps of an independent white hash. The pattern is frame-stable;
// temporal variation is added separately with the R2 sequence below.
float interleavedGradientNoise(vec2 pixel, float phase) {
    vec2 p = pixel + vec2(phase * 47.0, phase * 131.0);
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

vec3 reconstructView(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Ao.depthTransform.x + u_Ao.depthTransform.y;
    vec4 h = u_Ao.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    if (abs(h.w) < 1.0e-7) return vec3(0.0);
    return h.xyz / h.w;
}

vec2 projectUv(vec3 viewPosition) {
    vec4 clip = u_Ao.projection * vec4(viewPosition, 1.0);
    if (abs(clip.w) < 1.0e-7) return vec2(-2.0);
    return (clip.xy / clip.w) * 0.5 + 0.5;
}

bool ownsPixel(vec2 uv, out float depth) {
    depth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    float gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    if (depth <= 0.0 || gbufferDepth <= 0.0) return false;
    float tolerance = max(1.0e-6, abs(gbufferDepth) * 1.0e-5);
    return abs(depth - gbufferDepth) <= tolerance;
}

float integrateArc(vec2 h, float n, float cosN) {
    vec2 value = cosN + 2.0 * h * sin(n) - cos(2.0 * h - n);
    return 0.25 * (value.x + value.y);
}

float maximumHorizonAngle(
        vec3 viewSliceDirection,
        vec3 viewerDirection,
        vec2 centerUv,
        vec3 centerView,
        float radius,
        float dither,
        out float validSamples,
        out float stepFootprintPixels) {
    float stepSize = radius / float(GTAO_HORIZON_STEPS);
    vec2 nextUv = projectUv(centerView + viewSliceDirection * stepSize);
    vec2 rayStep = nextUv - centerUv;
    float rayLength = length(rayStep);
    if (!(rayLength > 1.0e-8)) return PI;

    float fullMinExtent = max(1.0, min(u_Ao.params0.z, u_Ao.params0.w));
    stepFootprintPixels = max(stepFootprintPixels, rayLength * fullMinExtent);
    float onePixelUv = 1.0 / fullMinExtent;
    float selfNudge = min(1.0, dither + onePixelUv / rayLength);
    vec2 rayUv = centerUv + rayStep * selfNudge;

    float maximumCosine = -1.0;
    for (int stepIndex = 0; stepIndex < GTAO_HORIZON_STEPS; ++stepIndex, rayUv += rayStep) {
        if (any(lessThanEqual(rayUv, vec2(0.0))) || any(greaterThanEqual(rayUv, vec2(1.0)))) break;

        float sampleDepth;
        if (!ownsPixel(rayUv, sampleDepth)) continue;
        vec3 sampleView = reconstructView(rayUv, sampleDepth);
        vec3 offset = sampleView - centerView;
        float distanceSquared = dot(offset, offset);
        if (!(distanceSquared > 1.0e-8)) continue;

        float distanceValue = sqrt(distanceSquared);
        if (distanceValue > radius) continue;
        validSamples += 1.0;

        float inverseDistance = 1.0 / distanceValue;
        float distanceFalloff = clamp((distanceValue - GTAO_FALLOFF_START * radius)
                / max((1.0 - GTAO_FALLOFF_START) * radius, 1.0e-5), 0.0, 1.0);
        float cosine = dot(viewerDirection, offset) * inverseDistance;
        cosine = mix(cosine, -1.0, distanceFalloff);
        maximumCosine = max(maximumCosine, cosine);
    }

    return acos(clamp(maximumCosine, -1.0, 1.0));
}

void storeNeutral(ivec2 pixel) {
    imageStore(u_RawSignal, pixel, vec4(1.0, 0.0, 0.0, 1.0));
    imageStore(u_RawDiagnostics, pixel, vec4(0.0));
    imageStore(u_ViewNormal, pixel, vec4(0.0, 0.0, 1.0, 1.0));
    imageStore(u_ViewDepth, pixel, vec4(0.0));
    imageStore(u_RadiusFootprint, pixel, vec4(0.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(u_RawSignal);
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(outputSize);
    float centerDepth;
    if (!ownsPixel(uv, centerDepth)) {
        storeNeutral(pixel);
        return;
    }

    vec3 normal = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    vec3 centerView = reconstructView(uv, centerDepth);
    float centerDistanceSquared = dot(centerView, centerView);
    if (!(centerDistanceSquared > 1.0e-10)) {
        storeNeutral(pixel);
        return;
    }
    vec3 viewerDirection = normalize(-centerView);

    float configuredRadius = max(u_Ao.params0.x, 0.05);
    float nearScale = max(0.5, 0.25 + 0.75 * smoothstep(0.0, 81.0, centerDistanceSquared));
    float radius = configuredRadius * nearScale;

    vec3 referenceUp = abs(viewerDirection.y) < 0.98 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 viewerRight = normalize(cross(referenceUp, viewerDirection));
    vec3 viewerUp = normalize(cross(viewerDirection, viewerRight));

    // Keep the spatial noise field stable.  Re-hashing pixel+frame independently each
    // frame turns a low-sample GTAO signal into white temporal noise: every pixel
    // changes phase unrelated to its neighbours, so even a converged history keeps a
    // visibly boiling raw input.  Advance a stable per-pixel seed with the same class
    // of low-discrepancy R2 sequence used by the reference implementation instead.
    vec2 pixelCenter = vec2(pixel) + 0.5;
    vec2 spatialDither = vec2(
            interleavedGradientNoise(pixelCenter, 0.0),
            interleavedGradientNoise(pixelCenter.yx + vec2(23.0, 71.0), 0.5));
    const float plasticConstant = 1.32471795724474602596;
    const vec2 r2Alpha = 1.0 / vec2(plasticConstant, plasticConstant * plasticConstant);
    float frame = mod(u_Ao.params0.y, 4096.0);
    vec2 dither = fract(spatialDither + frame * r2Alpha);
    float ditherAngle = dither.x;
    float ditherStep = dither.y;

    float visibilitySum = 0.0;
    vec3 bentSum = vec3(0.0);
    vec2 horizonDebug = vec2(0.0);
    float validSamples = 0.0;
    float stepFootprintPixels = 0.0;

    for (int slice = 0; slice < GTAO_SLICES; ++slice) {
        float sliceAngle = (float(slice) + ditherAngle) * (PI / float(GTAO_SLICES));
        vec3 viewSliceDirection = normalize(viewerRight * cos(sliceAngle) + viewerUp * sin(sliceAngle));
        vec3 axis = normalize(cross(viewSliceDirection, viewerDirection));
        vec3 projectedNormal = normal - axis * dot(normal, axis);
        float projectedLengthSquared = dot(projectedNormal, projectedNormal);
        if (!(projectedLengthSquared > 1.0e-8)) continue;

        float projectedLength = sqrt(projectedLengthSquared);
        projectedNormal /= projectedLength;
        vec3 orthoDirection = normalize(viewSliceDirection - viewerDirection * dot(viewSliceDirection, viewerDirection));
        float signGamma = dot(orthoDirection, projectedNormal) < 0.0 ? -1.0 : 1.0;
        float cosGamma = clamp(dot(projectedNormal, viewerDirection), 0.0, 1.0);
        float gamma = signGamma * acos(cosGamma);

        vec2 horizons;
        horizons.x = maximumHorizonAngle(-viewSliceDirection, viewerDirection, uv, centerView,
                radius, ditherStep, validSamples, stepFootprintPixels);
        horizons.y = maximumHorizonAngle(viewSliceDirection, viewerDirection, uv, centerView,
                radius, ditherStep, validSamples, stepFootprintPixels);
        horizonDebug += horizons / PI;

        horizons = gamma + clamp(vec2(-1.0, 1.0) * horizons - gamma,
                vec2(-HALF_PI), vec2(HALF_PI));
        visibilitySum += clamp(integrateArc(horizons, gamma, cosGamma) * projectedLength, 0.0, 1.0);

        float bentAngle = 0.5 * (horizons.x + horizons.y);
        bentSum += viewerDirection * cos(bentAngle) + orthoDirection * sin(bentAngle);
    }

    float visibility = clamp(visibilitySum / float(GTAO_SLICES), 0.0, 1.0);
    const float surroundingAlbedo = 0.2;
    visibility /= max(surroundingAlbedo * visibility + (1.0 - surroundingAlbedo), 1.0e-4);
    visibility = clamp(visibility, 0.0, 1.0);

    vec3 bentNormal = dot(bentSum, bentSum) > 1.0e-8 ? normalize(bentSum) : normal;
    bentNormal = normalize(bentNormal - 0.5 * viewerDirection);
    if (dot(bentNormal, normal) <= 0.05) bentNormal = normal;

    float linearDepth = max(-centerView.z, 0.0);
    float validRatio = clamp(validSamples / float(GTAO_SLICES * GTAO_HORIZON_STEPS * 2), 0.0, 1.0);
    horizonDebug /= float(GTAO_SLICES);
    imageStore(u_RawSignal, pixel, vec4(visibility, bentNormal));
    imageStore(u_RawDiagnostics, pixel,
            vec4(clamp(horizonDebug, 0.0, 1.0), validRatio, clamp(radius / 8.0, 0.0, 1.0)));
    imageStore(u_ViewNormal, pixel, vec4(normal, 1.0));
    imageStore(u_ViewDepth, pixel, vec4(linearDepth, 0.0, 0.0, 0.0));
    imageStore(u_RadiusFootprint, pixel,
            vec4(clamp(radius / 8.0, 0.0, 1.0), clamp(stepFootprintPixels / 32.0, 0.0, 1.0), 0.0, 0.0));
}
