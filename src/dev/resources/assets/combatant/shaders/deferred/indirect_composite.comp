layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_BaseRadiance;
layout(binding = 1) uniform sampler2D u_IndirectLight;
layout(binding = 2) uniform sampler2D u_IndirectConfidence;
layout(binding = 3) uniform sampler2D u_GbufferSurface;
layout(binding = 4) uniform sampler2D u_GbufferMaterial;
layout(binding = 5) uniform sampler2D u_AmbientVisibility;
layout(binding = 6) uniform sampler2D u_GbufferDepth;
layout(binding = 7) uniform sampler2D u_CurrentDepth;
layout(binding = 8, rgba16f) writeonly uniform image2D u_LightingColor;

layout(std430, binding = 9) readonly buffer IndirectCompositeData {
    // x: indirect valid, y: AO valid.
    vec4 flags;
} u_Composite;

bool ownsGbufferPixel(vec2 uv) {
    float gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    float currentDepth = textureLod(u_CurrentDepth, uv, 0.0).r;
    if (gbufferDepth <= 0.0 || currentDepth <= 0.0) return false;
    float tolerance = max(1.0e-6, abs(gbufferDepth) * 1.0e-5);
    return abs(gbufferDepth - currentDepth) <= tolerance;
}

float liftedMaterialAo(float value) {
    float lifted = (1.5 * value) / max(1.0 + 0.5 * value, 1e-5);
    return mix(1.0, lifted, 0.9);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_LightingColor);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec4 base = textureLod(u_BaseRadiance, uv, 0.0);
    vec4 surface = textureLod(u_GbufferSurface, uv, 0.0);
    if (!ownsGbufferPixel(uv) || u_Composite.flags.x < 0.5) {
        imageStore(u_LightingColor, pixel, base);
        return;
    }

    vec4 material = textureLod(u_GbufferMaterial, uv, 0.0);
    vec3 incomingDiffuse = textureLod(u_IndirectLight, uv, 0.0).rgb;
    float confidence = clamp(textureLod(u_IndirectConfidence, uv, 0.0).r, 0.0, 1.0);
    float screenVisibility = u_Composite.flags.y > 0.5
            ? clamp(textureLod(u_AmbientVisibility, uv, 0.0).r, 0.0, 1.0)
            : 1.0;

    float materialAo = clamp(surface.a, 0.0, 1.0);
    if (u_Composite.flags.y > 0.5) materialAo = liftedMaterialAo(materialAo);
    float metallic = clamp(material.g, 0.0, 1.0);
    float dielectricF0 = clamp(material.b, 0.0, 1.0);
    vec3 f0 = mix(vec3(dielectricF0), max(surface.rgb, vec3(0.0)), metallic);
    vec3 diffuseReflectance = max(surface.rgb, vec3(0.0)) * (vec3(1.0) - f0) * (1.0 - metallic);

    // INDIRECT_LIGHT is a cosine-weighted screen-space incoming-radiance estimate. The diffuse
    // energy share is reduced by the material's specular F0 instead of being added on top of it.
    vec3 indirectDiffuse = incomingDiffuse * diffuseReflectance
            * materialAo * screenVisibility * confidence;
    imageStore(u_LightingColor, pixel, vec4(base.rgb + indirectDiffuse, base.a));
}
