layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_Color;
layout(binding = 1) uniform sampler2D u_Confidence;
layout(binding = 2) uniform sampler2D u_Lock;
layout(binding = 3, rgba16f) writeonly uniform image2D u_HistoryColor;
layout(binding = 4, r8) writeonly uniform image2D u_HistoryConfidence;
layout(binding = 5, r8) writeonly uniform image2D u_HistoryLock;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_HistoryColor);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    imageStore(u_HistoryColor, pixel, textureLod(u_Color, uv, 0.0));
    imageStore(u_HistoryConfidence, pixel, vec4(textureLod(u_Confidence, uv, 0.0).r, 0.0, 0.0, 0.0));
    imageStore(u_HistoryLock, pixel, vec4(textureLod(u_Lock, uv, 0.0).r, 0.0, 0.0, 0.0));
}
