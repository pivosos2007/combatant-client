layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_CurrentColor;
layout(binding = 1, rgba16f) writeonly uniform image2D u_OutputColor;
layout(binding = 2, r8) writeonly uniform image2D u_OutputConfidence;
layout(binding = 3, r8) writeonly uniform image2D u_OutputLock;
layout(binding = 4, r8) writeonly uniform image2D u_HistoryWeight;
layout(binding = 5, r8) writeonly uniform image2D u_RejectionMask;

layout(std430, binding = 6) readonly buffer TaaInitParams {
    vec4 currentJitterAndRender; // xy=current jitter in render pixels, zw=render extent
} u_Taa;

float catmullWeight(float x) {
    x = abs(x);
    if (x <= 1.0) return 1.5 * x * x * x - 2.5 * x * x + 1.0;
    if (x < 2.0) return -0.5 * x * x * x + 2.5 * x * x - 4.0 * x + 2.0;
    return 0.0;
}

vec4 sampleCatmullRom(sampler2D tex, vec2 uv) {
    ivec2 size = textureSize(tex, 0);
    vec2 position = uv * vec2(size) - 0.5;
    ivec2 base = ivec2(floor(position));
    vec2 fraction = position - floor(position);
    vec4 sum = vec4(0.0);
    float weightSum = 0.0;
    for (int y = -1; y <= 2; ++y) {
        float wy = catmullWeight(float(y) - fraction.y);
        for (int x = -1; x <= 2; ++x) {
            float wx = catmullWeight(float(x) - fraction.x);
            float w = wx * wy;
            ivec2 samplePixel = clamp(base + ivec2(x, y), ivec2(0), size - ivec2(1));
            sum += texelFetch(tex, samplePixel, 0) * w;
            weightSum += w;
        }
    }
    return sum / max(weightSum, 1e-6);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(u_OutputColor);
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec2 outputUv = (vec2(pixel) + 0.5) / vec2(outputSize);
    vec2 renderExtent = max(u_Taa.currentJitterAndRender.zw, vec2(1.0));
    vec2 currentUv = outputUv + u_Taa.currentJitterAndRender.xy / renderExtent;
    currentUv = clamp(currentUv, vec2(0.0), vec2(1.0));

    vec4 current = sampleCatmullRom(u_CurrentColor, currentUv);
    imageStore(u_OutputColor, pixel, current);
    imageStore(u_OutputConfidence, pixel, vec4(0.08, 0.0, 0.0, 0.0));
    imageStore(u_OutputLock, pixel, vec4(0.0));
    imageStore(u_HistoryWeight, pixel, vec4(0.0));
    // 1.0 is the explicit "history lifecycle invalid/reset" debug category.
    imageStore(u_RejectionMask, pixel, vec4(1.0, 0.0, 0.0, 0.0));
}
