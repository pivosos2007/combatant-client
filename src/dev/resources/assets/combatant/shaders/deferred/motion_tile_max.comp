#version 430 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_Velocity;
layout(binding = 1) uniform sampler2D u_Validity;
layout(binding = 2, rg16f) writeonly uniform image2D u_TileMax;
layout(std430, binding = 3) readonly buffer MotionParams { vec4 extent; vec4 policy; mat4 inverseProjection; vec4 depthTransform; } u_Params;

void main() {
    ivec2 tile = ivec2(gl_GlobalInvocationID.xy);
    ivec2 tileCount = imageSize(u_TileMax);
    if (any(greaterThanEqual(tile, tileCount))) return;
    ivec2 outputSize = max(ivec2(u_Params.extent.xy + 0.5), ivec2(1));
    int tileSize = max(1, int(u_Params.extent.z + 0.5));
    vec2 best = vec2(0.0);
    float bestLength = 0.0;
    for (int y = 0; y < 32; ++y) {
        if (y >= tileSize) break;
        for (int x = 0; x < 32; ++x) {
            if (x >= tileSize) break;
            ivec2 op = tile * tileSize + ivec2(x, y);
            if (any(greaterThanEqual(op, outputSize))) continue;
            vec2 uv = (vec2(op) + 0.5) / vec2(outputSize);
            if (textureLod(u_Validity, uv, 0.0).r < 0.5) continue;
            vec2 velocityPixels = textureLod(u_Velocity, uv, 0.0).xy * vec2(outputSize);
            float lengthPixels = length(velocityPixels);
            if (lengthPixels > bestLength) {
                bestLength = lengthPixels;
                best = velocityPixels;
            }
        }
    }
    imageStore(u_TileMax, tile, vec4(best, 0.0, 1.0));
}
