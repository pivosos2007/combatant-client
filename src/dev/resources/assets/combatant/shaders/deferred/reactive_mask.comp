#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_GbufferDepth;
layout(binding = 1) uniform sampler2D u_ResolvedDepth;
layout(binding = 2) uniform usampler2D u_MaterialId;
layout(binding = 3, r8) writeonly uniform image2D u_ReactiveMask;
layout(std430, binding = 4) readonly buffer ReactiveParams { vec4 params; } u_Params;

struct TemporalPolicyEntry {
    uint materialId;
    uint occupied;
    uint pad0;
    uint pad1;
    vec4 policy;
};
layout(std430, binding = 5) readonly buffer TemporalPolicies { TemporalPolicyEntry entries[]; } u_Policies;

uint hashMaterial(uint id) { return id * 2654435761u; }

float materialReactive(uint materialId) {
    uint mask = uint(max(u_Params.params.x, 0.0));
    uint maxProbes = uint(max(u_Params.params.y, 1.0));
    uint slot = hashMaterial(materialId) & mask;
    for (uint probe = 0u; probe < maxProbes; ++probe) {
        TemporalPolicyEntry entry = u_Policies.entries[(slot + probe) & mask];
        if (entry.occupied == 0u) break;
        if (entry.materialId == materialId) return clamp(entry.policy.x, 0.0, 1.0);
    }
    // Unknown material is explicit uncertainty: reject history rather than pretend it is stable.
    return 1.0;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_ReactiveMask);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float resolvedDepth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    if (resolvedDepth <= 0.0) {
        imageStore(u_ReactiveMask, pixel, vec4(0.0));
        return;
    }

    float gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    float tolerance = max(1e-6, abs(gbufferDepth) * max(u_Params.params.z, 1e-7));
    if (gbufferDepth <= 0.0 || abs(resolvedDepth - gbufferDepth) > tolerance) {
        // Forward geometry has no G-buffer material policy yet; remain conservative.
        imageStore(u_ReactiveMask, pixel, vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }

    uint materialId = textureLod(u_MaterialId, uv, 0.0).r;
    imageStore(u_ReactiveMask, pixel, vec4(materialReactive(materialId), 0.0, 0.0, 0.0));
}
