#version 430 core
#extension GL_ARB_shader_texture_image_samples : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_BaseVelocity;
layout(binding = 1) uniform sampler2D u_BaseValidity;
layout(binding = 2) uniform sampler2D u_BaseReactive;
layout(binding = 3) uniform sampler2DMS u_RasterVelocity;
layout(binding = 4) uniform sampler2DMS u_RasterValidity;
layout(binding = 5) uniform sampler2DMS u_RasterReactive;
layout(binding = 6) uniform sampler2DMS u_RasterCoverage;
layout(binding = 7, rg16f) writeonly uniform image2D u_FinalVelocity;
layout(binding = 8, r8) writeonly uniform image2D u_FinalValidity;
layout(binding = 9, r8) writeonly uniform image2D u_FinalReactive;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_FinalVelocity);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 velocity = texelFetch(u_BaseVelocity, pixel, 0).rg;
    float validity = texelFetch(u_BaseValidity, pixel, 0).r;
    float reactive = texelFetch(u_BaseReactive, pixel, 0).r;

    int sampleCount = textureSamples(u_RasterValidity);
    bool covered = false;
    bool selectedValidMotion = false;
    for (int sampleIndex = 0; sampleIndex < sampleCount; ++sampleIndex) {
        reactive = max(reactive, texelFetch(u_RasterReactive, pixel, sampleIndex).r);
        float sampleCoverage = texelFetch(u_RasterCoverage, pixel, sampleIndex).r;
        if (sampleCoverage <= 0.5) continue;

        float sampleValidity = texelFetch(u_RasterValidity, pixel, sampleIndex).r;
        vec2 sampleVelocity = texelFetch(u_RasterVelocity, pixel, sampleIndex).rg;

        // The first covered sample establishes ownership even when motion is unavailable. If any
        // covered sample has valid motion, prefer it without ever falling back to opaque motion.
        if (!covered || (!selectedValidMotion && sampleValidity > 0.5)) {
            velocity = sampleVelocity;
            validity = sampleValidity;
        }
        covered = true;
        selectedValidMotion = selectedValidMotion || sampleValidity > 0.5;
    }

    imageStore(u_FinalVelocity, pixel, vec4(velocity, 0.0, 0.0));
    imageStore(u_FinalValidity, pixel, vec4(validity, 0.0, 0.0, 0.0));
    imageStore(u_FinalReactive, pixel, vec4(reactive, 0.0, 0.0, 0.0));
}
