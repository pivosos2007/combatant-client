#version 430 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_GbufferGeometry;
layout(binding = 1) uniform sampler2D u_GbufferMaterial;
layout(binding = 2) uniform sampler2D u_GbufferDepth;
layout(binding = 3) uniform sampler2D u_ResolvedDepth;
layout(rgba16f, binding = 4) writeonly uniform image2D u_Output;
layout(std430, binding = 5) readonly buffer DebugParams {
    vec4 decode;
    vec4 aux;      // x=hist bins, y=far plane, zw=depth->NDC scale/bias
    vec4 extent;   // xy=render/source extent, zw=debug output extent
    mat4 inverseProjection;
    mat4 projection;
} u_Params;

vec3 reconstructView(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Params.aux.z + u_Params.aux.w;
    vec4 h = u_Params.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    if (abs(h.w) < 1.0e-7) return vec3(0.0);
    return h.xyz / h.w;
}

float projectDepth(vec3 viewPosition, out vec2 uv) {
    vec4 clip = u_Params.projection * vec4(viewPosition, 1.0);
    if (abs(clip.w) < 1.0e-7) {
        uv = vec2(-1.0);
        return 0.0;
    }
    vec3 ndc = clip.xyz / clip.w;
    uv = ndc.xy * 0.5 + 0.5;
    return (ndc.z - u_Params.aux.w) / max(u_Params.aux.z, 1.0e-7);
}

bool ownsGbufferPixel(vec2 uv, out float gbufferDepth, out float resolvedDepth) {
    gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    resolvedDepth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    if (gbufferDepth <= 0.0 || resolvedDepth <= 0.0) return false;
    float tolerance = max(1.0e-6, abs(gbufferDepth) * 1.0e-5);
    return abs(gbufferDepth - resolvedDepth) <= tolerance;
}

float depthDiscontinuity(vec2 uv, float centerDepth) {
    if (centerDepth <= 0.0) return 0.0;
    vec3 center = reconstructView(uv, centerDepth);
    float centerLinear = max(-center.z, 1.0e-4);
    vec2 texel = 1.0 / max(u_Params.extent.xy, vec2(1.0));
    const vec2 offsets[4] = vec2[](vec2(1.0, 0.0), vec2(-1.0, 0.0), vec2(0.0, 1.0), vec2(0.0, -1.0));
    float maximum = 0.0;
    for (int i = 0; i < 4; ++i) {
        vec2 sampleUv = clamp(uv + offsets[i] * texel, vec2(0.0), vec2(1.0));
        float d = textureLod(u_ResolvedDepth, sampleUv, 0.0).r;
        if (d <= 0.0) {
            maximum = 1.0;
            continue;
        }
        vec3 samplePosition = reconstructView(sampleUv, d);
        float relative = abs((-samplePosition.z) - centerLinear) / centerLinear;
        maximum = max(maximum, relative);
    }
    return clamp(maximum * 8.0, 0.0, 1.0);
}

vec3 signedLogPosition(vec3 position) {
    float farPlane = max(u_Params.aux.y, 1.0);
    float denom = log2(1.0 + farPlane);
    vec3 compressed = sign(position) * log2(vec3(1.0) + abs(position)) / max(denom, 1.0e-4);
    return clamp(vec3(0.5) + 0.5 * compressed, 0.0, 1.0);
}

void main() {
    ivec2 outputSize = imageSize(u_Output);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(outputSize);
    float gbufferDepth;
    float resolvedDepth;
    bool ownsPixel = ownsGbufferPixel(uv, gbufferDepth, resolvedDepth);
    int mode = int(u_Params.decode.x + 0.5);
    vec3 rgb = vec3(0.0);

    if (mode == 20) {
        // This is the current production reflection-trace eligibility contract: every pixel owned
        // by the terrain G-buffer is trace-eligible. Material gating is intentionally not invented
        // in a debug shader; a white rough terrain mask therefore proves the current over-broad policy.
        // Touch geometry/material as part of the shared-input integrity check so this view also
        // catches non-finite G-buffer payloads instead of silently validating depth alone.
        vec4 geometry = textureLod(u_GbufferGeometry, uv, 0.0);
        vec4 material = textureLod(u_GbufferMaterial, uv, 0.0);
        bool finitePayload = !any(isnan(geometry)) && !any(isinf(geometry))
                && !any(isnan(material)) && !any(isinf(material));
        rgb = vec3(ownsPixel && finitePayload ? 1.0 : 0.0);
    } else if (mode == 21) {
        rgb = ownsPixel ? signedLogPosition(reconstructView(uv, resolvedDepth)) : vec3(0.0);
    } else if (mode == 22) {
        if (ownsPixel) {
            vec3 position = reconstructView(uv, resolvedDepth);
            vec2 reprojectedUv;
            float reprojectedDepth = projectDepth(position, reprojectedUv);
            vec2 renderExtent = max(u_Params.extent.xy, vec2(1.0));
            float uvErrorPixels = length((reprojectedUv - uv) * renderExtent);
            float depthError = abs(reprojectedDepth - resolvedDepth);
            rgb = vec3(clamp(uvErrorPixels, 0.0, 1.0), clamp(depthError * 65536.0, 0.0, 1.0), 0.0);
        }
    } else if (mode == 23) {
        rgb = vec3(depthDiscontinuity(uv, resolvedDepth));
    } else if (mode == 24) {
        vec2 renderExtent = max(u_Params.extent.xy, vec2(1.0));
        vec2 outputExtent = max(u_Params.extent.zw, vec2(1.0));
        vec2 ratio = renderExtent / outputExtent;
        vec2 renderCoord = uv * renderExtent;
        vec2 local = abs(fract(renderCoord) - 0.5) * 2.0;
        float sourcePixelGrid = step(0.92, max(local.x, local.y));
        float exactOneToOne = all(lessThan(abs(ratio - vec2(1.0)), vec2(1.0e-5))) ? 1.0 : 0.0;
        rgb = vec3(clamp(ratio.x, 0.0, 1.0), clamp(ratio.y, 0.0, 1.0), mix(sourcePixelGrid, 1.0, exactOneToOne));
    } else {
        rgb = vec3(1.0, 0.0, 1.0);
    }

    imageStore(u_Output, pixel, vec4(rgb, 1.0));
}
