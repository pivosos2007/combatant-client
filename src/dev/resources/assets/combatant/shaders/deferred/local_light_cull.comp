#version 430 core

/* One invocation owns one 16x16 tile and builds a bounded deterministic light list. */
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct LocalLight {
    vec4 positionRadius;
    vec4 radianceType;
    vec4 directionOuter;
    vec4 coneArea;
    vec4 shadowInfo;
};

layout(std430, binding = 0) readonly buffer LocalLightData { LocalLight lights[]; } u_Lights;
layout(std430, binding = 1) readonly buffer LocalLightCullData {
    mat4 projection;
    mat4 inverseProjection;
    mat4 inverseView;
    // x: viewport width, y: viewport height, z: light count, w: tile size.
    vec4 viewportLightCount;
    // x: tile count x, y: tile count y, z: max lights per tile, w: depth NDC convention.
    vec4 tileGrid;
    vec4 shadowParams;
} u_Cull;
layout(std430, binding = 2) writeonly buffer LocalLightTileCounts { uint counts[]; } u_Counts;
layout(std430, binding = 3) writeonly buffer LocalLightTileIndices { uint indices[]; } u_Indices;

bool overlapsTile(LocalLight light, vec2 tileMinNdc, vec2 tileMaxNdc) {
    vec3 p = light.positionRadius.xyz;
    float radius = max(light.positionRadius.w, 0.0);
    float depth = -p.z;
    if (radius <= 0.0 || depth + radius <= 1e-5) return false;

    vec4 clip = u_Cull.projection * vec4(p, 1.0);
    if (abs(clip.w) <= 1e-6) return false;
    vec2 center = clip.xy / clip.w;
    float safeDepth = max(depth, 1e-4);
    vec2 extent = vec2(abs(u_Cull.projection[0][0]), abs(u_Cull.projection[1][1])) * radius / safeDepth;
    vec2 lightMin = center - extent;
    vec2 lightMax = center + extent;
    return lightMax.x >= tileMinNdc.x && lightMin.x <= tileMaxNdc.x
        && lightMax.y >= tileMinNdc.y && lightMin.y <= tileMaxNdc.y;
}

void main() {
    uvec2 tile = gl_GlobalInvocationID.xy;
    uvec2 tileCount = uvec2(max(u_Cull.tileGrid.xy, vec2(1.0)));
    if (any(greaterThanEqual(tile, tileCount))) return;

    uint tileIndex = tile.y * tileCount.x + tile.x;
    uint tileSize = uint(max(u_Cull.viewportLightCount.w, 1.0));
    vec2 viewport = max(u_Cull.viewportLightCount.xy, vec2(1.0));
    vec2 pixelMin = vec2(tile * tileSize);
    vec2 pixelMax = min(pixelMin + vec2(tileSize), viewport);
    vec2 tileMinNdc = pixelMin / viewport * 2.0 - 1.0;
    vec2 tileMaxNdc = pixelMax / viewport * 2.0 - 1.0;

    uint lightCount = uint(max(u_Cull.viewportLightCount.z, 0.0));
    uint maxPerTile = uint(max(u_Cull.tileGrid.z, 1.0));
    uint count = 0u;
    uint base = tileIndex * maxPerTile;
    for (uint lightIndex = 0u; lightIndex < lightCount; ++lightIndex) {
        if (!overlapsTile(u_Lights.lights[lightIndex], tileMinNdc, tileMaxNdc)) continue;
        if (count < maxPerTile) {
            u_Indices.indices[base + count] = lightIndex;
            count++;
        } else {
            break;
        }
    }
    u_Counts.counts[tileIndex] = count;
}
