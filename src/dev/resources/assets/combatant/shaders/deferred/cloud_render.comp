#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 6) uniform sampler2D u_ResolvedDepth;
layout(binding = 10) uniform sampler3D u_CloudOccupancy;
layout(binding = 1, rgba16f) writeonly uniform image2D u_CloudRadiance;
layout(binding = 2, r32f) writeonly uniform image2D u_CloudDepth;
layout(binding = 7, rgba16f) writeonly uniform image2D u_CloudReprojectionData;

layout(std430, binding = 3) readonly buffer CloudRenderData {
    mat4 inverseProjection;
    mat4 inverseView;
    vec4 cameraTime;
    vec4 grid;
    vec4 macroGrid;
    vec4 macroOrigin;
    vec4 counts;
    vec4 quality;
    vec4 lodPolicy;
    vec4 sunDirection;
    vec4 sunRadiance;
    vec4 noiseDomain;
    vec4 lightingPolicy;
    vec4 occupancyDomain;
    vec4 occupancyPolicy;
} u_Data;
layout(std430, binding = 8) readonly buffer SkyDiffuseSh {
    vec4 coefficients[];
} u_SkySh;

const float PI = 3.14159265358979323846;
const float SH_Y00 = 0.28209479177387814;
const int MAX_PRIMARY_STEPS = 192;
const int MAX_LIGHT_STEPS = 8;
const int MAX_SCATTERING_ORDERS = 4;
const int MAX_REGIONS = 8;
const int MAX_TRAVERSAL_ITERATIONS = 384;

vec3 worldRay(vec2 uv) {
    float ndcZ = u_Data.counts.z > 0.5 ? 0.5 : 0.0;
    vec4 view = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    vec3 viewDirection = normalize(view.xyz / max(abs(view.w), 1e-7) * sign(view.w));
    return normalize(mat3(u_Data.inverseView) * viewDirection);
}

float sceneDistance(vec2 uv) {
    float depth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    if (depth <= 0.0) return -1.0;
    float ndcZ = u_Data.counts.z > 0.5 ? depth : depth * 2.0 - 1.0;
    vec4 view = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    if (abs(view.w) < 1e-7) return -1.0;
    return length(view.xyz / view.w);
}

#define COMBATANT_CLOUD_WEATHER_BINDING 4
#define COMBATANT_CLOUD_DOMAIN_BINDING 5
#define COMBATANT_CLOUD_MACRO_WEATHER_BINDING 9
#moj_import <combatant:deferred_cloud_density.glsl>

bool domainRayInterval(CloudDomain domain, vec3 ray, float maxDistance, out float startT, out float endT) {
    float minimumY = domain.envelope.x;
    float maximumY = domain.envelope.y;
    float cameraY = u_Data.cameraTime.y;
    if (abs(ray.y) < 1e-5) {
        if (cameraY < minimumY || cameraY > maximumY) return false;
        startT = 0.0;
        endT = maxDistance;
        return endT > startT;
    }
    float a = (minimumY - cameraY) / ray.y;
    float b = (maximumY - cameraY) / ray.y;
    startT = max(0.0, min(a, b));
    endT = min(maxDistance, max(a, b));
    return endT > startT;
}

int buildMarchRegions(vec3 ray, int group, float maxDistance, out float starts[MAX_REGIONS], out float ends[MAX_REGIONS]) {
    float rawStarts[MAX_REGIONS];
    float rawEnds[MAX_REGIONS];
    int rawCount = 0;
    int domainCount = clamp(int(u_Data.counts.x), 0, COMBATANT_CLOUD_MAX_DOMAINS);
    for (int i = 0; i < COMBATANT_CLOUD_MAX_DOMAINS; ++i) {
        if (i >= domainCount) break;
        CloudDomain domain = u_Domains.domains[i];
        if (!combatant_cloud_domain_in_group(domain, group)) continue;
        float startT;
        float endT;
        if (!domainRayInterval(domain, ray, maxDistance, startT, endT)) continue;
        if (rawCount < MAX_REGIONS) {
            rawStarts[rawCount] = startT;
            rawEnds[rawCount] = endT;
            rawCount++;
        }
    }
    if (rawCount == 0) return 0;

    for (int i = 1; i < MAX_REGIONS; ++i) {
        if (i >= rawCount) break;
        float keyStart = rawStarts[i];
        float keyEnd = rawEnds[i];
        int j = i - 1;
        for (int k = 0; k < MAX_REGIONS; ++k) {
            if (j < 0 || rawStarts[j] <= keyStart) break;
            rawStarts[j + 1] = rawStarts[j];
            rawEnds[j + 1] = rawEnds[j];
            j--;
        }
        rawStarts[j + 1] = keyStart;
        rawEnds[j + 1] = keyEnd;
    }

    int regionCount = 0;
    float currentStart = rawStarts[0];
    float currentEnd = rawEnds[0];
    for (int i = 1; i < MAX_REGIONS; ++i) {
        if (i >= rawCount) break;
        if (rawStarts[i] <= currentEnd + 0.5) {
            currentEnd = max(currentEnd, rawEnds[i]);
        } else {
            starts[regionCount] = currentStart;
            ends[regionCount] = currentEnd;
            regionCount++;
            currentStart = rawStarts[i];
            currentEnd = rawEnds[i];
        }
    }
    starts[regionCount] = currentStart;
    ends[regionCount] = currentEnd;
    return regionCount + 1;
}

float occupancyAxisExit(float position, float direction, float minimumValue, float maximumValue) {
    if (abs(direction) < 1e-6) return 1e30;
    float boundary = direction > 0.0 ? maximumValue : minimumValue;
    float distance = (boundary - position) / direction;
    return distance > 1e-5 ? distance : 1e30;
}

bool occupancySkip(vec3 localPosition, vec3 ray, float distanceFromCamera, out float skipDistance) {
    skipDistance = 0.0;
    if (u_Data.occupancyPolicy.y <= 0.5) return false;
    float spanXZ = max(u_Data.occupancyPolicy.x, 1.0);
    float spanY = max(u_Data.occupancyDomain.w - u_Data.occupancyDomain.z, 1.0);
    vec3 origin = vec3(u_Data.occupancyDomain.x, u_Data.occupancyDomain.z, u_Data.occupancyDomain.y);
    vec3 extent = vec3(spanXZ, spanY, spanXZ);
    vec3 normalized = (localPosition - origin) / extent;
    if (any(lessThan(normalized, vec3(0.0))) || any(greaterThanEqual(normalized, vec3(1.0)))) return false;

    int mipLevels = max(textureQueryLevels(u_CloudOccupancy), 1);
    int mip = distanceFromCamera < u_Data.lodPolicy.x ? 0
            : (distanceFromCamera < u_Data.lodPolicy.y ? 1 : 2);
    mip = clamp(mip, 0, mipLevels - 1);
    ivec3 size = textureSize(u_CloudOccupancy, mip);
    ivec3 cell = clamp(ivec3(floor(normalized * vec3(size))), ivec3(0), size - ivec3(1));
    if (texelFetch(u_CloudOccupancy, cell, mip).r > 0.5) return false;

    vec3 cellSize = extent / vec3(size);
    vec3 cellMinimum = origin + vec3(cell) * cellSize;
    vec3 cellMaximum = cellMinimum + cellSize;
    float exitX = occupancyAxisExit(localPosition.x, ray.x, cellMinimum.x, cellMaximum.x);
    float exitY = occupancyAxisExit(localPosition.y, ray.y, cellMinimum.y, cellMaximum.y);
    float exitZ = occupancyAxisExit(localPosition.z, ray.z, cellMinimum.z, cellMaximum.z);
    skipDistance = max(min(exitX, min(exitY, exitZ)) + 0.05, 0.0);
    return skipDistance > 0.0 && skipDistance < 1e29;
}

float hgPhase(float cosTheta, float g) {
    float g2 = g * g;
    float denominator = max(1.0 + g2 - 2.0 * g * cosTheta, 1e-4);
    return (1.0 - g2) / (4.0 * PI * denominator * sqrt(denominator));
}

float lightOpticalDepth(vec3 localPosition, vec3 lightDirection, int stepCount) {
    if (stepCount <= 0) return 0.0;
    float maxDistance = max(u_Data.counts.y, 0.0);
    if (maxDistance <= 1e-4) return 0.0;
    float preferredStepLength = max(u_Data.lightingPolicy.y, 0.25);
    int adaptiveSteps = clamp(int(ceil(maxDistance / preferredStepLength)), 1, stepCount);
    float stepLength = maxDistance / float(adaptiveSteps);
    float opticalDepth = 0.0;
    for (int i = 0; i < MAX_LIGHT_STEPS; ++i) {
        if (i >= adaptiveSteps) break;
        vec3 p = localPosition + lightDirection * (float(i) + 0.5) * stepLength;
        float dTau = combatant_cloud_optical_density_at(p) * stepLength;
        opticalDepth += dTau;
        if (opticalDepth >= 20.0) break;
    }
    return min(opticalDepth, 20.0);
}

vec3 environmentAmbientRadiance() {
    if (u_SkySh.coefficients.length() < 1) return vec3(0.0);
    vec3 diffuseIrradiance = max(u_SkySh.coefficients[0].rgb * SH_Y00, vec3(0.0));
    return diffuseIrradiance / PI;
}

vec3 directionalScattering(CloudOptics optics, vec3 ray, vec3 sunDirection, float lightDepth, int orders) {
    float cosTheta = dot(ray, sunDirection);
    float energy = 1.0;
    float extinctionScale = 1.0;
    float anisotropyScale = 1.0;
    vec3 scattering = vec3(0.0);
    for (int order = 0; order < MAX_SCATTERING_ORDERS; ++order) {
        if (order >= orders) break;
        float g = clamp(optics.anisotropy * anisotropyScale, -0.9, 0.9);
        float phase = hgPhase(cosTheta, g);
        float lightT = exp(-lightDepth * extinctionScale);
        scattering += max(u_Data.sunRadiance.rgb, vec3(0.0)) * phase * lightT * energy;
        energy *= optics.multiEnergy * optics.albedo;
        extinctionScale *= optics.multiExtinction;
        anisotropyScale *= optics.multiAnisotropy;
    }
    return scattering;
}

void clearCloudPixel(ivec2 pixel) {
    imageStore(u_CloudRadiance, pixel, vec4(0.0, 0.0, 0.0, 1.0));
    imageStore(u_CloudDepth, pixel, vec4(-1.0, 0.0, 0.0, 0.0));
    imageStore(u_CloudReprojectionData, pixel, vec4(0.0, 0.0, -1.0, 0.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_CloudRadiance);
    if (any(greaterThanEqual(pixel, size))) return;

    if (u_Data.counts.w <= 0.5 || u_Data.counts.x < 0.5 || u_Data.grid.w < 0.5 || u_Data.macroGrid.w < 0.5) {
        clearCloudPixel(pixel);
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec3 ray = worldRay(uv);
    float maxDistance = u_Data.counts.y;
    float opaqueDistance = sceneDistance(uv);
    if (opaqueDistance >= 0.0) maxDistance = min(maxDistance, opaqueDistance);
    if (maxDistance <= 0.0) {
        clearCloudPixel(pixel);
        return;
    }

    int renderGroup = int(u_Data.lodPolicy.w + 0.5);
    float regionStarts[MAX_REGIONS];
    float regionEnds[MAX_REGIONS];
    int regionCount = buildMarchRegions(ray, renderGroup, maxDistance, regionStarts, regionEnds);
    if (regionCount <= 0) {
        clearCloudPixel(pixel);
        return;
    }

    int requestedSteps = clamp(int(u_Data.quality.x), 8, MAX_PRIMARY_STEPS);
    int lightSteps = clamp(int(u_Data.quality.y), 0, MAX_LIGHT_STEPS);
    int scatteringOrders = clamp(int(u_Data.lightingPolicy.z), 1, MAX_SCATTERING_ORDERS);
    float maxStepLength = max(u_Data.quality.z, 0.25);
    float totalRegionLength = 0.0;
    for (int r = 0; r < MAX_REGIONS; ++r) {
        if (r >= regionCount) break;
        totalRegionLength += max(0.0, regionEnds[r] - regionStarts[r]);
    }
    float nominalStep = max(totalRegionLength / float(max(requestedSteps, 1)), 0.25);

    vec3 radiance = vec3(0.0);
    float transmittance = 1.0;
    vec3 cameraLocalPosition = vec3(u_Data.cameraTime.x, u_Data.cameraTime.y, u_Data.cameraTime.z);
    CloudOptics cameraOptics = combatant_cloud_optics_at_group(cameraLocalPosition, renderGroup);
    float firstDepth = cameraOptics.density > 1e-5 && cameraOptics.extinction > 0.0 ? 0.0 : -1.0;
    vec3 sunDirection = u_Data.sunDirection.w > 0.5 ? normalize(u_Data.sunDirection.xyz) : vec3(0.0, 1.0, 0.0);
    vec3 ambientRadiance = environmentAmbientRadiance() * max(u_Data.lightingPolicy.x, 0.0);
    float jitter = fract(combatant_cloud_hash31(vec3(vec2(pixel), u_Data.quality.w * 257.0)) + u_Data.quality.w);

    float anchorWeight = 0.0;
    float anchorDepthSum = 0.0;
    vec2 anchorFlowSum = vec2(0.0);
    int samplesTaken = 0;

    for (int region = 0; region < MAX_REGIONS; ++region) {
        if (region >= regionCount || samplesTaken >= MAX_PRIMARY_STEPS || transmittance < 0.01) break;
        float startT = regionStarts[region];
        float endT = regionEnds[region];
        float regionMid = 0.5 * (startT + endT);
        float lodMultiplier = regionMid < u_Data.lodPolicy.x ? 1.0
                : (regionMid < u_Data.lodPolicy.y ? 2.0 : 4.0);
        float stepLength = clamp(nominalStep * lodMultiplier, 0.25, maxStepLength * lodMultiplier);
        int regionSteps = clamp(int(ceil((endT - startT) / stepLength)), 1, MAX_PRIMARY_STEPS);
        stepLength = (endT - startT) / float(regionSteps);
        float t = startT + jitter * stepLength;

        for (int iteration = 0; iteration < MAX_TRAVERSAL_ITERATIONS; ++iteration) {
            if (t > endT || samplesTaken >= MAX_PRIMARY_STEPS || transmittance < 0.01) break;
            vec3 localPosition = cameraLocalPosition + ray * t;
            float emptyAdvance;
            if (occupancySkip(localPosition, ray, t, emptyAdvance)) {
                t += max(emptyAdvance, stepLength);
                continue;
            }

            samplesTaken++;
            CloudOptics optics = combatant_cloud_optics_at_group(localPosition, renderGroup);
            if (optics.density > 1e-5 && optics.extinction > 0.0 && optics.albedo > 0.0) {
                if (firstDepth < 0.0) firstDepth = t;

                float sigmaT = optics.density * optics.extinction;
                float sigmaS = sigmaT * optics.albedo;
                float segmentT = exp(-sigmaT * stepLength);
                float segmentOpacity = 1.0 - segmentT;
                float segmentContribution = transmittance * segmentOpacity;
                vec2 flow = combatant_cloud_group_wind(localPosition, renderGroup);
                anchorWeight += segmentContribution;
                anchorDepthSum += t * segmentContribution;
                anchorFlowSum += flow * segmentContribution;

                vec3 source = ambientRadiance;
                if (u_Data.sunDirection.w > 0.5) {
                    float lightDepth = lightOpticalDepth(localPosition, sunDirection, lightSteps);
                    source += directionalScattering(optics, ray, sunDirection, lightDepth, scatteringOrders);
                }

                float integrated = segmentOpacity / max(sigmaT, 1e-5);
                radiance += transmittance * source * sigmaS * integrated;
                transmittance *= segmentT;
            }
            t += stepLength;
        }
    }

    float reprojectionDepth = anchorWeight > 1e-6 ? anchorDepthSum / anchorWeight : firstDepth;
    vec2 flow = anchorWeight > 1e-6 ? anchorFlowSum / anchorWeight : vec2(0.0);

    imageStore(u_CloudRadiance, pixel, vec4(max(radiance, vec3(0.0)), clamp(transmittance, 0.0, 1.0)));
    imageStore(u_CloudDepth, pixel, vec4(firstDepth, 0.0, 0.0, 0.0));
    imageStore(u_CloudReprojectionData, pixel, vec4(flow, reprojectionDepth, clamp(anchorWeight, 0.0, 1.0)));
}
