#version 430 core

/* Independent GTAO temporal accumulation. It remains active when scene TAA is disabled. */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_RawSignal;
layout(binding = 1) uniform sampler2D u_ResolvedDepth;
layout(binding = 2) uniform sampler2D u_GbufferGeometry;
layout(binding = 3) uniform sampler2D u_GbufferDepth;
layout(binding = 4) uniform sampler2D u_HistorySignal;
layout(binding = 5) uniform sampler2D u_HistoryDepth;
layout(binding = 6) uniform sampler2D u_HistoryAge;

layout(binding = 7, rgba16f) writeonly uniform image2D u_TemporalSignal;
layout(binding = 8, r32f) writeonly uniform image2D u_TemporalDepth;
layout(binding = 9, r8) writeonly uniform image2D u_TemporalAge;
layout(binding = 10, rg16f) writeonly uniform image2D u_ReprojectedUv;
layout(binding = 11, r8) writeonly uniform image2D u_HistoryValidity;
layout(binding = 12, r8) writeonly uniform image2D u_DepthRejection;
layout(binding = 13, r8) writeonly uniform image2D u_OffcenterRejection;
layout(binding = 14, r8) writeonly uniform image2D u_HistoryWeight;

layout(std430, binding = 15) readonly buffer AmbientOcclusionTemporalData {
    mat4 currentInverseProjection;
    mat4 previousInverseProjection;
    mat4 currentInverseView;
    mat4 currentView;
    mat4 previousView;
    mat4 previousProjection;
    mat4 previousInverseView;
    vec4 cameraDelta;
    vec4 depthTransform; // xy: depth -> NDC scale/bias
    vec4 policy;         // x=history valid, y=max frames, z=depth rejection strength, w=offcenter strength
} u_Temporal;

vec2 signNotZero(vec2 v) {
    return vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
}

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * signNotZero(n.xy);
    float l2 = dot(n, n);
    return l2 > 1.0e-12 ? n * inversesqrt(l2) : vec3(0.0, 0.0, 1.0);
}

vec3 reconstructView(mat4 inverseProjection, vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Temporal.depthTransform.x + u_Temporal.depthTransform.y;
    vec4 h = inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    if (abs(h.w) < 1.0e-7) return vec3(0.0);
    return h.xyz / h.w;
}

bool ownsPixel(vec2 uv, out float depth) {
    depth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    float gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    if (depth <= 0.0 || gbufferDepth <= 0.0) return false;
    float tolerance = max(1.0e-6, abs(gbufferDepth) * 1.0e-5);
    return abs(depth - gbufferDepth) <= tolerance;
}

vec3 safeNormal(vec3 value, vec3 fallbackValue) {
    float l2 = dot(value, value);
    return l2 > 1.0e-10 ? value * inversesqrt(l2) : fallbackValue;
}

vec4 sampleHistoryCubic5(sampler2D source, vec2 uv) {
    vec2 extent = vec2(textureSize(source, 0));
    vec2 invExtent = 1.0 / extent;
    vec2 position = extent * uv;
    vec2 center = floor(position - 0.5) + 0.5;
    vec2 f = position - center;
    vec2 f2 = f * f;
    vec2 f3 = f2 * f;
    const float sharpness = 0.65;

    vec2 w0 = -sharpness * f3 + 2.0 * sharpness * f2 - sharpness * f;
    vec2 w1 = (2.0 - sharpness) * f3 - (3.0 - sharpness) * f2 + 1.0;
    vec2 w2 = -(2.0 - sharpness) * f3 + (3.0 - 2.0 * sharpness) * f2 + sharpness * f;
    vec2 w3 = sharpness * f3 - sharpness * f2;
    vec2 w12 = w1 + w2;
    vec2 mergedUv = invExtent * (center + w2 / max(w12, vec2(1.0e-6)));
    vec2 uv0 = invExtent * (center - 1.0);
    vec2 uv3 = invExtent * (center + 2.0);

    float a = w12.x * w0.y;
    float b = w0.x * w12.y;
    float c = w12.x * w12.y;
    float d = w3.x * w12.y;
    float e = w12.x * w3.y;
    float total = a + b + c + d + e;

    vec4 result = textureLod(source, vec2(mergedUv.x, uv0.y), 0.0) * a
            + textureLod(source, vec2(uv0.x, mergedUv.y), 0.0) * b
            + textureLod(source, mergedUv, 0.0) * c
            + textureLod(source, vec2(uv3.x, mergedUv.y), 0.0) * d
            + textureLod(source, vec2(mergedUv.x, uv3.y), 0.0) * e;
    return result / max(abs(total), 1.0e-6);
}

vec4 filterCurrentSignal(ivec2 pixel, ivec2 size, float centerDepth, vec3 centerNormal) {
    vec2 centerUv = (vec2(pixel) + 0.5) / vec2(size);
    vec3 centerView = reconstructView(u_Temporal.currentInverseProjection, centerUv, centerDepth);
    float centerLinearDepth = max(-centerView.z, 1.0e-4);

    float visibilitySum = 0.0;
    vec3 bentSum = vec3(0.0);
    float weightSum = 0.0;

    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 samplePixel = clamp(pixel + ivec2(x, y), ivec2(0), size - 1);
            vec2 sampleUv = (vec2(samplePixel) + 0.5) / vec2(size);
            float sampleDepth;
            if (!ownsPixel(sampleUv, sampleDepth)) continue;

            vec3 sampleNormal = decodeOctahedral(textureLod(u_GbufferGeometry, sampleUv, 0.0).rg);
            vec3 sampleView = reconstructView(u_Temporal.currentInverseProjection, sampleUv, sampleDepth);
            float sampleLinearDepth = max(-sampleView.z, 1.0e-4);
            float depthScale = max(0.035, centerLinearDepth * 0.0125);
            float depthWeight = exp2(-abs(sampleLinearDepth - centerLinearDepth) / depthScale);
            float normalWeight = pow(max(dot(centerNormal, sampleNormal), 0.0), 12.0);
            float spatialWeight = exp2(-0.85 * float(x * x + y * y));
            float weight = depthWeight * normalWeight * spatialWeight;
            if (weight <= 1.0e-6) continue;

            vec4 signal = texelFetch(u_RawSignal, samplePixel, 0);
            visibilitySum += clamp(signal.r, 0.0, 1.0) * weight;
            bentSum += safeNormal(signal.gba, sampleNormal) * weight;
            weightSum += weight;
        }
    }

    if (weightSum <= 1.0e-6) return texelFetch(u_RawSignal, pixel, 0);
    return vec4(visibilitySum / weightSum, safeNormal(bentSum / weightSum, centerNormal));
}

vec2 reprojectPreviousUv(vec2 uv, float depth, out bool valid) {
    vec3 currentViewPosition = reconstructView(u_Temporal.currentInverseProjection, uv, depth);
    vec3 currentWorldRelative = (u_Temporal.currentInverseView * vec4(currentViewPosition, 0.0)).xyz;
    vec3 previousWorldRelative = currentWorldRelative + u_Temporal.cameraDelta.xyz;
    vec4 previousClip = u_Temporal.previousProjection * u_Temporal.previousView * vec4(previousWorldRelative, 1.0);
    valid = abs(previousClip.w) > 1.0e-7;
    if (!valid) return vec2(-2.0);
    return (previousClip.xy / previousClip.w) * 0.5 + 0.5;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_TemporalSignal);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float currentDepth;
    bool owns = ownsPixel(uv, currentDepth);
    vec3 currentNormal = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    vec4 currentSignal = owns
            ? filterCurrentSignal(pixel, size, currentDepth, currentNormal)
            : vec4(1.0, 0.0, 0.0, 1.0);

    float maxFrames = max(u_Temporal.policy.y, 1.0);
    float historyWeight = 0.0;
    float depthWeight = 0.0;
    float offcenterWeight = 0.0;
    float historyValidity = 0.0;
    float nextAge = owns ? 1.0 : 0.0;
    vec2 previousUv = uv;
    vec4 resolvedSignal = currentSignal;

    if (owns && u_Temporal.policy.x > 0.5) {
        bool reprojectValid;
        previousUv = reprojectPreviousUv(uv, currentDepth, reprojectValid);
        bool inside = reprojectValid
                && all(greaterThanEqual(previousUv, vec2(0.0)))
                && all(lessThanEqual(previousUv, vec2(1.0)));

        if (inside) {
            float previousDepth = textureLod(u_HistoryDepth, previousUv, 0.0).r;
            float previousAge = textureLod(u_HistoryAge, previousUv, 0.0).r * maxFrames;
            if (previousDepth > 0.0 && previousAge > 0.0) {
                vec3 currentViewPosition = reconstructView(u_Temporal.currentInverseProjection, uv, currentDepth);
                vec3 previousViewPosition = reconstructView(u_Temporal.previousInverseProjection, previousUv, previousDepth);
                float currentLengthSquared = dot(currentViewPosition, currentViewPosition);
                if (currentLengthSquared > 1.0e-10) {
                    float inverseViewLength = inversesqrt(currentLengthSquared);
                    float noV = abs(dot(currentNormal, currentViewPosition)) * inverseViewLength;
                    float z0 = max(-currentViewPosition.z, 0.0);
                    float z1 = max(-previousViewPosition.z, 0.0);
                    depthWeight = exp2(-abs(z0 - z1) * u_Temporal.policy.z * noV * inverseViewLength);
                }

                vec2 pixelOffset = 1.0 - abs(2.0 * fract(vec2(size) * previousUv) - 1.0);
                float centered = sqrt(max(pixelOffset.x * pixelOffset.y, 0.0));
                offcenterWeight = centered * u_Temporal.policy.w + (1.0 - u_Temporal.policy.w);

                float weightedAge = min(previousAge, maxFrames) * depthWeight * offcenterWeight;
                historyWeight = weightedAge / (weightedAge + 1.0);
                historyValidity = depthWeight * offcenterWeight;
                nextAge = min(weightedAge + 1.0, maxFrames);

                if (historyWeight > 0.0) {
                    vec4 historySignal = sampleHistoryCubic5(u_HistorySignal, previousUv);
                    historySignal.r = clamp(historySignal.r, 0.0, 1.0);
                    vec3 currentBent = safeNormal(currentSignal.gba, currentNormal);
                    vec3 previousBent = safeNormal(historySignal.gba, currentNormal);
                    vec3 worldBent = safeNormal((u_Temporal.previousInverseView * vec4(previousBent, 0.0)).xyz, currentBent);
                    vec3 reprojectedBent = safeNormal((u_Temporal.currentView * vec4(worldBent, 0.0)).xyz, currentBent);
                    vec3 blendedBent = safeNormal(mix(currentBent, reprojectedBent, historyWeight), currentBent);
                    float visibility = mix(currentSignal.r, historySignal.r, historyWeight);
                    resolvedSignal = vec4(clamp(visibility, 0.0, 1.0), blendedBent);
                }
            }
        }
    }

    if (!owns) {
        resolvedSignal = vec4(1.0, 0.0, 0.0, 1.0);
        currentDepth = 0.0;
        nextAge = 0.0;
    }

    imageStore(u_TemporalSignal, pixel, resolvedSignal);
    imageStore(u_TemporalDepth, pixel, vec4(currentDepth, 0.0, 0.0, 0.0));
    imageStore(u_TemporalAge, pixel, vec4(clamp(nextAge / maxFrames, 0.0, 1.0)));
    imageStore(u_ReprojectedUv, pixel, vec4(previousUv, 0.0, 0.0));
    imageStore(u_HistoryValidity, pixel, vec4(clamp(historyValidity, 0.0, 1.0)));
    imageStore(u_DepthRejection, pixel, vec4(clamp(depthWeight, 0.0, 1.0)));
    imageStore(u_OffcenterRejection, pixel, vec4(clamp(offcenterWeight, 0.0, 1.0)));
    imageStore(u_HistoryWeight, pixel, vec4(clamp(historyWeight, 0.0, 1.0)));
}
