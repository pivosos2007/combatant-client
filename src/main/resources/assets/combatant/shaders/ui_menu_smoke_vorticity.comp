layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_Advected;
layout(binding = 1, rgba16f) writeonly uniform image2D u_Curled;
layout(std430, binding = 2) readonly buffer MenuSmokeParams {
    vec4 screen;
    vec4 mouse;
    vec4 motion;
    vec4 accent;
    vec4 soft;
    vec4 cold;
    vec4 warm;
    vec4 hexGrid;
    vec4 rimColor;
    vec4 sources[64];
    vec4 sourceProps[64];
} u_Smoke;

vec2 sampleVelocity(ivec2 p, ivec2 size) {
    return texelFetch(u_Advected, clamp(p, ivec2(0), size - 1), 0).xy;
}

float curlAt(ivec2 p, ivec2 size) {
    vec2 l = sampleVelocity(p - ivec2(1, 0), size);
    vec2 r = sampleVelocity(p + ivec2(1, 0), size);
    vec2 t = sampleVelocity(p - ivec2(0, 1), size);
    vec2 b = sampleVelocity(p + ivec2(0, 1), size);
    return 0.5 * ((r.y - l.y) - (b.x - t.x));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_Curled);
    if (any(greaterThanEqual(p, size))) return;
    vec4 field = texelFetch(u_Advected, p, 0);
    float c = curlAt(p, size);
    vec2 gradient = 0.5 * vec2(
        abs(curlAt(p + ivec2(1, 0), size)) - abs(curlAt(p - ivec2(1, 0), size)),
        abs(curlAt(p + ivec2(0, 1), size)) - abs(curlAt(p - ivec2(0, 1), size)));
    vec2 direction = gradient / max(length(gradient), 0.001);
    vec2 force = vec2(direction.y, -direction.x) * c;
    field.xy += clamp(force * u_Smoke.screen.z * 23.0 * u_Smoke.mouse.y, vec2(-0.022), vec2(0.022));
    field.xy = clamp(field.xy, vec2(-1.10), vec2(1.10));
    imageStore(u_Curled, p, field);
}
