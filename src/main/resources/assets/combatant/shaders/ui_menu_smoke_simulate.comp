#version 430 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_History;
layout(binding = 1, rgba16f) writeonly uniform image2D u_State;
layout(std430, binding = 2) readonly buffer MenuSmokeParams {
    vec4 screen;
    vec4 mouse;
    vec4 motion;
    vec4 accent;
    vec4 soft;
    vec4 cold;
    vec4 warm;
    vec4 sources[48];
    vec4 sourceProps[48];
} u_Smoke;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_State);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 extent = vec2(size);
    vec2 uv = (vec2(pixel) + 0.5) / extent;
    float dt = clamp(u_Smoke.screen.z, 0.0, 0.05);
    bool reset = u_Smoke.motion.z > 0.5;
    vec4 previous = reset ? vec4(0.0) : texture(u_History, uv);
    vec2 back = clamp(uv - previous.xy * dt, 0.5 / extent, 1.0 - 0.5 / extent);
    vec4 advected = reset ? vec4(0.0) : texture(u_History, back);
    vec2 velocity = advected.xy * exp(-dt * 0.26);
    float energy = advected.z * exp(-dt * 0.55);
    int sourceCount = int(clamp(u_Smoke.motion.w, 0.0, 48.0));
    for (int i = 0; i < sourceCount; ++i) {
        vec4 source = u_Smoke.sources[i];
        vec4 properties = u_Smoke.sourceProps[i];
        vec2 d = (uv - source.xy) * extent;
        float radius = max(properties.z, 1.5);
        float dist2 = dot(d, d);
        if (dist2 > radius * radius * 9.0) continue;
        float distance = sqrt(dist2);
        float core = exp(-dist2 / (radius * radius * 0.68));
        float ring = exp(-pow((distance - radius * (0.78 + properties.w * 0.20))
                           / max(radius * 0.24, 1.2), 2.0));
        float strength = clamp(properties.x, 0.0, 1.5);
        float splat = strength * (core * 0.72 + ring * 0.28);
        vec2 radial = d / max(distance, 1.0);
        vec2 tangent = vec2(-radial.y, radial.x);
        float turn = dot(tangent, source.zw);
        velocity += source.zw * splat * (0.84 + properties.w * 0.30);
        velocity += radial * ring * strength * (0.012 + properties.w * 0.012);
        velocity += tangent * sign(turn + 0.00001) * ring * strength * 0.010;
        energy = min(3.5, energy + splat * 0.44);
    }
    velocity = clamp(velocity, vec2(-1.10), vec2(1.10));
    imageStore(u_State, pixel, vec4(velocity, energy, 0.0));
}
