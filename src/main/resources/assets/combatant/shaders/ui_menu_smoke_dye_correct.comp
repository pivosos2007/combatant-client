#version 430 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_DyeHistory;
layout(binding = 1, rgba16f) writeonly uniform image2D u_Dye;
layout(binding = 3) uniform sampler2D u_Advected;
layout(binding = 4) uniform sampler2D u_Velocity;
layout(std430, binding = 2) readonly buffer MenuSmokeParams {
    vec4 screen;
    vec4 mouse;
    vec4 motion;
    vec4 accent;
    vec4 soft;
    vec4 cold;
    vec4 warm;
    vec4 sources[48];
    vec4 sourceProps[48];
} u_Smoke;

vec3 palette(float t) {
    t = clamp(t, 0.0, 1.0);
    vec3 color;
    if (t < 0.33) color = mix(u_Smoke.warm.rgb, u_Smoke.accent.rgb, smoothstep(0.0, 0.33, t));
    else if (t < 0.66) color = mix(u_Smoke.accent.rgb, u_Smoke.soft.rgb, smoothstep(0.33, 0.66, t));
    else color = mix(u_Smoke.soft.rgb, u_Smoke.cold.rgb, smoothstep(0.66, 1.0, t));
    float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));
    return clamp(vec3(luminance) + (color - vec3(luminance)) * 1.24, vec3(0.0), vec3(1.0));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_Dye);
    if (any(greaterThanEqual(p, size))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    float dt = clamp(u_Smoke.screen.z, 0.0, 0.033);
    bool reset = u_Smoke.motion.z > 0.5;
    vec2 flow = texture(u_Velocity, uv).xy;
    vec2 back = clamp(uv - flow * dt, 0.5 / vec2(size), 1.0 - 0.5 / vec2(size));
    vec4 color = vec4(0.0);
    if (!reset) {
        vec4 forward = texture(u_Advected, uv);
        vec2 flowForward = texture(u_Velocity, uv).xy;
        vec2 future = clamp(uv + flowForward * dt, 0.5 / vec2(size), 1.0 - 0.5 / vec2(size));
        vec4 backward = texture(u_Advected, future);
        vec4 source = texture(u_DyeHistory, uv);
        vec4 correction = forward + 0.5 * (source - backward);
        vec2 texel = 1.0 / vec2(size);
        vec4 a = texture(u_DyeHistory, clamp(back + texel * vec2(-0.5,-0.5), vec2(0.0), vec2(1.0)));
        vec4 b = texture(u_DyeHistory, clamp(back + texel * vec2(0.5,-0.5), vec2(0.0), vec2(1.0)));
        vec4 c = texture(u_DyeHistory, clamp(back + texel * vec2(-0.5,0.5), vec2(0.0), vec2(1.0)));
        vec4 d = texture(u_DyeHistory, clamp(back + texel * vec2(0.5,0.5), vec2(0.0), vec2(1.0)));
        vec4 minimum = min(min(a,b),min(c,d));
        vec4 maximum = max(max(a,b),max(c,d));
        color = clamp(correction, minimum, maximum);
        color *= 1.0 / (1.0 + 0.42 * dt);
    }
    int count = int(clamp(u_Smoke.motion.w, 0.0, 48.0));
    for (int i = 0; i < count; ++i) {
        vec4 source = u_Smoke.sources[i];
        vec4 properties = u_Smoke.sourceProps[i];
        vec2 delta = (uv - source.xy) * u_Smoke.screen.xy;
        float r = max(properties.z, 1.25);
        float dist2 = dot(delta, delta);
        if (dist2 > r * r * 9.0) continue;
        float body = exp(-dist2 / (r * r * 0.52));
        float ringDist = sqrt(dist2) - r * (0.92 + properties.w * 0.16);
        float ring = exp(-ringDist * ringDist / max(0.08 * r * r, 1.0));
        float splat = clamp(properties.x, 0.0, 1.15) * (0.58 * body + 0.42 * ring);
        vec3 pigment = palette(properties.y);
        color.rgb += pigment * splat * (1.04 + 0.34 * properties.w);
        color.a += splat * 0.92;
    }
    imageStore(u_Dye, p, clamp(color, vec4(0.0), vec4(8.0)));
}
