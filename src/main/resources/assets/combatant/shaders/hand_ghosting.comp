layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_Src;
layout(binding = 1) uniform sampler2D u_History;
layout(binding = 2, rgba8) writeonly uniform image2D u_Output;
layout(std430, binding = 3) readonly buffer HandGhosting {
    vec4 u_Screen;
    vec4 u_Color;
    vec4 u_Params;
    vec4 u_Noise0;
    vec4 u_Noise1;
    vec4 u_PaletteEnd;
    vec4 u_PaletteOptions;
    vec4 u_GhostDetails;
    vec4 u_State;
};
#include <combatant:hand_palette.glsl>
#include <combatant:hand_ghost_detail.glsl>

vec3 historyAt(vec2 uv) { return texture(u_History, clamp(uv, vec2(0), vec2(1))).rgb; }
void accumulateHistory(inout vec2 trailNoise, inout float weight, vec2 uv, float sampleWeight) {
    vec3 h = historyAt(uv); trailNoise += vec2(h.r, h.b) * sampleWeight; weight += sampleWeight;
}
float currentMaskDilated(vec2 uv, vec2 texel, int quality) {
    float current = historyAt(uv).g; if (quality <= 1) return current;
    current = max(current, historyAt(uv + vec2(texel.x,0)).g); current = max(current, historyAt(uv - vec2(texel.x,0)).g);
    current = max(current, historyAt(uv + vec2(0,texel.y)).g); current = max(current, historyAt(uv - vec2(0,texel.y)).g); return current;
}
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy), size = imageSize(u_Output);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 base = texture(u_Src, uv);
    int quality = clamp(int(u_Noise0.x + 0.5), 1, 4);
    vec2 historyTexel = 1.0 / vec2(max(textureSize(u_History,0), ivec2(1)));
    float radius = max(u_Params.z, 0.0) * max(u_Noise1.w, 0.05);
    vec2 stepUv = historyTexel * radius;
    vec2 sum = vec2(0); float weight = 0.0; accumulateHistory(sum, weight, uv, 4.0);
    if (quality >= 2 && radius > 0.01) {
        accumulateHistory(sum,weight,uv+vec2(stepUv.x,0),1.0); accumulateHistory(sum,weight,uv-vec2(stepUv.x,0),1.0);
        accumulateHistory(sum,weight,uv+vec2(0,stepUv.y),1.0); accumulateHistory(sum,weight,uv-vec2(0,stepUv.y),1.0);
    }
    if (quality >= 3 && radius > 0.01) {
        vec2 d=stepUv*0.72; accumulateHistory(sum,weight,uv+vec2(d.x,d.y),0.8); accumulateHistory(sum,weight,uv+vec2(-d.x,d.y),0.8);
        accumulateHistory(sum,weight,uv+vec2(d.x,-d.y),0.8); accumulateHistory(sum,weight,uv-vec2(d.x,d.y),0.8);
    }
    if (quality >= 4 && radius > 0.01) {
        vec2 o=stepUv*1.75; accumulateHistory(sum,weight,uv+vec2(o.x,0),0.45); accumulateHistory(sum,weight,uv-vec2(o.x,0),0.45);
        accumulateHistory(sum,weight,uv+vec2(0,o.y),0.45); accumulateHistory(sum,weight,uv-vec2(0,o.y),0.45);
    }
    vec2 history = sum / max(weight,1.0); float temporal=history.x, turbulence=history.y;
    float current=currentMaskDilated(uv,historyTexel,quality); float ghost=max(temporal-current*clamp(u_Params.w,0.0,1.25),0.0);
    if (ghost <= 0.0001) {
        imageStore(u_Output, pixel, base);
        return;
    }
    ghost = pow(clamp(ghost * (0.62 + max(u_Noise1.z, 0.0) * 0.27), 0.0, 1.0), max(u_Noise1.y, 0.05));
    ghost *= mix(0.82, 1.12, turbulence);
    ghost *= handGhostDetail(uv, vec2(max(u_Screen.x, 1.0) / max(u_Screen.y, 1.0), 1.0),
                             u_Screen.w, turbulence, u_Noise0.w, u_Noise0.z, u_GhostDetails);
    vec4 palette = handPaletteColor(uv, u_Screen.w, u_Color, u_PaletteEnd, u_PaletteOptions);
    float opticalDepth = ghost * max(u_Params.y, 0.0) * palette.a * 1.20;
    float alpha = (1.0 - exp(-opticalDepth)) * 0.82;
    vec3 ghostColor = palette.rgb * mix(0.66, 0.94, turbulence);
    imageStore(u_Output, pixel, vec4(mix(base.rgb, ghostColor, alpha), base.a));
}
