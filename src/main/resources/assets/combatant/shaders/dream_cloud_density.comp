/* The froxel cache stores scattering in RGB and density in alpha. */
layout(local_size_x=4,local_size_y=4,local_size_z=4) in;
layout(binding=0,rgba16f) writeonly uniform image3D u_Froxels;
#include "dream_cloud_medium.glsl"

float dreamDistance(float k){
    float t=clamp(k/grid.z,0.,1.);
    return grid.w+(outputSize.z-grid.w)*pow(t,1.7);
}
void main(){
    ivec3 cell=ivec3(gl_GlobalInvocationID.xyz);
    if(any(greaterThanEqual(cell,ivec3(grid.xyz)))) return;
    vec2 uv=(vec2(cell.xy)+.5)/grid.xy;
    vec3 direction=dreamRay(uv);
    float travel=dreamDistance(float(cell.z)+.5);
    vec3 p=camera.xyz+direction*travel;
    float maxTop=shape.x+shape.y*2.5;
    if(shape.z<.002 || p.y<shape.x-shape.y*.2 || p.y>maxTop) {
        imageStore(u_Froxels,cell,vec4(0.));return;
    }
    float rho=dreamDensity(p);
    if(rho<.003){imageStore(u_Froxels,cell,vec4(0.));return;}
    vec3 lightDir=dreamLightDir();
    float shadow=dreamShadow(p,lightDir,max(.4,shape.w));
    vec3 scatter=dreamScattering(p,direction,rho,shadow);
    imageStore(u_Froxels,cell,vec4(scatter,rho));
}
