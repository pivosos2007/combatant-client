layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_Dye;
layout(binding = 1, rgba16f) writeonly uniform image2D u_Bloom;
layout(std430, binding = 2) readonly buffer MenuSmokeParams {
    vec4 screen;
    vec4 mouse;
    vec4 motion;
    vec4 accent;
    vec4 soft;
    vec4 cold;
    vec4 warm;
    vec4 hexGrid;
    vec4 rimColor;
    vec4 sources[64];
    vec4 sourceProps[64];
} u_Smoke;

vec3 lightAt(vec2 uv) {
    vec3 col = texture(u_Dye, clamp(uv, vec2(0.0), vec2(1.0))).rgb;
    return max(col - vec3(0.34), vec3(0.0));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_Bloom);
    if (any(greaterThanEqual(p, size))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    vec2 stepUv = 1.0 / vec2(size);
    vec3 result = lightAt(uv) * 0.42;
    result += (lightAt(uv + stepUv * vec2(1.5, 0.0))
            + lightAt(uv - stepUv * vec2(1.5, 0.0))
            + lightAt(uv + stepUv * vec2(0.0, 1.5))
            + lightAt(uv - stepUv * vec2(0.0, 1.5))) * 0.19;
    result += (lightAt(uv + stepUv * vec2(2.5, 2.5))
            + lightAt(uv + stepUv * vec2(-2.5, 2.5))
            + lightAt(uv + stepUv * vec2(2.5, -2.5))
            + lightAt(uv + stepUv * vec2(-2.5, -2.5))) * 0.14;
    imageStore(u_Bloom, p, vec4(result * 1.18, 1.0));
}
