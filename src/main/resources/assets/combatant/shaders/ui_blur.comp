#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_Texture;
layout(binding = 1, rgba8) writeonly uniform image2D u_Output;
layout(std430, binding = 2) readonly buffer UIBlurComputeParams {
    vec4 params; // x offset px, y up-pass, z brightness
    vec4 region; // xy output origin, zw output extent
} u_Blur;

void main() {
    ivec2 localPixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 regionExtent = ivec2(u_Blur.region.zw + vec2(0.5));
    if (any(greaterThanEqual(localPixel, regionExtent))) return;

    ivec2 pixel = localPixel + ivec2(u_Blur.region.xy + vec2(0.5));
    ivec2 outputSize = imageSize(u_Output);
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(outputSize);
    vec2 texel = 1.0 / vec2(textureSize(u_Texture, 0));
    float offsetPx = max(u_Blur.params.x, 0.0) + 0.5;
    float upPass = step(0.5, u_Blur.params.y);
    float spread = mix(1.0, 1.5, upPass);
    vec2 d = texel * offsetPx * spread;

    vec3 color = texture(u_Texture, uv + vec2( d.x,  d.y)).rgb;
    color += texture(u_Texture, uv + vec2(-d.x,  d.y)).rgb;
    color += texture(u_Texture, uv + vec2( d.x, -d.y)).rgb;
    color += texture(u_Texture, uv + vec2(-d.x, -d.y)).rgb;
    color *= 0.25 * u_Blur.params.z;
    imageStore(u_Output, pixel, vec4(color, 1.0));
}
