layout(local_size_x = 1) in;
// One native VkDrawIndexedIndirectCommand / GL DrawElementsIndirectCommand.
layout(std430, binding = 5) buffer SchematicIndirect {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    uint vertexOffset;
    uint firstInstance;
} drawCommand;
void main() {
    drawCommand.indexCount = 6u;
    drawCommand.instanceCount = 0u;
    drawCommand.firstIndex = 0u;
    drawCommand.vertexOffset = 0u;
    drawCommand.firstInstance = 0u;
}
