#version 430 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_Velocity;
layout(binding = 1, rgba16f) writeonly uniform image2D u_Pressure;
layout(std430, binding = 2) readonly buffer MenuSmokeParams {
    vec4 screen;
    vec4 mouse;
    vec4 motion;
    vec4 accent;
    vec4 soft;
    vec4 cold;
    vec4 warm;
    vec4 sources[48];
    vec4 sourceProps[48];
} u_Smoke;

vec2 velocityAt(ivec2 p, ivec2 size) {
    ivec2 clamped = clamp(p, ivec2(0), size - 1);
    vec2 v = texelFetch(u_Velocity, clamped, 0).xy;
    if (p.x < 0 || p.x >= size.x) v.x = -v.x;
    if (p.y < 0 || p.y >= size.y) v.y = -v.y;
    return v;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_Pressure);
    if (any(greaterThanEqual(p, size))) return;
    vec2 east = velocityAt(p + ivec2(1, 0), size);
    vec2 west = velocityAt(p - ivec2(1, 0), size);
    vec2 south = velocityAt(p + ivec2(0, 1), size);
    vec2 north = velocityAt(p - ivec2(0, 1), size);
    float divergence = 0.5 * ((east.x - west.x) * float(size.x)
                            + (south.y - north.y) * float(size.y));
    imageStore(u_Pressure, p, vec4(0.0, divergence, 0.0, 0.0));
}
