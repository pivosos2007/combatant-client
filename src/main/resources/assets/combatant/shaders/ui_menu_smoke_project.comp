layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_Advected;
layout(binding = 1, rgba16f) writeonly uniform image2D u_State;
layout(binding = 3) uniform sampler2D u_Pressure;
layout(binding = 4) uniform sampler2D u_DyeHistory;
layout(std430, binding = 2) readonly buffer MenuSmokeParams {
    vec4 screen;
    vec4 mouse;
    vec4 motion;
    vec4 accent;
    vec4 soft;
    vec4 cold;
    vec4 warm;
    vec4 hexGrid;
    vec4 rimColor;
    vec4 sources[64];
    vec4 sourceProps[64];
} u_Smoke;

float pressureAt(ivec2 p, ivec2 size) {
    return texelFetch(u_Pressure, clamp(p, ivec2(0), size - 1), 0).r;
}

void collide(inout vec2 velocity, float wallDistance, vec2 inward, vec2 size,
             float density, float position) {
    float approaching = max(-dot(velocity, inward), 0.0);
    if (approaching < 0.00001) return;
    float contact = exp(-wallDistance * wallDistance / 1.6);
    vec2 tangent = vec2(-inward.y, inward.x);
    float signSlide = sign(dot(velocity, tangent) + 0.0003 * sin(position * 0.13));
    velocity += inward * approaching * (1.0 + 0.80 * contact);
    velocity += tangent * approaching * contact * 0.24 * signSlide;
    velocity += inward * contact * min(density, 1.8) * 0.007;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_State);
    if (any(greaterThanEqual(p, size))) return;
    vec2 extent = vec2(size);
    vec2 uv = (vec2(p) + 0.5) / extent;
    vec4 state = texelFetch(u_Advected, p, 0);
    vec2 gradient = vec2(pressureAt(p + ivec2(1, 0), size) - pressureAt(p - ivec2(1, 0), size),
                         pressureAt(p + ivec2(0, 1), size) - pressureAt(p - ivec2(0, 1), size));
    state.xy -= 0.5 * gradient / extent;
    float density = 0.0;
    vec2 dyeGradient = vec2(0.0);
    if (u_Smoke.motion.z < 0.5) {
        density = texture(u_DyeHistory, uv).a;
        vec2 dyeTexel = 1.0 / vec2(textureSize(u_DyeHistory, 0));
        dyeGradient = 0.5 * vec2(
            texture(u_DyeHistory, uv + vec2(dyeTexel.x, 0.0)).a
          - texture(u_DyeHistory, uv - vec2(dyeTexel.x, 0.0)).a,
            texture(u_DyeHistory, uv + vec2(0.0, dyeTexel.y)).a
          - texture(u_DyeHistory, uv - vec2(0.0, dyeTexel.y)).a);
    }
    float gather = clamp(u_Smoke.screen.z * 26.0 * density, 0.0, 0.72);
    state.xy += (dyeGradient / extent) * gather;
    if (p.x < 3) collide(state.xy, float(p.x), vec2(1.0, 0.0), extent, density, float(p.y));
    if (p.x > size.x - 4) collide(state.xy, float(size.x - 1 - p.x), vec2(-1.0, 0.0), extent, density, float(p.y));
    if (p.y < 3) collide(state.xy, float(p.y), vec2(0.0, 1.0), extent, density, float(p.x));
    if (p.y > size.y - 4) collide(state.xy, float(size.y - 1 - p.y), vec2(0.0, -1.0), extent, density, float(p.x));
    if (p.x == 0) state.x = max(state.x, 0.0);
    if (p.x == size.x - 1) state.x = min(state.x, 0.0);
    if (p.y == 0) state.y = max(state.y, 0.0);
    if (p.y == size.y - 1) state.y = min(state.y, 0.0);
    state.xy = clamp(state.xy, vec2(-1.2), vec2(1.2));
    imageStore(u_State, p, state);
}
