#version 430 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_Dye;
layout(binding = 1, rgba16f) writeonly uniform image2D u_Output;
layout(binding = 3) uniform sampler2D u_Velocity;
layout(binding = 4) uniform sampler2D u_Bloom;
layout(std430, binding = 2) readonly buffer MenuSmokeParams {
    vec4 screen;
    vec4 mouse;
    vec4 motion;
    vec4 accent;
    vec4 soft;
    vec4 cold;
    vec4 warm;
    vec4 sources[48];
    vec4 sourceProps[48];
} u_Smoke;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_Output);
    if (any(greaterThanEqual(p, size))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    vec2 texel = 1.0 / vec2(size);
    vec3 dye = max(texture(u_Dye, uv).rgb, vec3(0.0));
    vec3 left = texture(u_Dye, uv - vec2(texel.x, 0.0)).rgb;
    vec3 right = texture(u_Dye, uv + vec2(texel.x, 0.0)).rgb;
    vec3 top = texture(u_Dye, uv - vec2(0.0, texel.y)).rgb;
    vec3 bottom = texture(u_Dye, uv + vec2(0.0, texel.y)).rgb;
    float dx = length(right) - length(left);
    float dy = length(bottom) - length(top);
    vec3 normal = normalize(vec3(dx, dy, length(texel)));
    float diffuse = clamp(dot(normal, vec3(0.0, 0.0, 1.0)) + 0.70, 0.70, 1.0);
    vec3 radiance = dye * diffuse;
    vec3 bloom = max(texture(u_Bloom, uv).rgb, vec3(0.0));
    radiance += bloom * (0.78 * u_Smoke.mouse.x);
    radiance = max(radiance, vec3(0.0));
    vec3 mapped = radiance / (1.0 + radiance * 0.15);
    mapped = clamp(mapped, vec3(0.0), vec3(1.0));
    float coverage = clamp(max(max(mapped.r, mapped.g), mapped.b) * 1.08, 0.0, 0.985);
    float alpha = coverage * clamp(u_Smoke.motion.y, 0.0, 1.0);
    vec3 straight = mapped / max(coverage, 0.0001);
    imageStore(u_Output, p, vec4(clamp(straight, vec3(0.0), vec3(1.0)), alpha));
}
