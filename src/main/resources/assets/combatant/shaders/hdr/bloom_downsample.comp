layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) readonly uniform image2D u_SourceMip;
layout(binding = 1, rgba16f) writeonly uniform image2D u_DestinationMip;

vec4 loadSafe(ivec2 p, ivec2 size) {
    vec4 v = imageLoad(u_SourceMip, clamp(p, ivec2(0), size - ivec2(1)));
    if (any(isnan(v)) || any(isinf(v))) return vec4(0.0, 0.0, 0.0, 1.0);
    return vec4(max(v.rgb, vec3(0.0)), max(v.a, 0.0));
}

void main() {
    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(u_DestinationMip);
    if (any(greaterThanEqual(dst, dstSize))) return;

    ivec2 srcSize = imageSize(u_SourceMip);
    ivec2 base = dst * 2 - ivec2(1);
    const float w[4] = float[4](1.0, 3.0, 3.0, 1.0);
    vec4 sum = vec4(0.0);
    float weight = 0.0;
    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            float tap = w[x] * w[y];
            sum += loadSafe(base + ivec2(x, y), srcSize) * tap;
            weight += tap;
        }
    }
    imageStore(u_DestinationMip, dst, sum / max(weight, 1e-6));
}
