layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_HdrPostInput;
layout(binding = 1) uniform sampler2D u_FinalDepth;

layout(std430, binding = 2) buffer ExposureHistogram {
    uint bins[];
} u_Histogram;

layout(std430, binding = 3) readonly buffer ExposureHistogramParams {
    vec4 extentAndSampling; // xy=output extent, z=sample stride, w=bin count
    vec4 luminanceRange;    // xy=min/max log2 luminance, z=center weight, w=sky weight
    vec4 weighting;         // x=center enabled, y=sky enabled
} u_Params;

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

bool invalidFloat(float v) {
    return isnan(v) || isinf(v);
}

void main() {
    ivec2 sampleGrid = ivec2(gl_GlobalInvocationID.xy);
    int stride = max(1, int(u_Params.extentAndSampling.z + 0.5));
    ivec2 extent = max(ivec2(1), ivec2(u_Params.extentAndSampling.xy + 0.5));
    ivec2 pixel = sampleGrid * stride + ivec2(stride / 2);
    if (any(greaterThanEqual(pixel, extent))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
    vec3 hdr = textureLod(u_HdrPostInput, uv, 0.0).rgb;
    if (any(isnan(hdr)) || any(isinf(hdr))) return;
    hdr = max(hdr, vec3(0.0));

    float lum = luminance(hdr);
    if (!(lum > 0.0) || invalidFloat(lum)) return;

    float logLum = log2(max(lum, 1e-8));
    float minLog = u_Params.luminanceRange.x;
    float maxLog = max(minLog + 1e-4, u_Params.luminanceRange.y);
    float normalized = clamp((logLum - minLog) / (maxLog - minLog), 0.0, 0.999999);
    uint binCount = max(1u, uint(u_Params.extentAndSampling.w + 0.5));
    uint bin = min(binCount - 1u, uint(normalized * float(binCount)));

    float weight = 1.0;
    if (u_Params.weighting.x > 0.5) {
        vec2 d = uv - vec2(0.5);
        float center = exp(-8.0 * dot(d, d));
        weight *= mix(1.0, max(0.0, u_Params.luminanceRange.z), center);
    }
    if (u_Params.weighting.y > 0.5) {
        // Minecraft's reversed-Z clear depth is zero: this is geometry visibility, not a
        // dimension/world classifier.
        float depth = textureLod(u_FinalDepth, uv, 0.0).r;
        if (depth <= 1e-7) weight *= max(0.0, u_Params.luminanceRange.w);
    }

    if (!(weight > 0.0) || isnan(weight) || isinf(weight)) return;
    uint integerWeight = uint(clamp(floor(weight * 4.0 + 0.5), 1.0, 64.0));
    atomicAdd(u_Histogram.bins[bin], integerWeight);
}
