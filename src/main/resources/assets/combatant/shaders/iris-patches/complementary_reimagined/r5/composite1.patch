#ifndef COMBATANT_WORLD_TWEAKS_FOG_UNIFORMS_DECLARED
#define COMBATANT_WORLD_TWEAKS_FOG_UNIFORMS_DECLARED
uniform bool combatantWorldTweaksFogControl;
uniform bool combatantWorldTweaksFogModify;
uniform float combatantWorldTweaksFogStart;
uniform float combatantWorldTweaksFogEnd;
uniform vec3 combatantWorldTweaksFogColor;
uniform int combatantWorldTweaksFogDisableMask;
#endif

#ifndef COMBATANT_FULLBRIGHT_UNIFORMS_DECLARED
#define COMBATANT_FULLBRIGHT_UNIFORMS_DECLARED
uniform bool combatantFullbrightEnabled;
uniform float combatantFullbrightMinLight;
uniform float combatantOverrideAmbientLight;
#endif

float combatantComposite1FogAmount(float distanceToCamera, float sceneDepth) {
    float combatantFogRange = max(combatantWorldTweaksFogEnd - combatantWorldTweaksFogStart, 1.0);
    float combatantFog = smoothstep(0.0, 1.0, clamp((distanceToCamera - combatantWorldTweaksFogStart) / combatantFogRange, 0.0, 1.0));
    if (sceneDepth >= 0.999999) combatantFog *= 0.16;
    return combatantFog;
}

void combatantComposite1ApplyFog(inout vec3 value, float distanceToCamera, float sceneDepth) {
    value = mix(value, combatantWorldTweaksFogColor, combatantComposite1FogAmount(distanceToCamera, sceneDepth));
}
@end

@insert_before_ident screenPos1 1
    if (combatantWorldTweaksFogControl && combatantWorldTweaksFogModify && isEyeInWater != 1 && z0 != z1) {
        combatantComposite1ApplyFog(color, lViewPos, z0); // combatantComposite1TranslucentFog
    }

@end

@insert_after_hash 76c77fdbcc40f9aa86445f791963258aff2e988af8357d2ef56eff81e2e5ef3c 3
        float combatantUnderwaterFullbright = max(
            combatantFullbrightEnabled ? clamp(combatantFullbrightMinLight, 0.0, 1.0) : 0.0,
            clamp(combatantOverrideAmbientLight, 0.0, 1.0)
        );
        bool combatantCustomUnderwaterFog = combatantWorldTweaksFogControl && combatantWorldTweaksFogModify;
        bool combatantDisableUnderwaterFog = combatantWorldTweaksFogControl && (combatantWorldTweaksFogDisableMask & 1) != 0;
        vec3 combatantUnderwaterBaseMult = vec3(0.97, 0.985, 1.0);
        vec3 combatantUnderwaterMult = mix(combatantUnderwaterBaseMult * 0.98, vec3(1.0), combatantUnderwaterFullbright);

        if (combatantCustomUnderwaterFog) {
            combatantComposite1ApplyFog(color, lViewPos, z0);
        } else if (!combatantDisableUnderwaterFog) {
            if (z0 == 1.0) {
                float combatantUnderwaterFogTint = 0.08 * (1.0 - combatantUnderwaterFullbright);
                color.rgb = mix(color.rgb, waterFogColor, combatantUnderwaterFogTint);
            }
            color.rgb *= combatantUnderwaterMult;
            volumetricEffect.rgb *= mix(vec3(0.94), vec3(1.0), combatantUnderwaterFullbright);
        }
@end

