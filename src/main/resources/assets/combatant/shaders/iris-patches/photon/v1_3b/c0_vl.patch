    float visibility = combatantWorldTweaksFogModify || (combatantWorldTweaksFogDisableMask & 1) != 0 ? 1.0 : 0.78;
    waterFog[0] *= 1.0 - 0.88 * visibility;
    waterFog[1] = mix(waterFog[1], vec3(1.0), visibility);
