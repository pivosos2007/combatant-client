float combatantPhotonWorldTweaksFogAmount(float distanceToCamera, bool sky) {
    float fogRange = max(combatantWorldTweaksFogEnd - combatantWorldTweaksFogStart, 1.0);
    float fogDistance = min(distanceToCamera, combatantWorldTweaksFogEnd);
    float fog = smoothstep(0.0, 1.0, clamp((fogDistance - combatantWorldTweaksFogStart) / fogRange, 0.0, 1.0));
    if (sky) fog *= 0.16;
    return fog;
}

void combatantPhotonApplyWorldTweaksFog(inout vec3 color, float distanceToCamera, bool sky) {
    color = mix(color, combatantWorldTweaksFogColor, combatantPhotonWorldTweaksFogAmount(distanceToCamera, sky));
} // combatantPhotonApplyWorldTweaksFog
