layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_ResolvedDepth;
layout(binding = 1) uniform sampler2D u_GbufferGeometry;
layout(binding = 2) uniform sampler2D u_GbufferDepth;
layout(binding = 3, r8) writeonly uniform image2D u_AmbientVisibility;
layout(binding = 4, rgba16f) writeonly uniform image2D u_BentNormal;

layout(std430, binding = 5) readonly buffer AmbientOcclusionData {
    mat4 inverseProjection;
    mat4 projection;
    vec4 depthTransform;
    vec4 params0;
    vec4 params1;
} u_Ao;

const float PI = 3.14159265358979323846;
const float HALF_PI = 1.57079632679489661923;
const float FALLOFF_START = 0.75;

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

vec3 reconstructView(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Ao.depthTransform.x + u_Ao.depthTransform.y;
    vec4 h = u_Ao.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    if (abs(h.w) < 1e-7) return vec3(0.0);
    return h.xyz / h.w;
}

vec3 viewToScreen(vec3 viewPosition) {
    vec4 clip = u_Ao.projection * vec4(viewPosition, 1.0);
    if (abs(clip.w) < 1e-7) return vec3(-2.0);
    vec3 ndc = clip.xyz / clip.w;
    return vec3(ndc.xy * 0.5 + 0.5,
                ndc.z * u_Ao.depthTransform.z + u_Ao.depthTransform.w);
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float integrateArc(vec2 horizons, float normalAngle, float cosNormal) {
    vec2 value = cosNormal + 2.0 * horizons * sin(normalAngle)
            - cos(2.0 * horizons - normalAngle);
    return 0.25 * (value.x + value.y);
}

float maximumHorizonAngle(vec3 sliceDirection,
                          vec3 viewerDirection,
                          vec2 centerUv,
                          vec3 centerView,
                          float radius,
                          float thickness,
                          int steps,
                          float jitter) {
    float stepWorld = radius / float(max(steps, 1));
    vec3 stepScreenPosition = viewToScreen(centerView + sliceDirection * stepWorld);
    if (any(lessThan(stepScreenPosition, vec3(-1.0)))) return PI;

    vec2 rayStep = stepScreenPosition.xy - centerUv;
    float rayStepLength = length(rayStep);
    if (rayStepLength <= 1e-7) return PI;

    vec2 fullPixel = 1.0 / max(vec2(textureSize(u_ResolvedDepth, 0)), vec2(1.0));
    vec2 rayUv = centerUv + rayStep * jitter
            + rayStep * (max(fullPixel.x, fullPixel.y) / rayStepLength);
    float maximumCosine = -1.0;

    for (int i = 0; i < 8; ++i) {
        if (i >= steps) break;
        if (any(lessThanEqual(rayUv, vec2(0.0))) || any(greaterThanEqual(rayUv, vec2(1.0)))) break;

        float sampleDepth = textureLod(u_ResolvedDepth, rayUv, 0.0).r;
        if (sampleDepth > 0.0) {
            vec3 sampleView = reconstructView(rayUv, sampleDepth);
            vec3 offset = sampleView - centerView;
            float distanceSquared = dot(offset, offset);
            if (distanceSquared > 1e-8) {
                float distanceValue = sqrt(distanceSquared);
                if (distanceValue > thickness && distanceValue <= radius) {
                    float inverseDistance = 1.0 / distanceValue;
                    float falloff = smoothstep(FALLOFF_START * radius, radius, distanceValue);
                    float cosine = dot(viewerDirection, offset) * inverseDistance;
                    cosine = mix(cosine, -1.0, falloff);
                    maximumCosine = max(maximumCosine, cosine);
                }
            }
        }

        rayUv += rayStep;
    }

    return acos(clamp(maximumCosine, -1.0, 1.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(u_AmbientVisibility);
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(outputSize);
    float centerDepth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    float gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    float depthTolerance = max(1.0e-6, abs(gbufferDepth) * 1.0e-5);
    bool ownsPixel = centerDepth > 0.0 && gbufferDepth > 0.0
            && abs(centerDepth - gbufferDepth) <= depthTolerance;
    if (!ownsPixel) {
        imageStore(u_AmbientVisibility, pixel, vec4(1.0));
        imageStore(u_BentNormal, pixel, vec4(0.0, 0.0, 1.0, 1.0));
        return;
    }

    vec3 normal = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    vec3 centerView = reconstructView(uv, centerDepth);
    vec3 viewerDirection = normalize(-centerView);

    float configuredRadius = max(u_Ao.params0.y, 0.05);
    float thickness = max(u_Ao.params0.z, 0.0);
    float nearScale = max(0.5, 0.25 + 0.75 * smoothstep(0.0, 81.0, dot(centerView, centerView)));
    float radius = configuredRadius * nearScale;

    int sampleBudget = clamp(int(u_Ao.params0.x + 0.5), 4, 64);
    int sliceCount = clamp(int(floor(sqrt(float(sampleBudget) * 0.5) + 0.5)), 2, 4);
    int stepsPerSide = clamp(sampleBudget / max(2 * sliceCount, 1), 2, 8);

    vec3 referenceUp = abs(viewerDirection.y) < 0.98 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 viewerRight = normalize(cross(referenceUp, viewerDirection));
    vec3 viewerUp = normalize(cross(viewerDirection, viewerRight));

    float ditherAngle = hash12(vec2(pixel) + vec2(0.17, 0.73));
    float ditherStep = hash12(vec2(pixel.yx) + vec2(41.0, 19.0));

    float ao = 0.0;
    vec3 bentSum = vec3(0.0);

    for (int slice = 0; slice < 4; ++slice) {
        if (slice >= sliceCount) break;

        float sliceAngle = (float(slice) + ditherAngle) * (PI / float(sliceCount));
        vec3 sliceDirection = normalize(viewerRight * cos(sliceAngle) + viewerUp * sin(sliceAngle));
        vec3 axis = normalize(cross(sliceDirection, viewerDirection));
        vec3 projectedNormal = normal - axis * dot(normal, axis);
        float projectedLengthSquared = dot(projectedNormal, projectedNormal);
        if (projectedLengthSquared <= 1e-8) continue;

        float projectedLength = sqrt(projectedLengthSquared);
        projectedNormal /= projectedLength;
        float signAngle = dot(sliceDirection, projectedNormal) < 0.0 ? -1.0 : 1.0;
        float cosNormal = clamp(dot(projectedNormal, viewerDirection), 0.0, 1.0);
        float normalAngle = signAngle * acos(cosNormal);

        vec2 horizonAngles;
        horizonAngles.x = maximumHorizonAngle(
                -sliceDirection, viewerDirection, uv, centerView, radius, thickness, stepsPerSide, ditherStep);
        horizonAngles.y = maximumHorizonAngle(
                sliceDirection, viewerDirection, uv, centerView, radius, thickness, stepsPerSide, ditherStep);

        horizonAngles = normalAngle + clamp(
                vec2(-1.0, 1.0) * horizonAngles - normalAngle,
                vec2(-HALF_PI), vec2(HALF_PI));

        float sliceVisibility = integrateArc(horizonAngles, normalAngle, cosNormal) * projectedLength;
        ao += clamp(sliceVisibility, 0.0, 1.0);

        float bentAngle = 0.5 * (horizonAngles.x + horizonAngles.y);
        bentSum += viewerDirection * cos(bentAngle) + sliceDirection * sin(bentAngle);
    }

    float visibility = clamp(ao / float(sliceCount), 0.0, 1.0);
    const float surroundingAlbedo = 0.2;
    visibility /= max(surroundingAlbedo * visibility + (1.0 - surroundingAlbedo), 1e-4);
    visibility = clamp(visibility, 0.0, 1.0);

    vec3 bentNormal = dot(bentSum, bentSum) > 1e-8 ? normalize(bentSum) : normal;
    bentNormal = normalize(bentNormal - 0.35 * viewerDirection);
    if (dot(bentNormal, normal) <= 0.05) bentNormal = normal;

    imageStore(u_AmbientVisibility, pixel, vec4(visibility));
    imageStore(u_BentNormal, pixel, vec4(bentNormal, 1.0));
}
