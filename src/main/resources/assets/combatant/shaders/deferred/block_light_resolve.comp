layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_BlockLightVolume;
layout(binding = 1) uniform sampler2D u_ResolvedDepth;
layout(binding = 2) uniform sampler2D u_GbufferDepth;
layout(binding = 3) uniform sampler2D u_GbufferGeometry;
layout(binding = 4, rgba16f) writeonly uniform image2D u_BlockLightIrradiance;
layout(std430, binding = 5) readonly buffer BlockLightResolveData {
    mat4 inverseProjection;
    mat4 inverseView;
    vec4 depthTransform;
    vec4 volumeSizeAndColumns;
    vec4 atlasSizeAndRows;
    vec4 originAndSurfaceOffset;
    // x=edge fade start, y=edge fade end. z keeps the CPU volume-bias policy visible to captures.
    vec4 edgeFade;
} u_Block;

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

vec3 reconstructView(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Block.depthTransform.x + u_Block.depthTransform.y;
    vec4 h = u_Block.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    if (abs(h.w) < 1e-7) return vec3(0.0);
    return h.xyz / h.w;
}

ivec3 volumeSize() {
    return ivec3(u_Block.volumeSizeAndColumns.xyz + vec3(0.5));
}

ivec2 atlasPixel(ivec3 voxel) {
    int columns = max(1, int(u_Block.volumeSizeAndColumns.w + 0.5));
    int sliceColumn = voxel.z % columns;
    int sliceRow = voxel.z / columns;
    return ivec2(sliceColumn * volumeSize().x + voxel.x,
                 sliceRow * volumeSize().y + voxel.y);
}

vec3 voxelRadiance(ivec3 voxel) {
    ivec3 size = volumeSize();
    if (any(lessThan(voxel, ivec3(0))) || any(greaterThanEqual(voxel, size))) return vec3(0.0);
    return max(texelFetch(u_BlockLightVolume, atlasPixel(voxel), 0).rgb, vec3(0.0));
}

vec4 sampleVolume(vec3 cameraRelativePosition) {
    vec3 originRelativeToCamera = u_Block.originAndSurfaceOffset.xyz;
    // Samples live at block centers. Keep the entire lookup camera-relative so large Minecraft
    // world coordinates never lose sub-block precision in 32-bit shader arithmetic.
    vec3 coordinate = cameraRelativePosition - originRelativeToCamera - vec3(0.5);
    vec3 size = vec3(volumeSize());

    // Bounded-volume edge handoff: the colored volume owns the inner region, then fades back to the
    // neutral Minecraft block-light contract before it runs out of geometric information.
    vec3 centered = (coordinate + vec3(0.5) - size * 0.5) / max(size * 0.5, vec3(1.0));
    float edgeDistance = max(abs(centered.x), max(abs(centered.y), abs(centered.z)));
    float coverage = 1.0 - smoothstep(u_Block.edgeFade.x, u_Block.edgeFade.y, edgeDistance);
    if (coverage <= 0.0) return vec4(0.0);

    ivec3 base = ivec3(floor(coordinate));
    vec3 fraction = fract(coordinate);

    vec3 c000 = voxelRadiance(base + ivec3(0, 0, 0));
    vec3 c100 = voxelRadiance(base + ivec3(1, 0, 0));
    vec3 c010 = voxelRadiance(base + ivec3(0, 1, 0));
    vec3 c110 = voxelRadiance(base + ivec3(1, 1, 0));
    vec3 c001 = voxelRadiance(base + ivec3(0, 0, 1));
    vec3 c101 = voxelRadiance(base + ivec3(1, 0, 1));
    vec3 c011 = voxelRadiance(base + ivec3(0, 1, 1));
    vec3 c111 = voxelRadiance(base + ivec3(1, 1, 1));

    vec3 c00 = mix(c000, c100, fraction.x);
    vec3 c10 = mix(c010, c110, fraction.x);
    vec3 c01 = mix(c001, c101, fraction.x);
    vec3 c11 = mix(c011, c111, fraction.x);
    vec3 radiance = mix(mix(c00, c10, fraction.y), mix(c01, c11, fraction.y), fraction.z);
    return vec4(max(radiance, vec3(0.0)), clamp(coverage, 0.0, 1.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(u_BlockLightIrradiance);
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(outputSize);
    float depth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    float gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    float tolerance = max(1.0e-6, abs(gbufferDepth) * 1.0e-5);
    bool ownsPixel = depth > 0.0 && gbufferDepth > 0.0 && abs(depth - gbufferDepth) <= tolerance;
    if (!ownsPixel) {
        imageStore(u_BlockLightIrradiance, pixel, vec4(0.0));
        return;
    }

    vec3 viewPosition = reconstructView(uv, depth);
    vec3 cameraRelativePosition = (u_Block.inverseView * vec4(viewPosition, 0.0)).xyz;

    vec3 viewNormal = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    vec3 worldNormal = normalize((u_Block.inverseView * vec4(viewNormal, 0.0)).xyz);
    cameraRelativePosition += worldNormal * u_Block.originAndSurfaceOffset.w;

    vec4 irradiance = sampleVolume(cameraRelativePosition);
    imageStore(u_BlockLightIrradiance, pixel, irradiance);
}
