layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_SkyDiffuseIrradiance;
layout(binding = 1) uniform sampler2D u_BlockLightIrradiance;
layout(binding = 2) uniform sampler2D u_GbufferGeometry;
layout(binding = 3, rgba16f) writeonly uniform image2D u_EnvironmentIrradiance;
layout(std430, binding = 4) readonly buffer BaselineLightState {
    // x=sky factor, y=dimension ambient (diagnostic/fallback metadata), z=has skylight, w=capture valid
    vec4 factors;
    vec4 skyColor;
    vec4 blockColor;
    vec4 ambientColor;
} u_Baseline;

float decodeMinecraftLightLevel(float encodedUv) {
    // CombatantTerrainVertex/Sodium encode a light byte as clamp(raw + 8, 8, 248), then divide by 256.
    // raw is the Minecraft 0..240 light coordinate (16 units per light level).
    return clamp((encodedUv * 256.0 - 8.0) / 240.0, 0.0, 1.0);
}

float minecraftBrightnessCurve(float lightLevel) {
    float level = clamp(lightLevel, 0.0, 1.0);
    return level / max(4.0 - 3.0 * level, 1.0e-4);
}

float parabolicMixFactor(float lightLevel) {
    float centered = 2.0 * clamp(lightLevel, 0.0, 1.0) - 1.0;
    return centered * centered;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_EnvironmentIrradiance);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec3 advancedSky = max(textureLod(u_SkyDiffuseIrradiance, uv, 0.0).rgb, vec3(0.0));
    vec4 advancedBlockSample = textureLod(u_BlockLightIrradiance, uv, 0.0);
    vec3 advancedBlock = max(advancedBlockSample.rgb, vec3(0.0));
    float advancedBlockCoverage = clamp(advancedBlockSample.a, 0.0, 1.0);

    vec2 minecraftLight = textureLod(u_GbufferGeometry, uv, 0.0).ba;
    float blockLevel = decodeMinecraftLightLevel(minecraftLight.x);
    float skyLevel = decodeMinecraftLightLevel(minecraftLight.y);

    float blockBrightness = minecraftBrightnessCurve(blockLevel);
    float skyBrightness = minecraftBrightnessCurve(skyLevel)
            * max(u_Baseline.factors.x, 0.0)
            * step(0.5, u_Baseline.factors.z);

    vec3 baselineSky = max(u_Baseline.skyColor.rgb, vec3(0.0)) * skyBrightness;

    // Keep the neutral baseline stable (no vanilla block-light flicker), but preserve the
    // 26.2 tint response that trends toward white at the ends of the light range.
    vec3 blockTint = mix(max(u_Baseline.blockColor.rgb, vec3(0.0)), vec3(1.0),
            0.9 * parabolicMixFactor(blockLevel));
    vec3 baselineBlock = blockTint * blockBrightness;

    // EnvironmentAttributes.AMBIENT_LIGHT_COLOR is already the renderer-facing ambient term.
    vec3 baselineAmbient = max(u_Baseline.ambientColor.rgb, vec3(0.0));

    // Minecraft's block-light level remains the authoritative intensity/visibility contract.
    // The bounded colored-light volume supplies chroma only. Volume coverage is not producer
    // validity: a persistent LPV can still be converging or temporarily have no colored sample.
    // Never replace valid Minecraft block light with zero/stale LPV data merely because the pixel
    // happens to lie inside the volume.
    float advancedStrength = max(advancedBlock.r, max(advancedBlock.g, advancedBlock.b));
    vec3 advancedTint = advancedStrength > 1.0e-5
            ? advancedBlock / advancedStrength
            : vec3(1.0);

    // One propagated light level is 1/15 in the volume. Once at least that much signal is present,
    // the LPV has enough evidence to own the block-light hue. Below it, blend continuously back to
    // the renderer-owned Minecraft baseline instead of producing temporal islands.
    float colorConfidence = advancedBlockCoverage
            * smoothstep(0.0, 1.0 / 15.0, advancedStrength)
            * step(1.0e-5, blockBrightness);
    vec3 coloredBlock = advancedTint * blockBrightness;
    vec3 resolvedBlock = mix(baselineBlock, coloredBlock, colorConfidence);

    vec3 irradiance = advancedSky + baselineSky + resolvedBlock + baselineAmbient;
    imageStore(u_EnvironmentIrradiance, pixel, vec4(max(irradiance, vec3(0.0)), 1.0));
}
