layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_ResolvedDepth;
layout(binding = 1) uniform sampler2D u_ShadowDepth;
layout(binding = 2) uniform sampler2D u_GbufferGeometry;
layout(binding = 3) uniform sampler2D u_GbufferDepth;
layout(binding = 4, r8) writeonly uniform image2D u_ShadowVisibility;
layout(binding = 7, r8) writeonly uniform image2D u_ShadowHardVisibility;
layout(binding = 8, r8) writeonly uniform image2D u_ShadowCascadeIndex;

struct ShadowCascade {
    mat4 viewProjection;
    vec4 atlasScaleBias;
    vec4 splitRange;
    // xy: atlas texel size, z: cascade world units per shadow texel,
    // w: normalized shadow-depth change per one world-space shadow texel.
    vec4 shadowTexel;
};

layout(std430, binding = 5) readonly buffer ShadowCascadeData {
    ShadowCascade cascades[];
} u_Shadow;

layout(std430, binding = 6) readonly buffer ShadowResolveCamera {
    mat4 inverseProjection;
    mat4 inverseView;
    vec4 depthTransform;
    vec4 viewportAndFar;
    // x: cascade blend fraction, y: normal offset (texels), z: receiver-plane bias (texels),
    // w: minimum PCF filter radius (texels).
    vec4 shadowParams0;
    // x: blocker-search radius (texels), y: PCSS penumbra scale (texels / normalized depth),
    // z: maximum penumbra radius (texels), w: final-cascade distance fade fraction.
    vec4 shadowParams1;
    // xyz: receiver-to-light direction, w: valid.
    vec4 directionalLight;
    // x: receiver slope-bias scale (texels), y: maximum total receiver bias (texels),
    // z: minimum N.L used by the slope estimate, w: maximum adaptive PCF radius (texels).
    vec4 shadowBiasParams;
} u_Camera;

struct ShadowProjection {
    vec2 localUv;
    vec2 atlasUv;
    float depth;
    bool valid;
};

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

vec3 reconstructCameraRelativeWorld(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Camera.depthTransform.x + u_Camera.depthTransform.y;
    vec4 viewH = u_Camera.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    if (abs(viewH.w) < 1e-7) return vec3(0.0);
    vec3 viewPosition = viewH.xyz / viewH.w;
    return (u_Camera.inverseView * vec4(viewPosition, 0.0)).xyz;
}

float viewDistance(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Camera.depthTransform.x + u_Camera.depthTransform.y;
    vec4 viewH = u_Camera.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    if (abs(viewH.w) < 1e-7) return u_Camera.viewportAndFar.z;
    return max(0.0, -(viewH.z / viewH.w));
}

ShadowProjection projectShadow(ShadowCascade cascade, vec3 worldRelative) {
    ShadowProjection result;
    vec4 clip = cascade.viewProjection * vec4(worldRelative, 1.0);
    result.valid = abs(clip.w) >= 1e-7;
    result.localUv = vec2(0.0);
    result.atlasUv = vec2(0.0);
    result.depth = 0.0;
    if (!result.valid) return result;

    vec3 ndc = clip.xyz / clip.w;
    result.localUv = ndc.xy * 0.5 + 0.5;
    result.valid = all(greaterThanEqual(result.localUv, vec2(0.0)))
            && all(lessThanEqual(result.localUv, vec2(1.0)));
    result.atlasUv = result.localUv * cascade.atlasScaleBias.xy + cascade.atlasScaleBias.zw;
    result.depth = ndc.z * u_Camera.depthTransform.z + u_Camera.depthTransform.w;
    return result;
}


float shadowScreenFootprintTexels(ShadowCascade cascade, vec2 uv, float depth, vec3 worldRelative) {
    ShadowProjection center = projectShadow(cascade, worldRelative);
    if (!center.valid) return 1.0;

    vec2 viewport = max(u_Camera.viewportAndFar.xy, vec2(1.0));
    vec2 pixelUv = 1.0 / viewport;
    vec2 uvX = min(uv + vec2(pixelUv.x, 0.0), vec2(1.0) - pixelUv * 0.5);
    vec2 uvY = min(uv + vec2(0.0, pixelUv.y), vec2(1.0) - pixelUv * 0.5);
    vec3 worldX = reconstructCameraRelativeWorld(uvX, depth);
    vec3 worldY = reconstructCameraRelativeWorld(uvY, depth);
    ShadowProjection projectedX = projectShadow(cascade, worldX);
    ShadowProjection projectedY = projectShadow(cascade, worldY);
    if (!projectedX.valid || !projectedY.valid) return 1.0;

    vec2 atlasTexel = max(cascade.shadowTexel.xy, vec2(1e-7));
    float footprintX = length((projectedX.atlasUv - center.atlasUv) / atlasTexel);
    float footprintY = length((projectedY.atlasUv - center.atlasUv) / atlasTexel);
    return max(1.0, max(footprintX, footprintY));
}

vec2 clampAtlasUv(ShadowCascade cascade, vec2 atlasUv) {
    vec2 halfTexel = cascade.shadowTexel.xy * 0.5;
    vec2 minimum = cascade.atlasScaleBias.zw + halfTexel;
    vec2 maximum = cascade.atlasScaleBias.zw + cascade.atlasScaleBias.xy - halfTexel;
    return clamp(atlasUv, minimum, maximum);
}

bool blockerAt(float storedDepth, float receiverDepth, float bias) {
    // Reversed-Z: a larger stored depth is a caster closer to the directional light.
    return storedDepth > 0.0 && storedDepth > receiverDepth + bias;
}

float filteredCascadeVisibility(ShadowCascade cascade,
                                vec3 worldRelative,
                                vec3 normalWorld,
                                float screenFootprintTexels,
                                out float hardVisibility,
                                out bool valid) {
    float worldTexel = max(cascade.shadowTexel.z, 1e-6);
    vec3 receiver = worldRelative + normalWorld * worldTexel * u_Camera.shadowParams0.y;
    ShadowProjection projected = projectShadow(cascade, receiver);
    valid = projected.valid;
    hardVisibility = 1.0;
    if (!valid) return 1.0;

    // Receiver bias is expressed in shadow texels. A constant bias alone creates severe
    // quantized self-shadow stripes when the celestial light is grazing a surface. Add a bounded
    // slope term from N.L while keeping the total bias small enough to avoid visible detachment.
    float baseBiasTexels = max(u_Camera.shadowParams0.z, 0.0);
    float biasTexels = baseBiasTexels;
    if (u_Camera.directionalLight.w > 0.5 && u_Camera.shadowBiasParams.x > 0.0) {
        vec3 lightDirection = normalize(u_Camera.directionalLight.xyz);
        float ndotl = clamp(dot(normalWorld, lightDirection), 0.0, 1.0);
        float minNdotL = clamp(u_Camera.shadowBiasParams.z, 0.05, 1.0);
        float sine = sqrt(max(0.0, 1.0 - ndotl * ndotl));
        float slope = sine / max(ndotl, minNdotL);
        biasTexels += u_Camera.shadowBiasParams.x * slope;
    }
    float maxBiasTexels = max(baseBiasTexels, u_Camera.shadowBiasParams.y);
    biasTexels = min(biasTexels, maxBiasTexels);
    float bias = max(cascade.shadowTexel.w, 0.0) * biasTexels;
    float centerDepth = textureLod(u_ShadowDepth, projected.atlasUv, 0.0).r;
    hardVisibility = blockerAt(centerDepth, projected.depth, bias) ? 0.0 : 1.0;

    // PCSS is deliberately excluded from the normalization path. Use a deterministic square PCF
    // kernel so a stationary world receiver always samples the same shadow texels.
    float baseFilterRadius = max(u_Camera.shadowParams0.w, 0.0);
    float maxAdaptiveRadius = max(u_Camera.shadowBiasParams.w, baseFilterRadius);
    // A fixed one-texel PCF footprint aliases under minification: one output pixel may cover
    // multiple shadow texels at distance, producing the characteristic screen-space dirt/crawl.
    // Spread the deterministic 3x3 taps over the projected receiver footprint instead.
    float adaptiveRadius = 0.75 * max(screenFootprintTexels - 1.0, 0.0);
    float filterRadius = min(max(baseFilterRadius, adaptiveRadius), maxAdaptiveRadius);
    if (filterRadius <= 1e-4) {
        return hardVisibility;
    }

    float visible = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 offset = vec2(float(x), float(y)) * cascade.shadowTexel.xy * filterRadius;
            vec2 sampleUv = clampAtlasUv(cascade, projected.atlasUv + offset);
            float storedDepth = textureLod(u_ShadowDepth, sampleUv, 0.0).r;
            visible += blockerAt(storedDepth, projected.depth, bias) ? 0.0 : 1.0;
        }
    }
    return visible * (1.0 / 9.0);
}

void storeVisibility(ivec2 pixel, float filtered, float hard, float cascadeIndexEncoded) {
    imageStore(u_ShadowVisibility, pixel, vec4(clamp(filtered, 0.0, 1.0)));
    imageStore(u_ShadowHardVisibility, pixel, vec4(clamp(hard, 0.0, 1.0)));
    imageStore(u_ShadowCascadeIndex, pixel, vec4(clamp(cascadeIndexEncoded, 0.0, 1.0)));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_ShadowVisibility);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    float depth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    float gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    float depthTolerance = max(1.0e-6, abs(gbufferDepth) * 1.0e-5);
    if (depth <= 0.0 || gbufferDepth <= 0.0 || abs(depth - gbufferDepth) > depthTolerance) {
        storeVisibility(pixel, 1.0, 1.0, 0.0);
        return;
    }

    int cascadeCount = max(0, int(u_Shadow.cascades[0].splitRange.w + 0.5));
    if (cascadeCount <= 0) {
        storeVisibility(pixel, 1.0, 1.0, 0.0);
        return;
    }

    float distanceValue = viewDistance(uv, depth);
    int cascadeIndex = -1;
    for (int i = 0; i < min(cascadeCount, 8); ++i) {
        vec2 split = u_Shadow.cascades[i].splitRange.xy;
        if (distanceValue >= split.x && distanceValue <= split.y) {
            cascadeIndex = i;
            break;
        }
    }
    if (cascadeIndex < 0) {
        storeVisibility(pixel, 1.0, 1.0, 0.0);
        return;
    }
    float cascadeIndexEncoded = float(cascadeIndex + 1) / float(cascadeCount + 1);

    vec3 worldRelative = reconstructCameraRelativeWorld(uv, depth);
    vec3 normalView = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    vec3 normalWorld = normalize(mat3(u_Camera.inverseView) * normalView);

    bool primaryValid = false;
    float hardVisibility = 1.0;
    float primaryFootprint = shadowScreenFootprintTexels(
            u_Shadow.cascades[cascadeIndex], uv, depth, worldRelative);
    float visibility = filteredCascadeVisibility(
            u_Shadow.cascades[cascadeIndex], worldRelative, normalWorld,
            primaryFootprint, hardVisibility, primaryValid);
    if (!primaryValid) {
        visibility = 1.0;
        hardVisibility = 1.0;
    }

    float blendFraction = clamp(u_Camera.shadowParams0.x, 0.0, 0.49);
    if (primaryValid && blendFraction > 0.0 && cascadeIndex + 1 < cascadeCount) {
        vec2 split = u_Shadow.cascades[cascadeIndex].splitRange.xy;
        float blendWidth = max((split.y - split.x) * blendFraction, 1e-5);
        float blendStart = split.y - blendWidth;
        float blend = smoothstep(blendStart, split.y, distanceValue);
        if (blend > 0.0) {
            bool nextValid = false;
            float nextHardVisibility = 1.0;
            float nextFootprint = shadowScreenFootprintTexels(
                    u_Shadow.cascades[cascadeIndex + 1], uv, depth, worldRelative);
            float nextVisibility = filteredCascadeVisibility(
                    u_Shadow.cascades[cascadeIndex + 1], worldRelative, normalWorld,
                    nextFootprint, nextHardVisibility, nextValid);
            if (nextValid) {
                visibility = mix(visibility, nextVisibility, blend);
                hardVisibility = mix(hardVisibility, nextHardVisibility, blend);
            }
        }
    }


    // The last cascade is a finite-resolution representation, not an entitlement to preserve
    // binary high-frequency shadow detail all the way to the receiver cutoff. Fade only the
    // filtered lighting contribution near the final range edge; hardVisibility stays raw for debug.
    float farFadeFraction = clamp(u_Camera.shadowParams1.w, 0.0, 0.40);
    if (farFadeFraction > 0.0 && cascadeIndex == cascadeCount - 1) {
        vec2 split = u_Shadow.cascades[cascadeIndex].splitRange.xy;
        float fadeWidth = max((split.y - split.x) * farFadeFraction, 1e-4);
        float farFade = smoothstep(split.y - fadeWidth, split.y, distanceValue);
        visibility = mix(visibility, 1.0, farFade);
    }

    storeVisibility(pixel, visibility, hardVisibility, cascadeIndexEncoded);
}
